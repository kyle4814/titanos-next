{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM"], "types": ["node"], "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true, "skipLibCheck": true, "verbatimModuleSyntax": false, "erasableSyntaxOnly": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
