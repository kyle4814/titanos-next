# Applying it is GATE5 (Cloudflare cron registration + deploy) and needs the generator_queue (0018) and graded_run (0020) migrations applied first.
# Merge by hand ONLY after the owner card is approved:
#   [triggers]
#   crons = ["*/10 * * * *"]      # must equal DRAIN_TICK_CRON in src/shop/drain_tick_worker.ts
#   [vars]
