{"id":"4649","rules":[{"id":"4649:product_relation:2b99f188","type":"product_relation","polarity":"yes","conditional":false,"tags":{"substrate":["porous_substrate"],"environment":["external","internal"]},"mentions":["sikaflex-pro-plus"],"text":"Sikaflex® PRO is designed for movement and connection joints on porous substrates as well as indoor and outdoor general sealing applications.","heading":"USES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/o/sikaflex_pro.pdf","page":1,"page_end":1,"doc_version":"April 2023, Version 01.03","section":"USES","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/4649.html"}},{"id":"4649:alternative:6eda7e4b","type":"alternative","polarity":"no","conditional":false,"tags":{"tile_type":["natural_stone"]},"mentions":["sikaflex-pro-plus"],"text":"Do not use Sikaflex® PRO on natural stone.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/o/sikaflex_pro.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 01.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/4649.html"}},{"id":"4649:alternative:8b42d17d","type":"alternative","polarity":"no","conditional":false,"tags":{},"mentions":["sikaflex-pro-plus"],"text":"Do not use Sikaflex® PRO on bituminous substrates, natural rubber, EPDM rubber or on any building materials which might bleed oils, plasticizers or solvents that could attack the sealant.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/o/sikaflex_pro.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 01.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/4649.html"}},{"id":"4649:alternative:e20bddb2","type":"alternative","polarity":"no","conditional":false,"tags":{"environment":["submerged"]},"mentions":["sikaflex-pro-plus"],"text":"Do not use Sikaflex® PRO to seal joints in and around swimming pools.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/o/sikaflex_pro.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 01.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/4649.html"}},{"id":"4649:alternative:8b03fbd3","type":"alternative","polarity":"no","conditional":false,"tags":{},"mentions":["sikaflex-pro-plus"],"text":"Do not use Sikaflex® PRO for joints under water pressure or for permanent water immersion.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/o/sikaflex_pro.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 01.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/4649.html"}},{"id":"4649:primer:b85b0385","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sika-primer-3-n"],"text":"use a brush to apply Sika® Primer-3 N and allow a further flash-off time of > 30 minutes (< 8 hours) before sealing the joints","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/o/sikaflex_pro.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 01.03","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/4649.html"}},{"id":"4649:primer:593f11db","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sika-primer-215"],"text":"PVC has to be cleaned and pre-treated using Sika® Primer-215 applied with a brush","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/o/sikaflex_pro.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 01.03","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/4649.html"}},{"id":"4649:primer:27393458","type":"primer","polarity":"yes","conditional":false,"tags":{"substrate":["aac","concrete","porous_substrate"]},"mentions":["sika-primer-3-n"],"text":"Porous substrates Concrete, aerated concrete and cement based renders, mortars and bricks shall be primed using Sika® Primer-3 N applied with a brush","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/o/sikaflex_pro.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 01.03","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/4649.html"}},{"id":"4649:product_relation:345f531f","type":"product_relation","polarity":"yes","conditional":false,"tags":{},"mentions":["sikaflex-pro-plus"],"text":"APPLICATION METHOD / TOOLS Sikaflex® PRO is supplied ready to use","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/o/sikaflex_pro.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 01.03","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/4649.html"}}]}