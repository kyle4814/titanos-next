{"id":"davco-n-silicone","rules":[{"id":"davco-n-silicone:suitability:9decfbc4","type":"suitability","polarity":"no","conditional":true,"tags":{"substrate":["concrete","glass","metal"],"tile_type":["ceramic","natural_stone"]},"mentions":[],"text":"▪ Neutral cure ▪ Excellent adhesion to most common construction materials such as: glass, enamel, ceramics, tiles, most metal*, most plastic, rubber, concrete and grouts ▪ Non-sag ▪ Easy tooling characteristics ▪ Mould resistance ▪ Fast curing ▪ Movement capability ±50% ▪ High temperature resistance (-40°c to +150°c) *Not for use on all metal and natural stone substrates i.e. copper. -See Important Considerations below prior to use.","heading":"FEATURES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/f/davco-n-silicone.pdf","page":1,"page_end":1,"doc_version":"November 2024, Version 01.01","section":"FEATURES","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/davco-n-silicone.html"}},{"id":"davco-n-silicone:suitability:bc757d19","type":"suitability","polarity":"no","conditional":false,"tags":{"tile_type":["natural_stone"]},"mentions":[],"text":"Do not use on natural stone.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/f/davco-n-silicone.pdf","page":2,"page_end":2,"doc_version":"November 2024, Version 01.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/davco-n-silicone.html"}},{"id":"davco-n-silicone:restriction:72a71352","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use on bituminous substrates, natural rubber or any building materials which might leach oils, plasticisers or solvents that could degrade the sealant","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/f/davco-n-silicone.pdf","page":2,"page_end":2,"doc_version":"November 2024, Version 01.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/davco-n-silicone.html"}},{"id":"davco-n-silicone:restriction:e7cc5cb5","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use Davco® N Silicone in areas which are exposed to strong oxidising acids (e.g. nitric acid) and bases.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/f/davco-n-silicone.pdf","page":2,"page_end":2,"doc_version":"November 2024, Version 01.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/davco-n-silicone.html"}},{"id":"davco-n-silicone:suitability:9c64d06f","type":"suitability","polarity":"no","conditional":false,"tags":{"environment":["submerged"]},"mentions":[],"text":"Do not use to seal joints in or around swimming pools.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/f/davco-n-silicone.pdf","page":2,"page_end":2,"doc_version":"November 2024, Version 01.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/davco-n-silicone.html"}},{"id":"davco-n-silicone:restriction:1b12cc50","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use for joints under water pressure or permanent water immersion.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/f/davco-n-silicone.pdf","page":2,"page_end":2,"doc_version":"November 2024, Version 01.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/davco-n-silicone.html"}},{"id":"davco-n-silicone:restriction:fb2ba666","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use Davco® N Silicone in totally confined spaces as it requires atmospheric moisture to cure","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/f/davco-n-silicone.pdf","page":2,"page_end":2,"doc_version":"November 2024, Version 01.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/davco-n-silicone.html"}},{"id":"davco-n-silicone:restriction:8586c41d","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use for medical or pharmaceutical applications.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/f/davco-n-silicone.pdf","page":2,"page_end":2,"doc_version":"November 2024, Version 01.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/davco-n-silicone.html"}},{"id":"davco-n-silicone:primer:b85b0385","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sika-primer-3-n"],"text":"use a brush to apply Sika® Primer-3 N and allow a further flash-off time of > 30 minutes (< 8 hours) before sealing the joints","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/f/davco-n-silicone.pdf","page":2,"page_end":2,"doc_version":"November 2024, Version 01.01","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/davco-n-silicone.html"}},{"id":"davco-n-silicone:primer:f632ffe0","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sika-primer-215"],"text":"PVC has to be cleaned and pre-treated using Sika® Primer- 215 applied with a brush","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/f/davco-n-silicone.pdf","page":2,"page_end":2,"doc_version":"November 2024, Version 01.01","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/davco-n-silicone.html"}},{"id":"davco-n-silicone:primer:27393458","type":"primer","polarity":"yes","conditional":false,"tags":{"substrate":["aac","concrete","porous_substrate"]},"mentions":["sika-primer-3-n"],"text":"Porous substrates Concrete, aerated concrete and cement based renders, mortars and bricks shall be primed using Sika® Primer-3 N applied with a brush","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/f/davco-n-silicone.pdf","page":3,"page_end":3,"doc_version":"November 2024, Version 01.01","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/davco-n-silicone.html"}}]}