{"id":"doc-eco-systems-prepnprime","rules":[{"id":"doc-eco-systems-prepnprime:suitability:88b85489","type":"suitability","polarity":"yes","conditional":true,"tags":{"substrate":["nonporous_substrate"],"tile_type":["ceramic","porcelain"]},"mentions":[],"text":"ECO SYSTEMS® PREP \"N\" PRIME is suitable for the priming of non porous substrates and difficult to adhere to substrates prior to the application of Ceramic tile, Porcelain, Stone and other Sika coatings","heading":"USES","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/4cdc01ee-a823-40b4-a9bd-4bf882300921/eco-systems-prepnprime.pdf","page":1,"page_end":1,"doc_version":"April 2023, Version 02.03","section":"USES","web_url":null}},{"id":"doc-eco-systems-prepnprime:suitability:b3cb1771","type":"suitability","polarity":"yes","conditional":false,"tags":{"substrate":["metal"],"environment":["floor"]},"mentions":[],"text":"ECO SYSTEMS® PREP \"N\" PRIME is designed to bond to PVC pipe penetrations & puddle flanges, and metal floor drains / wastes","heading":"USES","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/4cdc01ee-a823-40b4-a9bd-4bf882300921/eco-systems-prepnprime.pdf","page":1,"page_end":1,"doc_version":"April 2023, Version 02.03","section":"USES","web_url":null}},{"id":"doc-eco-systems-prepnprime:restriction:4760cde6","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"ECO SYSTEMS™ ECO PREP ‘N’ PRIME is not suitable for solvent based finishes.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/4cdc01ee-a823-40b4-a9bd-4bf882300921/eco-systems-prepnprime.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 02.03","section":"IMPORTANT CONSIDERATIONS","web_url":null}},{"id":"doc-eco-systems-prepnprime:suitability:05fdeff5","type":"suitability","polarity":"no","conditional":false,"tags":{"environment":["submerged"]},"mentions":[],"text":"ECO SYSTEMS™ ECO PREP ‘N’ PRIME is not suitable for continuous water immersion applications, eg : swimming pools and spas etc.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/4cdc01ee-a823-40b4-a9bd-4bf882300921/eco-systems-prepnprime.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 02.03","section":"IMPORTANT CONSIDERATIONS","web_url":null}},{"id":"doc-eco-systems-prepnprime:suitability:67a38e06","type":"suitability","polarity":"no","conditional":true,"tags":{"substrate":["waterproofing_membrane"]},"mentions":[],"text":"ECO SYSTEMS™ ECO PREP ‘N’ PRIME is not suitable over waterproofing membranes unless Sika approved, seek further technical advice.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/4cdc01ee-a823-40b4-a9bd-4bf882300921/eco-systems-prepnprime.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 02.03","section":"IMPORTANT CONSIDERATIONS","web_url":null}},{"id":"doc-eco-systems-prepnprime:suitability:9afa9dbe","type":"suitability","polarity":"no","conditional":false,"tags":{"substrate":["waterproofing_membrane"]},"mentions":[],"text":"ECO SYSTEMS™ ECO PREP ‘N’ PRIME is not suitable as a primer for solvent based polyurethane membranes.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/4cdc01ee-a823-40b4-a9bd-4bf882300921/eco-systems-prepnprime.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 02.03","section":"IMPORTANT CONSIDERATIONS","web_url":null}},{"id":"doc-eco-systems-prepnprime:restriction:60ae3053","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not apply onto wet or damp substrates.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/4cdc01ee-a823-40b4-a9bd-4bf882300921/eco-systems-prepnprime.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 02.03","section":"IMPORTANT CONSIDERATIONS","web_url":null}},{"id":"doc-eco-systems-prepnprime:suitability:2fa294a9","type":"suitability","polarity":"no","conditional":false,"tags":{"substrate":["waterproofing_membrane"]},"mentions":[],"text":"Do not use as a waterproofing membrane or on areas of negative hydrostatic pressure.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/4cdc01ee-a823-40b4-a9bd-4bf882300921/eco-systems-prepnprime.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 02.03","section":"IMPORTANT CONSIDERATIONS","web_url":null}},{"id":"doc-eco-systems-prepnprime:restriction:44e69857","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not apply in temperatures below 5oC and above 35oC and under hot and windy conditions.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/4cdc01ee-a823-40b4-a9bd-4bf882300921/eco-systems-prepnprime.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 02.03","section":"IMPORTANT CONSIDERATIONS","web_url":null}},{"id":"doc-eco-systems-prepnprime:suitability:5912ba87","type":"suitability","polarity":"no","conditional":false,"tags":{"tile_type":["porcelain"]},"mentions":[],"text":"Not Suitable for use over polished porcelain tile that have sealers.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/4cdc01ee-a823-40b4-a9bd-4bf882300921/eco-systems-prepnprime.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 02.03","section":"IMPORTANT CONSIDERATIONS","web_url":null}}]}