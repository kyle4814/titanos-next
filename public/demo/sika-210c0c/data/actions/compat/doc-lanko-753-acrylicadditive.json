{"id":"doc-lanko-753-acrylicadditive","rules":[{"id":"doc-lanko-753-acrylicadditive:suitability:3679cfbe","type":"suitability","polarity":"yes","conditional":false,"tags":{"substrate":["cement_render"],"environment":["floor"]},"mentions":[],"text":"LANKO® 753 Acrylic Additive may be used as an additive with Sika and Lanko cement-based technical mortars, in particular mortars for floor levelling, screeding, rendering, patching and repair.","heading":"USES","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/6f3a1695-f701-49a9-b940-8ea10773af08/lanko-753-acrylicadditive.pdf","page":1,"page_end":1,"doc_version":"May 2026, Version 01.01","section":"USES","web_url":null}},{"id":"doc-lanko-753-acrylicadditive:suitability:14d8fa0d","type":"suitability","polarity":"yes","conditional":false,"tags":{"tile_type":["ceramic"]},"mentions":[],"text":"LANKO® 753 Acrylic Additive can also be used as an additive for any of Sika and Davco’s range of ceramic tile adhesives and grouts.","heading":"USES","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/6f3a1695-f701-49a9-b940-8ea10773af08/lanko-753-acrylicadditive.pdf","page":1,"page_end":1,"doc_version":"May 2026, Version 01.01","section":"USES","web_url":null}},{"id":"doc-lanko-753-acrylicadditive:restriction:704d6bf1","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use the product in temperatures below 5 °C or above 35 °C.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/6f3a1695-f701-49a9-b940-8ea10773af08/lanko-753-acrylicadditive.pdf","page":1,"page_end":1,"doc_version":"May 2026, Version 01.01","section":"IMPORTANT CONSIDERATIONS","web_url":null}},{"id":"doc-lanko-753-acrylicadditive:suitability:ba373afc","type":"suitability","polarity":"no","conditional":false,"tags":{"substrate":["concrete","metal","nonporous_substrate"]},"mentions":[],"text":"Not to be used over non-porous surfaces, such as power trowelled or steel floated concrete","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/6f3a1695-f701-49a9-b940-8ea10773af08/lanko-753-acrylicadditive.pdf","page":1,"page_end":1,"doc_version":"May 2026, Version 01.01","section":"IMPORTANT CONSIDERATIONS","web_url":null}},{"id":"doc-lanko-753-acrylicadditive:restriction:f6e60fe5","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use on highly porous slabs, or in hot windy conditions without prior wetting down the slab – see application instructions for the individual mortar product for specific application information","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/6f3a1695-f701-49a9-b940-8ea10773af08/lanko-753-acrylicadditive.pdf","page":1,"page_end":1,"doc_version":"May 2026, Version 01.01","section":"IMPORTANT CONSIDERATIONS","web_url":null}},{"id":"doc-lanko-753-acrylicadditive:product_relation:7b330ab5","type":"product_relation","polarity":"yes","conditional":false,"tags":{},"mentions":["sikalastic-moistureseal"],"text":"apply Sikalastic® Moisture Seal","heading":"SURFACE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/6f3a1695-f701-49a9-b940-8ea10773af08/lanko-753-acrylicadditive.pdf","page":2,"page_end":2,"doc_version":"May 2026, Version 01.01","section":"SURFACE PREPARATION","web_url":null}},{"id":"doc-lanko-753-acrylicadditive:primer:71f02f3f","type":"primer","polarity":"yes","conditional":false,"tags":{"substrate":["concrete","metal","nonporous_substrate"]},"mentions":["sikalastic-moistureseal"],"text":"Non-porous surfaces, such as power trowelled or steel floated concrete, must be primed with Sikalastic® Moisture Seal","heading":"SURFACE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/6f3a1695-f701-49a9-b940-8ea10773af08/lanko-753-acrylicadditive.pdf","page":2,"page_end":2,"doc_version":"May 2026, Version 01.01","section":"SURFACE PREPARATION","web_url":null}},{"id":"doc-lanko-753-acrylicadditive:product_relation:f857fa65","type":"product_relation","polarity":"yes","conditional":false,"tags":{},"mentions":["sikalastic-moistureseal"],"text":"Deeply contaminated substrates must be abraded to a clean, sound surface or some substrates can be prepared with the use of Sikalastic® Moisture Seal – a bonding coat for contaminated surfaces","heading":"SURFACE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/6f3a1695-f701-49a9-b940-8ea10773af08/lanko-753-acrylicadditive.pdf","page":2,"page_end":2,"doc_version":"May 2026, Version 01.01","section":"SURFACE PREPARATION","web_url":null}}]}