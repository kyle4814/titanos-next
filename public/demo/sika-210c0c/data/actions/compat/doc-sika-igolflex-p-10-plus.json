{"id":"doc-sika-igolflex-p-10-plus","rules":[{"id":"doc-sika-igolflex-p-10-plus:suitability:524de7d1","type":"suitability","polarity":"no","conditional":false,"tags":{"environment":["domestic"]},"mentions":[],"text":"Do not use inside residential properties or in nonventilated environments.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/4cfca5d8-1f60-469b-878d-7f5bd4e4f1de/sika-igolflex-p-10-plus.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"IMPORTANT CONSIDERATIONS","web_url":null}},{"id":"doc-sika-igolflex-p-10-plus:restriction:39ad854e","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not apply on wet or very damp surfaces.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/4cfca5d8-1f60-469b-878d-7f5bd4e4f1de/sika-igolflex-p-10-plus.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"IMPORTANT CONSIDERATIONS","web_url":null}},{"id":"doc-sika-igolflex-p-10-plus:restriction:18f8d898","type":"restriction","polarity":"no","conditional":true,"tags":{},"mentions":[],"text":"Do not use to waterproof tanks, cellars or drains subject to water pressure","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/4cfca5d8-1f60-469b-878d-7f5bd4e4f1de/sika-igolflex-p-10-plus.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"IMPORTANT CONSIDERATIONS","web_url":null}},{"id":"doc-sika-igolflex-p-10-plus:restriction:6598b1d5","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use to waterproof surfaces or containers in contact with liquids for human consumption i.e. drinking water.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/4cfca5d8-1f60-469b-878d-7f5bd4e4f1de/sika-igolflex-p-10-plus.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"IMPORTANT CONSIDERATIONS","web_url":null}},{"id":"doc-sika-igolflex-p-10-plus:restriction:9b09e07a","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use in contact with solvent or mineral oils.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/4cfca5d8-1f60-469b-878d-7f5bd4e4f1de/sika-igolflex-p-10-plus.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"IMPORTANT CONSIDERATIONS","web_url":null}}]}