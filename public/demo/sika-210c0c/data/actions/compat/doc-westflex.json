xt":"Westflex adhesive is not suitable for the tiling of areas where continual immersion occurs i.e. swimming pools, spas, etc.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/5855b88c-614a-4ac9-bbab-73dbe81f8b7a/westflex.pdf","page":2,"page_end":2,"doc_version":"April 2022, Version 01.01","section":"IMPORTANT CONSIDERATIONS","web_url":null}},{"id":"doc-westflex:suitability:63e5d772","type":"suitability","polarity":"no","conditional":false,"tags":{"environment":["external"]},"mentions":[],"text":"Not suitable for use on external facade applications above 3 meters.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/5855b88c-614a-4ac9-bbab-73dbe81f8b7a/westflex.pdf","page":2,"page_end":2,"doc_version":"April 2022, Version 01.01","section":"IMPORTANT CONSIDERATIONS","web_url":null}},{"id":"doc-westflex:suitability:05dbdd9c","type":"suitability","polarity":"yes","conditional":true,"tags":{"substrate":["waterproofing_membrane"],"environment":["wet_area"]},"mentions":[],"text":"For tiling wet areas, a suitable Sika approved waterproof membrane should be used prior to tiling.","heading":"SUBSTRATE QUALITY","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/5855b88c-614a-4ac9-bbab-73dbe81f8b7a/westflex.pdf","page":2,"page_end":2,"doc_version":"April 2022, Version 01.01","section":"SUBSTRATE QUALITY","web_url":null}},{"id":"doc-westflex:suitability:e3804e53","type":"suitability","polarity":"yes","conditional":false,"tags":{"substrate":["cement_screed"]},"mentions":[],"text":"CEMENT MORTAR BEDS / SCREEDS: Must be installed as per AS ISO 3958.1-2007. Westflex adhesive can be used over early aged mortar beds / screeds","heading":"SUBSTRATE QUALITY","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/5855b88c-614a-4ac9-bbab-73dbe81f8b7a/westflex.pdf","page":2,"page_end":2,"doc_version":"April 2022, Version 01.01","section":"SUBSTRATE QUALITY","web_url":null}},{"id":"doc-westflex:primer:e5801b2b","type":"primer","polarity":"yes","conditional":false,"tags":{"substrate":["nonporous_substrate","porous_substrate"]},"mentions":["davco-ultraprime","davco-primex"],"text":"Priming Guide: Substrate type Primer Porous substrates Davco Ultraprime or PrimeX Dense substrate Davco PrimeX Non porous substrates Sika Prep n Prime or Davco Ultrabond Always refer to primer datasheet for additional information and product recommendations","heading":"SURFACE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/dms/getdocument.get/5855b88c-614a-4ac9-bbab-73dbe81f8b7a/westflex.pdf","page":3,"page_end":3,"doc_version":"April 2022, Version 01.01","section":"SURFACE PREPARATION","web_url":null}}]}