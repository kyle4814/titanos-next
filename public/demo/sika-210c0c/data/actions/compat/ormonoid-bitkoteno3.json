{"id":"ormonoid-bitkoteno3","rules":[{"id":"ormonoid-bitkoteno3:restriction:97529580","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Ormonoid Bitkote No.3 is not designed to stop a hydrostatic head of water pressure.","heading":"LIMITATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/t/ormonoid-bitkoteno3.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"LIMITATIONS","web_url":"https://aus.sika.com/en/construction/waterproofing/liquid-applied-membranes/water-based-membranes/ormonoid-bitkoteno3.html"}},{"id":"ormonoid-bitkoteno3:restriction:fb96b3f7","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Ormonoid Bitkote No.3 is not suitable for use in immersed or tanking applications.","heading":"LIMITATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/t/ormonoid-bitkoteno3.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"LIMITATIONS","web_url":"https://aus.sika.com/en/construction/waterproofing/liquid-applied-membranes/water-based-membranes/ormonoid-bitkoteno3.html"}},{"id":"ormonoid-bitkoteno3:restriction:552e4ad9","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Ormonoid Bitkote No.3 must not be used over damp, wet or contaminated substrates.","heading":"LIMITATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/t/ormonoid-bitkoteno3.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"LIMITATIONS","web_url":"https://aus.sika.com/en/construction/waterproofing/liquid-applied-membranes/water-based-membranes/ormonoid-bitkoteno3.html"}},{"id":"ormonoid-bitkoteno3:restriction:86c485f9","type":"restriction","polarity":"no","conditional":true,"tags":{},"mentions":[],"text":"Ormonoid Bitkote No.3 must not be applied if it is raining or if rain is imminent.","heading":"LIMITATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/t/ormonoid-bitkoteno3.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"LIMITATIONS","web_url":"https://aus.sika.com/en/construction/waterproofing/liquid-applied-membranes/water-based-membranes/ormonoid-bitkoteno3.html"}},{"id":"ormonoid-bitkoteno3:restriction:912461db","type":"restriction","polarity":"no","conditional":true,"tags":{},"mentions":[],"text":"Ormonoid Bitkote No.3 must not be applied directly over protective coatings.","heading":"LIMITATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/t/ormonoid-bitkoteno3.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"LIMITATIONS","web_url":"https://aus.sika.com/en/construction/waterproofing/liquid-applied-membranes/water-based-membranes/ormonoid-bitkoteno3.html"}},{"id":"ormonoid-bitkoteno3:restriction:53e02959","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Ormonoid Bitkote No.3 must not be used as a trafficable coating.","heading":"LIMITATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/t/ormonoid-bitkoteno3.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"LIMITATIONS","web_url":"https://aus.sika.com/en/construction/waterproofing/liquid-applied-membranes/water-based-membranes/ormonoid-bitkoteno3.html"}},{"id":"ormonoid-bitkoteno3:restriction:37804b07","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Ormonoid Bitkote No.3 is not compatible with polyurethane or silicone sealants.","heading":"LIMITATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/t/ormonoid-bitkoteno3.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"LIMITATIONS","web_url":"https://aus.sika.com/en/construction/waterproofing/liquid-applied-membranes/water-based-membranes/ormonoid-bitkoteno3.html"}},{"id":"ormonoid-bitkoteno3:suitability:333966cb","type":"suitability","polarity":"yes","conditional":true,"tags":{"environment":["wall"]},"mentions":[],"text":"For retaining walls allow a minimum of 3 days cure and suitable protection layer prior to backfilling.","heading":"LIMITATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/t/ormonoid-bitkoteno3.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"LIMITATIONS","web_url":"https://aus.sika.com/en/construction/waterproofing/liquid-applied-membranes/water-based-membranes/ormonoid-bitkoteno3.html"}},{"id":"ormonoid-bitkoteno3:restriction:1e189cdc","type":"restriction","polarity":"no","conditional":true,"tags":{},"mentions":[],"text":"Do not apply where the substrate temperature is below 10°C or greater than 35°C.","heading":"LIMITATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/t/ormonoid-bitkoteno3.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"LIMITATIONS","web_url":"https://aus.sika.com/en/construction/waterproofing/liquid-applied-membranes/water-based-membranes/ormonoid-bitkoteno3.html"}},{"id":"ormonoid-bitkoteno3:compatibility:a05496a5","type":"compatibility","polarity":"yes","conditional":false,"tags":{"substrate":["brick_block","cement_screed","concrete","fibre_cement","metal","timber"]},"mentions":[],"text":"▪ Concrete ▪ Masonry ▪ Sand/cement screeds ▪ Fibrous cement sheeting ▪ Compressed fibrous cement sheeting ▪ Steel/Aluminium ▪ Timber posts","heading":"Application Information > Substrates","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/t/ormonoid-bitkoteno3.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"Application Information > Substrates","web_url":"https://aus.sika.com/en/construction/waterproofing/liquid-applied-membranes/water-based-membranes/ormonoid-bitkoteno3.html"}}]}