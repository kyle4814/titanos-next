{"id":"sarnafil-g-410-20l","rules":[{"id":"sarnafil-g-410-20l:suitability:8bdda4fa","type":"suitability","polarity":"yes","conditional":false,"tags":{"substrate":["waterproofing_membrane"]},"mentions":[],"text":"It contains ultraviolet light stabilisers according to EN 13956 / GB 12952. Sarnafil® G 410-20 L is a hot-air weldable roof membrane, formulated for direct exposure and designed for use in all global climatic conditions.","heading":"DESCRIPTION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/7/sarnafil_g_410-20l.pdf","page":1,"page_end":1,"doc_version":"April 2023, Version 01.02","section":"DESCRIPTION","web_url":"https://aus.sika.com/en/construction/roofing/pvc-sheet-membranes/membranes/sarnafil-g-410-20l.html"}},{"id":"sarnafil-g-410-20l:restriction:d6d77369","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not apply to wet, damp or unclean surfaces","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/7/sarnafil_g_410-20l.pdf","page":4,"page_end":4,"doc_version":"April 2023, Version 01.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/roofing/pvc-sheet-membranes/membranes/sarnafil-g-410-20l.html"}},{"id":"sarnafil-g-410-20l:compatibility:2bb30319","type":"compatibility","polarity":"yes","conditional":false,"tags":{"substrate":["metal"]},"mentions":[],"text":"Sarnafil® Metal Sheet","heading":"System information > System structure","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/7/sarnafil_g_410-20l.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"System information > System structure","web_url":"https://aus.sika.com/en/construction/roofing/pvc-sheet-membranes/membranes/sarnafil-g-410-20l.html"}},{"id":"sarnafil-g-410-20l:compatibility:407c0d55","type":"compatibility","polarity":"yes","conditional":false,"tags":{},"mentions":["sarnacol-2170"],"text":"Sarnacol® 2170 (contact adhesive)","heading":"System information > System structure","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/7/sarnafil_g_410-20l.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"System information > System structure","web_url":"https://aus.sika.com/en/construction/roofing/pvc-sheet-membranes/membranes/sarnafil-g-410-20l.html"}},{"id":"sarnafil-g-410-20l:compatibility:d22dc959","type":"compatibility","polarity":"yes","conditional":false,"tags":{},"mentions":["sarna-cleaner"],"text":"Sarna Cleaner","heading":"System information > System structure","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/7/sarnafil_g_410-20l.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"System information > System structure","web_url":"https://aus.sika.com/en/construction/roofing/pvc-sheet-membranes/membranes/sarnafil-g-410-20l.html"}},{"id":"sarnafil-g-410-20l:compatibility:1c217646","type":"compatibility","polarity":"no","conditional":false,"tags":{"substrate":["asphalt"]},"mentions":[],"text":"Not compatible in direct contact with bitumen, tar, fat, oil, solvent containing materials and other plastic materials, e.g. expanded polystyrene (EPS), extruded polystyrene (XPS), polyurethane (PUR), polyisocyanurate (PIR) or phenolic foam (PF). These materials could adversely affect the product properties.","heading":"System information > Compatibility","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/7/sarnafil_g_410-20l.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"System information > Compatibility","web_url":"https://aus.sika.com/en/construction/roofing/pvc-sheet-membranes/membranes/sarnafil-g-410-20l.html"}}]}