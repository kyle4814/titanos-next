{"id":"sika-rugasol-fc","rules":[{"id":"sika-rugasol-fc:suitability:9f161fd5","type":"suitability","polarity":"yes","conditional":false,"tags":{"substrate":["cement_render"]},"mentions":[],"text":"Sika® Rugasol® FC is a gel retarder specially designed for the production of exposed aggregate finishes or for producing a mechanical key to construction joints, stop ends for subsequent rendering applications on vertical surfaces.","heading":"DESCRIPTION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sika-rugasol-fc.pdf","page":1,"page_end":1,"doc_version":"February 2026, Version 01.02","section":"DESCRIPTION","web_url":"https://aus.sika.com/en/construction/concrete/specialty-products/surface-retarders/sika-rugasol-fc.html"}},{"id":"sika-rugasol-fc:suitability:f46d827c","type":"suitability","polarity":"no","conditional":true,"tags":{"substrate":["concrete"]},"mentions":[],"text":"When used correctly, Sika® Rugasol® FC will not stain concrete, even white concrete.","heading":"FEATURES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sika-rugasol-fc.pdf","page":1,"page_end":1,"doc_version":"February 2026, Version 01.02","section":"FEATURES","web_url":"https://aus.sika.com/en/construction/concrete/specialty-products/surface-retarders/sika-rugasol-fc.html"}},{"id":"sika-rugasol-fc:suitability:d158c5d4","type":"suitability","polarity":"no","conditional":true,"tags":{"substrate":["concrete"]},"mentions":[],"text":"Sika® Rugasol® FC will not affect the bond of reinforcement to concrete if accidental splashing occurs, provided it is thoroughly cleaned with clean water.","heading":"FEATURES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sika-rugasol-fc.pdf","page":1,"page_end":1,"doc_version":"February 2026, Version 01.02","section":"FEATURES","web_url":"https://aus.sika.com/en/construction/concrete/specialty-products/surface-retarders/sika-rugasol-fc.html"}}]}