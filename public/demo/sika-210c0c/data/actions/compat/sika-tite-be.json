{"id":"sika-tite-be","rules":[{"id":"sika-tite-be:restriction:ada876b0","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Sika® Tite BE is not designed to stop a hydrostatic head of water pressure.","heading":"LIMITATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.07","section":"LIMITATIONS","web_url":"https://aus.sika.com/en/construction/waterproofing/liquid-applied-membranes/water-based-membranes/sika-tite-be.html"}},{"id":"sika-tite-be:restriction:fc3af2dd","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Sika® Tite BE must not be used over damp, wet or contaminated substrates.","heading":"LIMITATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.07","section":"LIMITATIONS","web_url":"https://aus.sika.com/en/construction/waterproofing/liquid-applied-membranes/water-based-membranes/sika-tite-be.html"}},{"id":"sika-tite-be:restriction:b5425cd5","type":"restriction","polarity":"no","conditional":true,"tags":{},"mentions":[],"text":"Sika® Tite BE must not be applied if it is raining or if rain is imminent.","heading":"LIMITATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.07","section":"LIMITATIONS","web_url":"https://aus.sika.com/en/construction/waterproofing/liquid-applied-membranes/water-based-membranes/sika-tite-be.html"}},{"id":"sika-tite-be:restriction:e6bab689","type":"restriction","polarity":"no","conditional":true,"tags":{},"mentions":[],"text":"Sika® Tite BE must not be applied directly over protective coatings.","heading":"LIMITATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.07","section":"LIMITATIONS","web_url":"https://aus.sika.com/en/construction/waterproofing/liquid-applied-membranes/water-based-membranes/sika-tite-be.html"}},{"id":"sika-tite-be:restriction:3cc59908","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Sika® Tite BE must not be used as a trafficable, exposed or UV stable coating.","heading":"LIMITATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.07","section":"LIMITATIONS","web_url":"https://aus.sika.com/en/construction/waterproofing/liquid-applied-membranes/water-based-membranes/sika-tite-be.html"}},{"id":"sika-tite-be:restriction:adce7464","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Sika® Tite BE is not compatible with polyurethane or silicone sealants.","heading":"LIMITATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.07","section":"LIMITATIONS","web_url":"https://aus.sika.com/en/construction/waterproofing/liquid-applied-membranes/water-based-membranes/sika-tite-be.html"}},{"id":"sika-tite-be:suitability:1f92f78d","type":"suitability","polarity":"yes","conditional":true,"tags":{"environment":["wall"]},"mentions":[],"text":"In backfilling applications (planter boxes/retaining walls etc) allow a minimum of 3 days cure and use suitable protection layer prior to backfilling.","heading":"LIMITATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.07","section":"LIMITATIONS","web_url":"https://aus.sika.com/en/construction/waterproofing/liquid-applied-membranes/water-based-membranes/sika-tite-be.html"}},{"id":"sika-tite-be:restriction:1e189cdc","type":"restriction","