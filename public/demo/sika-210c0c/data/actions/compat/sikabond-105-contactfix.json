{"id":"sikabond-105-contactfix","rules":[{"id":"sikabond-105-contactfix:suitability:7c47592c","type":"suitability","polarity":"yes","conditional":false,"tags":{"substrate":["concrete","glass","metal","timber"]},"mentions":[],"text":"Suitable substrates are timber, rubber sheets, plastic laminates, fabric, cloth backed and polyester backed vinyl, MDF, particleboard, concrete, glass and metal sheets","heading":"USES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/f/sikabond_-105_contactfix.pdf","page":1,"page_end":1,"doc_version":"November 2025, Version 03.01","section":"USES","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/contact-adhesives/sikabond-105-contactfix.html"}},{"id":"sikabond-105-contactfix:restriction:e3db9984","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use in temperatures below +10° C, condensed water may form on adhesive and prevent bonding.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/f/sikabond_-105_contactfix.pdf","page":2,"page_end":2,"doc_version":"November 2025, Version 03.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/contact-adhesives/sikabond-105-contactfix.html"}},{"id":"sikabond-105-contactfix:suitability:a1b3d41a","type":"suitability","polarity":"no","conditional":false,"tags":{"environment":["submerged"]},"mentions":[],"text":"Do not apply excessive adhesive, allow adhesive to pool or apply the two substraes together too early","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/f/sikabond_-105_contactfix.pdf","page":2,"page_end":2,"doc_version":"November 2025, Version 03.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/contact-adhesives/sikabond-105-contactfix.html"}}]}