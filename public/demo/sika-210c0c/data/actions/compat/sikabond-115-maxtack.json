{"id":"sikabond-115-maxtack","rules":[{"id":"sikabond-115-maxtack:restriction:a04f5f90","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Application during high temperature changes is not recommended (movement during curing).","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/s/sikabond-115-maxtack.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikabond-115-maxtack.html"}},{"id":"sikabond-115-maxtack:restriction:40bb2230","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use on bituminous substrates, natural rubber, EPDM rubber or on any building materials which might leech oils, plasticisers or solvents that could degrade the adhesive.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/s/sikabond-115-maxtack.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 01.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikabond-115-maxtack.html"}},{"id":"sikabond-115-maxtack:restriction:ac87a887","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use on polyethylene (PE), polypropylene (PP), polytetrafluoroethylene (PTFE / Teflon), and certain plasticised synthetic materials (pre-trials shall be carried out or contact Sika Technical Services).","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/s/sikabond-115-maxtack.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 01.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikabond-115-maxtack.html"}},{"id":"sikabond-115-maxtack:suitability:d6a4d58c","type":"suitability","polarity":"no","conditional":true,"tags":{"substrate":["glass"]},"mentions":[],"text":"Do not use for bonding glass if the bond line is exposed to sunlight.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/s/sikabond-115-maxtack.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 01.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikabond-115-maxtack.html"}},{"id":"sikabond-115-maxtack:restriction:1b6d0065","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use for structural bonding.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/s/sikabond-115-maxtack.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 01.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikabond-115-maxtack.html"}},{"id":"sikabond-115-maxtack:primer:dd753325","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sika-primer-3-n"],"text":"Apply Sika® Primer-3 N applied by brush","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/s/sikabond-115-maxtack.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 01.02","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikabond-115-maxtack.html"}},{"id":"sikabond-115-maxtack:primer:b5ebaf9a","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sika-primer-3-n"],"text":"Prime surface using Sika® Primer-3 N applied by brush","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/s/sikabond-115-maxtack.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 01.02","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikabond-115-maxtack.html"}}]}