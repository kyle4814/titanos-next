{"id":"sikabond-58-woodfloor","rules":[{"id":"sikabond-58-woodfloor:suitability:10e1c180","type":"suitability","polarity":"yes","conditional":false,"tags":{"substrate":["timber"]},"mentions":[],"text":"SikaBond®-58 Wood Floor is designed for full surface bonding of solid and engineered wood floors and ply boards.","heading":"USES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/x/sikabond_-58_woodfloor.pdf","page":1,"page_end":1,"doc_version":"November 2023, Version 01.04","section":"USES","web_url":"https://aus.sika.com/en/construction/flooring/flooring-adhesivessystems/sikabond-58-woodfloor.html"}},{"id":"sikabond-58-woodfloor:suitability:c889eae4","type":"suitability","polarity":"yes","conditional":false,"tags":{"substrate":["underfloor_heating"]},"mentions":[],"text":"Suitable for use with underfloor heating","heading":"FEATURES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/x/sikabond_-58_woodfloor.pdf","page":1,"page_end":1,"doc_version":"November 2023, Version 01.04","section":"FEATURES","web_url":"https://aus.sika.com/en/construction/flooring/flooring-adhesivessystems/sikabond-58-woodfloor.html"}},{"id":"sikabond-58-woodfloor:suitability:3e70b61c","type":"suitability","polarity":"yes","conditional":true,"tags":{"substrate":["timber"]},"mentions":[],"text":"SikaBond®-58 Wood Floor is only suitable for use by professional wood floor applicators.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/x/sikabond_-58_woodfloor.pdf","page":2,"page_end":2,"doc_version":"November 2023, Version 01.04","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/flooring-adhesivessystems/sikabond-58-woodfloor.html"}},{"id":"sikabond-58-woodfloor:primer:e71f512f","type":"primer","polarity":"yes","conditional":false,"tags":{"substrate":["timber","waterproofing_membrane"]},"mentions":["doc-sika-primer-mb"],"text":"Before wood floors may be installed in non-insulated areas, such as basements or other areas without a damp proof membrane, Sikafloor® EpoCem must be applied and sealed with Sika® Primer MB to control the moisture","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/x/sikabond_-58_woodfloor.pdf","page":2,"page_end":2,"doc_version":"November 2023, Version 01.04","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/flooring-adhesivessystems/sikabond-58-woodfloor.html"}},{"id":"sikabond-58-woodfloor:restriction:7b919540","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use on polyethylene (PE), polypropylene (PP), polytetrafluoroethylene (PTFE / Teflon), and other similar plasticized synthetic materials.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/x/sikabond_-58_woodfloor.pdf","page":2,"page_end":2,"doc_version":"November 2023, Version 01.04","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/flooring-adhesivessystems/sikabond-58-woodfloor.html"}},{"id":"sikabond-58-woodfloor:primer:d5ba7cbc","type":"primer","polarity":"yes","conditional":false,"tags":{"substrate":["asphalt"]},"mentions":["doc-sika-primer-mr-fast","doc-sika-primer-mb"],"text":"Broadcast mastic asphalt must be primed with Sika® Primer MR Fast or Sika® Primer MB. For the instructions for use, please refer to the corresponding Product Data Sheet.","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/x/sikabond_-58_woodfloor.pdf","page":3,"page_end":3,"doc_version":"November 2023, Version 01.04","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/flooring/flooring-adhesivessystems/sikabond-58-woodfloor.html"}},{"id":"sikabond-58-woodfloor:primer:bb26e447","type":"primer","polarity":"yes","conditional":false,"tags":{"substrate":["asphalt"],"environment":["floor"]},"mentions":["doc-sika-primer-mb"],"text":"For broadcasted mastic asphalt, cement based floors with excessive moisture content and use over old adhesive residues or on weak substrates use Sika® Primer MB. For detailed instructions contact our Technical Service Department.","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/x/sikabond_-58_woodfloor.pdf","page":3,"page_end":3,"doc_version":"November 2023, Version 01.04","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/flooring/flooring-adhesivessystems/sikabond-58-woodfloor.html"}},{"id":"sikabond-58-woodfloor:product_relation:d3adcac9","type":"product_relation","polarity":"yes","conditional":true,"tags":{"substrate":["timber"]},"mentions":["sika-remover-208"],"text":"Fresh, uncured adhesive on the wood floor surface must be removed immediately with a clean cloth and if necessary also cleaned with Sika® Remover-208 or Sika®TopClean-T. Always test wood floor surfaces for compatibility with Sika® Cleaner-208 before use","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/x/sikabond_-58_woodfloor.pdf","page":3,"page_end":3,"doc_version":"November 2023, Version 01.04","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/flooring/flooring-adhesivessystems/sikabond-58-woodfloor.html"}}]}