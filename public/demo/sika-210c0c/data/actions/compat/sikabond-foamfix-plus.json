{"id":"sikabond-foamfix-plus","rules":[{"id":"sikabond-foamfix-plus:suitability:a7ed5e6f","type":"suitability","polarity":"yes","conditional":false,"tags":{"substrate":["plasterboard"]},"mentions":[],"text":"SikaBond® FoamFix+ is designed for fixing plasterboards and insulation boards such as: Extruded polystyrene boards (XPS)","heading":"USES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sikabond_foamfix.pdf","page":1,"page_end":1,"doc_version":"September 2025, Version 02.03","section":"USES","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/foam-sealants-adhesives/sikabond-foamfix-plus.html"}},{"id":"sikabond-foamfix-plus:restriction:a2d4082e","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"In order to get a good quality foam, the can temperature should not vary more than 10 °C from the ambient temperature.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sikabond_foamfix.pdf","page":2,"page_end":2,"doc_version":"September 2025, Version 02.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/foam-sealants-adhesives/sikabond-foamfix-plus.html"}},{"id":"sikabond-foamfix-plus:restriction:25a7b013","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use on polyethylene (PE), polypropylene (PP), polytetrafluoroethylene (PTFE / Teflon), and silicone, oil, grease and other separating agents.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sikabond_foamfix.pdf","page":2,"page_end":2,"doc_version":"September 2025, Version 02.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/foam-sealants-adhesives/sikabond-foamfix-plus.html"}},{"id":"sikabond-foamfix-plus:restriction:dfe7ef0a","type":"restriction"