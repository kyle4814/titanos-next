{"id":"sikabond-t-55-j","rules":[{"id":"sikabond-t-55-j:suitability:a44fa32d","type":"suitability","polarity":"yes","conditional":false,"tags":{"substrate":["timber"]},"mentions":[],"text":"SikaBond® T-55 J is designed for full surface wood floor bonding of solid and engineered wood floors and subfloors.","heading":"USES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sikabond_t-55_j.pdf","page":1,"page_end":1,"doc_version":"October 2024, Version 01.05","section":"USES","web_url":"https://aus.sika.com/en/construction/flooring/flooring-adhesivessystems/sikabond-t-55-j.html"}},{"id":"sikabond-t-55-j:suitability:c889eae4","type":"suitability","polarity":"yes","conditional":false,"tags":{"substrate":["underfloor_heating"]},"mentions":[],"text":"Suitable for use with underfloor heating","heading":"FEATURES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sikabond_t-55_j.pdf","page":1,"page_end":1,"doc_version":"October 2024, Version 01.05","section":"FEATURES","web_url":"https://aus.sika.com/en/construction/flooring/flooring-adhesivessystems/sikabond-t-55-j.html"}},{"id":"sikabond-t-55-j:suitability:eb399e02","type":"suitability","polarity":"yes","conditional":true,"tags":{"tile_type":["ceramic"]},"mentions":[],"text":"Suitable for bonding directly onto old ceramic tiles","heading":"FEATURES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sikabond_t-55_j.pdf","page":1,"page_end":1,"doc_version":"October 2024, Version 01.05","section":"FEATURES","web_url":"https://aus.sika.com/en/construction/flooring/flooring-adhesivessystems/sikabond-t-55-j.html"}},{"id":"sikabond-t-55-j:suitability:492caeca","type":"suitability","polarity":"yes","conditional":true,"tags":{"substrate":["timber"]},"mentions":[],"text":"SikaBond® T-55 J is only suitable for use by professional wood floor applicators.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sikabond_t-55_j.pdf","page":2,"page_end":2,"doc_version":"October 2024, Version 01.05","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/flooring-adhesivessystems/sikabond-t-55-j.html"}},{"id":"sikabond-t-55-j:primer:e71f512f","type":"primer","polarity":"yes","conditional":false,"tags":{"substrate":["timber","waterproofing_membrane"]},"mentions":["doc-sika-primer-mb"],"text":"Before wood floors may be installed in non-insulated areas, such as basements or other areas without a damp proof membrane, Sikafloor® EpoCem must be applied and sealed with Sika® Primer MB to control the moisture","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sikabond_t-55_j.pdf","page":2,"page_end":2,"doc_version":"October 2024, Version 01.05","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/flooring-adhesivessystems/sikabond-t-55-j.html"}},{"id":"sikabond-t-55-j:restriction:7b919540","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use on polyethylene (PE), polypropylene (PP), polytetrafluoroethylene (PTFE / Teflon), and other similar plasticized synthetic materials.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sikabond_t-55_j.pdf","page":3,"page_end":3,"doc_version":"October 2024, Version 01.05","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/flooring-adhesivessystems/sikabond-t-55-j.html"}},{"id":"sikabond-t-55-j:primer:99d54032","type":"primer","polarity":"yes","conditional":false,"tags":{"substrate":["asphalt"]},"mentions":["doc-sika-primer-mb"],"text":"Broadcast mastic asphalt must be primed with Sika® Primer MB. Refer to the Product Data Sheet for further application details.","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sikabond_t-55_j.pdf","page":3,"page_end":3,"doc_version":"October 2024, Version 01.05","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/flooring/flooring-adhesivessystems/sikabond-t-55-j.html"}},{"id":"sikabond-t-55-j:suitability:3387c9f4","type":"suitability","polarity":"yes","conditional":false,"tags":{"substrate":["concrete","timber"],"tile_type":["ceramic"],"environment":["floor"]},"mentions":[],"text":"SikaBond® T-55 J can be used without priming on cement based floors, anhydrite floors, chipboards, concrete and ceramic tiles.","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sikabond_t-55_j.pdf","page":3,"page_end":3,"doc_version":"October 2024, Version 01.05","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/flooring/flooring-adhesivessystems/sikabond-t-55-j.html"}},{"id":"sikabond-t-55-j:primer:bb26e447","type":"primer","polarity":"yes","conditional":false,"tags":{"substrate":["asphalt"],"environment":["floor"]},"mentions":["doc-sika-primer-mb"],"text":"For broadcasted mastic asphalt, cement based floors with excessive moisture content and use over old adhesive residues or on weak substrates use Sika® Primer MB. For detailed instructions contact our Technical Service Department.","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sikabond_t-55_j.pdf","page":3,"page_end":3,"doc_version":"October 2024, Version 01.05","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/flooring/flooring-adhesivessystems/sikabond-t-55-j.html"}},{"id":"sikabond-t-55-j:product_relation:d3adcac9","type":"product_relation","polarity":"yes","conditional":true,"tags":{"substrate":["timber"]},"mentions":["sika-remover-208"],"text":"Fresh, uncured adhesive on the wood floor surface must be removed immediately with a clean cloth and if necessary also cleaned with Sika® Remover-208 or Sika®TopClean-T. Always test wood floor surfaces for compatibility with Sika® Cleaner-208 before use","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sikabond_t-55_j.pdf","page":3,"page_end":3,"doc_version":"October 2024, Version 01.05","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/flooring/flooring-adhesivessystems/sikabond-t-55-j.html"}}]}