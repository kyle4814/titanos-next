{"id":"sikadur-42-hf","rules":[{"id":"sikadur-42-hf:suitability:27ab9ae6","type":"suitability","polarity":"yes","conditional":false,"tags":{"substrate":["brick_block","concrete","metal"]},"mentions":[],"text":"Sikadur®-42 HF may be used for underwater work and offers excellent adhesion to both dry and clean water immersed concrete, stone masonry, brick, wood or steel surfaces","heading":"USES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/5/sikadur-42-hf.pdf","page":1,"page_end":1,"doc_version":"February 2025, Version 03.05","section":"USES","web_url":"https://aus.sika.com/en/construction/grouts-anchoring/epoxy-grouts/sikadur-42-hf.html"}},{"id":"sikadur-42-hf:restriction:5336d355","type":"restriction","polarity":"no","conditional":true,"tags":{},"mentions":[],"text":"Do not apply under water at depths greater than 5m without referral to our Technical Department.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/5/sikadur-42-hf.pdf","page":2,"page_end":2,"doc_version":"February 2025, Version 03.05","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/grouts-anchoring/epoxy-grouts/sikadur-42-hf.html"}}]}