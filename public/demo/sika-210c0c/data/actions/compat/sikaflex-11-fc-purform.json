{"id":"sikaflex-11-fc-purform","rules":[{"id":"sikaflex-11-fc-purform:product_relation:21fa5b7a","type":"product_relation","polarity":"yes","conditional":false,"tags":{"environment":["external","internal"]},"mentions":["1671"],"text":"Sikaflex®-11 FC Purform® is a 1-part, moisture curing, elastic adhesive and sealant designed for interior and exterior multipurpose bonding and joint sealing","heading":"DESCRIPTION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/w/sikaflex-11-fc-purform.pdf","page":1,"page_end":1,"doc_version":"August 2024, Version 04.01","section":"DESCRIPTION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-11-fc-purform.html"}},{"id":"sikaflex-11-fc-purform:restriction:b73fdcdc","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use on bituminous substrates, natural rubber, EPDM rubber or on any building materials which might leach oils, plasticisers or solvents that could degrade the adhesive.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/w/sikaflex-11-fc-purform.pdf","page":4,"page_end":4,"doc_version":"August 2024, Version 04.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-11-fc-purform.html"}},{"id":"sikaflex-11-fc-purform:restriction:64ccaa20","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use on polyethylene (PE), polypropylene (PP), polytetrafluoroethylene (PTFE / Teflon), and certain plasticised synthetic materials","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/w/sikaflex-11-fc-purform.pdf","page":4,"page_end":4,"doc_version":"August 2024, Version 04.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-11-fc-purform.html"}},{"id":"sikaflex-11-fc-purform:suitability:f77a464e","type":"suitability","polarity":"no","conditional":false,"tags":{"environment":["submerged"]},"mentions":[],"text":"Do not use to seal joints in and around swimming pools.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/w/sikaflex-11-fc-purform.pdf","page":4,"page_end":4,"doc_version":"August 2024, Version 04.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-11-fc-purform.html"}},{"id":"sikaflex-11-fc-purform:suitability:d6a4d58c","type":"suitability","polarity":"no","conditional":true,"tags":{"substrate":["glass"]},"mentions":[],"text":"Do not use for bonding glass if the bond line is exposed to sunlight.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/w/sikaflex-11-fc-purform.pdf","page":4,"page_end":4,"doc_version":"August 2024, Version 04.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-11-fc-purform.html"}},{"id":"sikaflex-11-fc-purform:restriction:1b6d0065","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use for structural bonding.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/w/sikaflex-11-fc-purform.pdf","page":4,"page_end":4,"doc_version":"August 2024, Version 04.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-11-fc-purform.html"}},{"id":"sikaflex-11-fc-purform:restriction:a04f5f90","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Application during high temperature changes is not recommended (movement during curing).","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/w/sikaflex-11-fc-purform.pdf","page":4,"page_end":4,"doc_version":"August 2024, Version 04.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-11-fc-purform.html"}},{"id":"sikaflex-11-fc-purform:primer:983f1190","type":"primer","polarity":"yes","conditional":true,"tags":{},"mentions":["1671","sika-primer-3-n"],"text":"When using Sikaflex®-11 FC Purform® for joints under water pressure or for permanent water immersion, Sika Primer 3N must be used.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/w/sikaflex-11-fc-purform.pdf","page":4,"page_end":4,"doc_version":"August 2024, Version 04.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-11-fc-purform.html"}},{"id":"sikaflex-11-fc-purform:product_relation:87a80ddc","type":"product_relation","polarity":"yes","conditional":false,"tags":{},"mentions":["1671"],"text":"Always use Sikaflex®-11 FC Purform® in conjunction with mechanical fixings for overhead applications or heavy components.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/w/sikaflex-11-fc-purform.pdf","page":4,"page_end":4,"doc_version":"August 2024, Version 04.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-11-fc-purform.html"}},{"id":"sikaflex-11-fc-purform:restriction:aded57db","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Full surface applications / fixings are not recommended since the inner part of the adhesive layer may never cure.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/w/sikaflex-11-fc-purform.pdf","page":4,"page_end":4,"doc_version":"August 2024, Version 04.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-11-fc-purform.html"}},{"id":"sikaflex-11-fc-purform:primer:dcb9f778","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sika-primer-3-n"],"text":"Apply Sika® Primer-3 N by brush","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/w/sikaflex-11-fc-purform.pdf","page":4,"page_end":4,"doc_version":"August 2024, Version 04.01","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-11-fc-purform.html"}},{"id":"sikaflex-11-fc-purform:primer:5c1b8535","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sika-primer-215"],"text":"Allow a further waiting time of > 30 minutes (< 8 hours) before bonding / sealing, PVC has to be cleaned and pre-treated using Sika® Primer-215 applied with a brush","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/w/sikaflex-11-fc-purform.pdf","page":4,"page_end":4,"doc_version":"August 2024, Version 04.01","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-11-fc-purform.html"}},{"id":"sikaflex-11-fc-purform:primer:8c60d33d","type":"primer","polarity":"yes","conditional":false,"tags":{"substrate":["aac","concrete","porous_substrate"]},"mentions":["sika-primer-3-n"],"text":"Porous substrates Concrete, aerated concrete and cement-based renders, mortars and bricks, prime surface using Sika® Primer-3 N applied by brush","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/w/sikaflex-11-fc-purform.pdf","page":4,"page_end":4,"doc_version":"August 2024, Version 04.01","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-11-fc-purform.html"}}]}