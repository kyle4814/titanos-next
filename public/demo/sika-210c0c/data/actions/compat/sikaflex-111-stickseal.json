{"id":"sikaflex-111-stickseal","rules":[{"id":"sikaflex-111-stickseal:suitability:962791d8","type":"suitability","polarity":"yes","conditional":false,"tags":{"substrate":["concrete"]},"mentions":[],"text":"Bonds to damp concrete","heading":"FEATURES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/b/sikaflex_-111_stickseal.pdf","page":1,"page_end":1,"doc_version":"December 2023, Version 07.03","section":"FEATURES","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-111-stickseal.html"}},{"id":"sikaflex-111-stickseal:suitability:362eb1e1","type":"suitability","polarity":"yes","conditional":false,"tags":{"substrate":["asphalt"]},"mentions":[],"text":"Compatible with most bitumen grades","heading":"FEATURES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/b/sikaflex_-111_stickseal.pdf","page":1,"page_end":1,"doc_version":"December 2023, Version 07.03","section":"FEATURES","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-111-stickseal.html"}},{"id":"sikaflex-111-stickseal:restriction:a04f5f90","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Application during high temperature changes is not recommended (movement during curing).","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/b/sikaflex_-111_stickseal.pdf","page":3,"page_end":3,"doc_version":"December 2023, Version 07.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-111-stickseal.html"}},{"id":"sikaflex-111-stickseal:restriction:aded57db","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Full surface applications / fixings are not recommended since the inner part of the adhesive layer may never cure.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/b/sikaflex_-111_stickseal.pdf","page":3,"page_end":3,"doc_version":"December 2023, Version 07.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-111-stickseal.html"}},{"id":"sikaflex-111-stickseal:restriction:73475902","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use on natural rubber, EPDM rubber or on any building materials which might leach oils, plasticisers or solvents that could degrade the adhesive.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/b/sikaflex_-111_stickseal.pdf","page":3,"page_end":3,"doc_version":"December 2023, Version 07.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-111-stickseal.html"}},{"id":"sikaflex-111-stickseal:restriction:64ccaa20","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use on polyethylene (PE), polypropylene (PP), polytetrafluoroethylene (PTFE / Teflon), and certain plasticised synthetic materials","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/b/sikaflex_-111_stickseal.pdf","page":3,"page_end":3,"doc_version":"December 2023, Version 07.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-111-stickseal.html"}},{"id":"sikaflex-111-stickseal:suitability:f77a464e","type":"suitability","polarity":"no","conditional":false,"tags":{"environment":["submerged"]},"mentions":[],"text":"Do not use to seal joints in and around swimming pools.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/b/sikaflex_-111_stickseal.pdf","page":3,"page_end":3,"doc_version":"December 2023, Version 07.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-111-stickseal.html"}},{"id":"sikaflex-111-stickseal:restriction:33056572","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use for joints under water pressure or for permanent water immersion.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/b/sikaflex_-111_stickseal.pdf","page":3,"page_end":3,"doc_version":"December 2023, Version 07.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-111-stickseal.html"}},{"id":"sikaflex-111-stickseal:suitability:aabb413f","type":"suitability","polarity":"no","conditional":false,"tags":{"substrate":["glass"],"environment":["floor"]},"mentions":[],"text":"Do not use to seal glass or in floor or sanitary joints.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/b/sikaflex_-111_stickseal.pdf","page":3,"page_end":3,"doc_version":"December 2023, Version 07.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-111-stickseal.html"}},{"id":"sikaflex-111-stickseal:suitability:d6a4d58c","type":"suitability","polarity":"no","conditional":true,"tags":{"substrate":["glass"]},"mentions":[],"text":"Do not use for bonding glass if the bond line is exposed to sunlight.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/b/sikaflex_-111_stickseal.pdf","page":3,"page_end":3,"doc_version":"December 2023, Version 07.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-111-stickseal.html"}},{"id":"sikaflex-111-stickseal:restriction:1b6d0065","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use for structural bonding.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/b/sikaflex_-111_stickseal.pdf","page":3,"page_end":3,"doc_version":"December 2023, Version 07.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-111-stickseal.html"}},{"id":"sikaflex-111-stickseal:primer:dd753325","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sika-primer-3-n"],"text":"Apply Sika® Primer-3 N applied by brush","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/b/sikaflex_-111_stickseal.pdf","page":3,"page_end":3,"doc_version":"December 2023, Version 07.03","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-111-stickseal.html"}},{"id":"sikaflex-111-stickseal:primer:5c9de239","type":"primer","polarity":"yes","conditional":false,"tags":{"substrate":["aac","concrete","porous_substrate"]},"mentions":["sika-primer-3-n"],"text":"Porous substrates Concrete, aerated concrete and cement-based renders, mortars and bricks: prime surface using Sika® Primer-3 N applied by brush","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/b/sikaflex_-111_stickseal.pdf","page":3,"page_end":3,"doc_version":"December 2023, Version 07.03","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-111-stickseal.html"}}]}