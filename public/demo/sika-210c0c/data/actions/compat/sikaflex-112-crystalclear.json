{"id":"sikaflex-112-crystalclear","rules":[{"id":"sikaflex-112-crystalclear:restriction:a04f5f90","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Application during high temperature changes is not recommended (movement during curing).","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/s/sikaflex_-112_crystalclear.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 06.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-112-crystalclear.html"}},{"id":"sikaflex-112-crystalclear:restriction:aded57db","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Full surface applications / fixings are not recommended since the inner part of the adhesive layer may never cure.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/s/sikaflex_-112_crystalclear.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 06.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-112-crystalclear.html"}},{"id":"sikaflex-112-crystalclear:restriction:b73fdcdc","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use on bituminous substrates, natural rubber, EPDM rubber or on any building materials which might leach oils, plasticisers or solvents that could degrade the adhesive.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/s/sikaflex_-112_crystalclear.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 06.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-112-crystalclear.html"}},{"id":"sikaflex-112-crystalclear:restriction:533d87d6","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use on polyethylene (PE), polypropylene (PP), polytetrafluoroethylene (PTFE / Teflon) and certain plasticised synthetic materials","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/s/sikaflex_-112_crystalclear.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 06.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-112-crystalclear.html"}},{"id":"sikaflex-112-crystalclear:suitability:f77a464e","type":"suitability","polarity":"no","conditional":false,"tags":{"environment":["submerged"]},"mentions":[],"text":"Do not use to seal joints in and around swimming pools.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/s/sikaflex_-112_crystalclear.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 06.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-112-crystalclear.html"}},{"id":"sikaflex-112-crystalclear:restriction:33056572","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use for joints under water pressure or for permanent water immersion.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/s/sikaflex_-112_crystalclear.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 06.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-112-crystalclear.html"}},{"id":"sikaflex-112-crystalclear:suitability:aabb413f","type":"suitability","polarity":"no","conditional":false,"tags":{"substrate":["glass"],"environment":["floor"]},"mentions":[],"text":"Do not use to seal glass or in floor or sanitary joints.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/s/sikaflex_-112_crystalclear.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 06.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-112-crystalclear.html"}},{"id":"sikaflex-112-crystalclear:suitability:d6a4d58c","type":"suitability","polarity":"no","conditional":true,"tags":{"substrate":["glass"]},"mentions":[],"text":"Do not use for bonding glass if the bond line is exposed to sunlight.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/s/sikaflex_-112_crystalclear.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 06.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-112-crystalclear.html"}},{"id":"sikaflex-112-crystalclear:restriction:1b6d0065","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use for structural bonding.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/s/sikaflex_-112_crystalclear.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 06.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-112-crystalclear.html"}},{"id":"sikaflex-112-crystalclear:primer:dd753325","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sika-primer-3-n"],"text":"Apply Sika® Primer-3 N applied by brush","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/s/sikaflex_-112_crystalclear.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 06.01","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-112-crystalclear.html"}},{"id":"sikaflex-112-crystalclear:primer:593f11db","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sika-primer-215"],"text":"PVC has to be cleaned and pre-treated using Sika® Primer-215 applied with a brush","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/s/sikaflex_-112_crystalclear.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 06.01","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-112-crystalclear.html"}},{"id":"sikaflex-112-crystalclear:primer:e322b89d","type":"primer","polarity":"yes","conditional":false,"tags":{"substrate":["aac","concrete","porous_substrate"]},"mentions":["sika-primer-3-n"],"text":"Porous substrates Concrete, aerated concrete and cement based renders, mortars and bricks, prime surface using Sika® Primer-3 N applied by brush","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/s/sikaflex_-112_crystalclear.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 06.01","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-112-crystalclear.html"}}]}