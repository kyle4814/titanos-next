{"id":"sikaflex-118-extremegrab","rules":[{"id":"sikaflex-118-extremegrab:restriction:ebce83f4","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"*For mirror bonding, do not use over vinyl backing.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sikaflex_-118_extremegrab.pdf","page":2,"page_end":2,"doc_version":"April 2025, Version 06.04","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-118-extremegrab.html"}},{"id":"sikaflex-118-extremegrab:restriction:1b64345f","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Application during high temperature changes is not recommended (movements during the curing).","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sikaflex_-118_extremegrab.pdf","page":2,"page_end":2,"doc_version":"April 2025, Version 06.04","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-118-extremegrab.html"}},{"id":"sikaflex-118-extremegrab:restriction:aded57db","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Full surface applications / fixings are not recommended since the inner part of the adhesive layer may never cure.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sikaflex_-118_extremegrab.pdf","page":2,"page_end":2,"doc_version":"April 2025, Version 06.04","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-118-extremegrab.html"}},{"id":"sikaflex-118-extremegrab:restriction:525d5bc8","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use o