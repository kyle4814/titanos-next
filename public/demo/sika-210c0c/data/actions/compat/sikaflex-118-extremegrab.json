IONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sikaflex_-118_extremegrab.pdf","page":2,"page_end":2,"doc_version":"April 2025, Version 06.04","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-118-extremegrab.html"}},{"id":"sikaflex-118-extremegrab:primer:dd753325","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sika-primer-3-n"],"text":"Apply Sika® Primer-3 N applied by brush","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sikaflex_-118_extremegrab.pdf","page":3,"page_end":3,"doc_version":"April 2025, Version 06.04","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-118-extremegrab.html"}},{"id":"sikaflex-118-extremegrab:primer:593f11db","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sika-primer-215"],"text":"PVC has to be cleaned and pre-treated using Sika® Primer-215 applied with a brush","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sikaflex_-118_extremegrab.pdf","page":3,"page_end":3,"doc_version":"April 2025, Version 06.04","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/construction-adhesives/sikaflex-118-extremegrab.html"}},{"id":"sikaflex-118-extremegrab:primer:e322b89d","type":"primer","polarity":"yes","conditional":false,"tags":{"substrate":["aac","concrete","porous_substrate"]},"mentions":["sika-primer-3-n"],"text":"Porous substrates Concrete, aerated concrete and cement based renders, mortars and bricks, prime surface using Sika® Primer-3 N applied by brush","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sikaflex_-118_extremegrab.pdf","page":3,"page_end