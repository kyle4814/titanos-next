{"id":"sikaflex-400-fire","rules":[{"id":"sikaflex-400-fire:suitability:50231945","type":"suitability","polarity":"yes","conditional":false,"tags":{"substrate":["nonporous_substrate"]},"mentions":[],"text":"Sikaflex®-400 Fire is designed for fire rated movement and connection joints and penetrations on porous and non-porous substrates.","heading":"USES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/8/sikaflex_-400_fire.pdf","page":1,"page_end":1,"doc_version":"April 2023, Version 02.03","section":"USES","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/facade-sealants/sikaflex-400-fire.html"}},{"id":"sikaflex-400-fire:suitability:bc757d19","type":"suitability","polarity":"no","conditional":false,"tags":{"tile_type":["natural_stone"]},"mentions":[],"text":"Do not use on natural stone.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/8/sikaflex_-400_fire.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 02.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/facade-sealants/sikaflex-400-fire.html"}},{"id":"sikaflex-400-fire:restriction:225e4572","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use on bituminous substrates, natural rubber, EPDM rubber or on any building materials which might leach oils, plasticisers or solvents that could degrade the sealant.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/8/sikaflex_-400_fire.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 02.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/facade-sealants/sikaflex-400-fire.html"}},{"id":"sikaflex-400-fire:suitability:f77a464e","type":"suitability","polarity":"no","conditional":false,"tags":{"environment":["submerged"]},"mentions":[],"text":"Do not use to seal joints in and around swimming pools.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/8/sikaflex_-400_fire.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 02.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/facade-sealants/sikaflex-400-fire.html"}},{"id":"sikaflex-400-fire:restriction:1b12cc50","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use for joints under water pressure or permanent water immersion.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/8/sikaflex_-400_fire.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 02.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/facade-sealants/sikaflex-400-fire.html"}},{"id":"sikaflex-400-fire:primer:dd753325","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sika-primer-3-n"],"text":"Apply Sika® Primer-3 N applied by brush","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/8/sikaflex_-400_fire.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 02.03","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/facade-sealants/sikaflex-400-fire.html"}},{"id":"sikaflex-400-fire:primer:4b48ed02","type":"primer","polarity":"yes","conditional":false,"tags":{"substrate":["aac","concrete","porous_substrate"]},"mentions":["sika-primer-210","sika-primer-3-n"],"text":"Before sealing, allow a waiting time of > 30 minutes (< 8 hours) Porous substrates Concrete, aerated concrete and cement based renders, mortars and bricks surfaces must be primed using Sika® Primer-3 N or Sika® Primer-210 applied by brush","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/8/sikaflex_-400_fire.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 02.03","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/facade-sealants/sikaflex-400-fire.html"}}]}