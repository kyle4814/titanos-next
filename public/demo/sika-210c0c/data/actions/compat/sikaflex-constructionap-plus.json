{"id":"sikaflex-constructionap-plus","rules":[{"id":"sikaflex-constructionap-plus:suitability:8cf8a7f9","type":"suitability","polarity":"yes","conditional":false,"tags":{"substrate":["brick_block","concrete"]},"mentions":[],"text":"It is used for durably sealing connection and movement joints in concrete and masonry facades and as a general purpose construction sealant.","heading":"DESCRIPTION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/q/sikaflex-constructionap-plus.pdf","page":1,"page_end":1,"doc_version":"August 2025, Version 01.01","section":"DESCRIPTION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikaflex-constructionap-plus.html"}},{"id":"sikaflex-constructionap-plus:restriction:ff2361f6","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use on stone substrates","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/q/sikaflex-constructionap-plus.pdf","page":3,"page_end":3,"doc_version":"August 2025, Version 01.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikaflex-constructionap-plus.html"}},{"id":"sikaflex-constructionap-plus:restriction:9ba48dc9","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use on polyethylene (PE), polypropylene (PP), polytetrafluoroethylene (PTFE/Teflon), and certain plasticised synthetic materials","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/q/sikaflex-constructionap-plus.pdf","page":3,"page_end":3,"doc_version":"August 2025, Version 01.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikaflex-constructionap-plus.html"}},{"id":"sikaflex-constructionap-plus:restriction:225e4572","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use on bituminous substrates, natural rubber, EPDM rubber or on any building materials which might leach oils, plasticisers or solvents that could degrade the sealant.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/q/sikaflex-constructionap-plus.pdf","page":3,"page_end":3,"doc_version":"August 2025, Version 01.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikaflex-constructionap-plus.html"}},{"id":"sikaflex-constructionap-plus:suitability:2a7e72d3","type":"suitability","polarity":"no","conditional":false,"tags":{"environment":["submerged"]},"mentions":[],"text":"Do not use the to seal joints in and around swimming pools.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/q/sikaflex-constructionap-plus.pdf","page":3,"page_end":3,"doc_version":"August 2025, Version 01.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikaflex-constructionap-plus.html"}},{"id":"sikaflex-constructionap-plus:restriction:12664ad8","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use for joints under water pressure or for permanent water immersion","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/q/sikaflex-constructionap-plus.pdf","page":3,"page_end":3,"doc_version":"August 2025, Version 01.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikaflex-constructionap-plus.html"}},{"id":"sikaflex-constructionap-plus:primer:0db090ac","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sika-primer-3-n"],"text":"Apply Sika® Primer-3 N by brush.","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/q/sikaflex-constructionap-plus.pdf","page":3,"page_end":3,"doc_version":"August 2025, Version 01.01","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikaflex-constructionap-plus.html"}},{"id":"sikaflex-constructionap-plus:primer:26cf307d","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sika-primer-215"],"text":"PVC Clean and prime the surface using Sika® Primer-215 applied with a brush.","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/q/sikaflex-constructionap-plus.pdf","page":3,"page_end":3,"doc_version":"August 2025, Version 01.01","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikaflex-constructionap-plus.html"}},{"id":"sikaflex-constructionap-plus:primer:75343a98","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sika-primer-3-n"],"text":"Prime surface using Sika® Primer-3 N applied by brush.","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/q/sikaflex-constructionap-plus.pdf","page":3,"page_end":3,"doc_version":"August 2025, Version 01.01","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikaflex-constructionap-plus.html"}}]}