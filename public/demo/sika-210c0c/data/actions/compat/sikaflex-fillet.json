{"id":"sikaflex-fillet","rules":[{"id":"sikaflex-fillet:suitability:dad6623f","type":"suitability","polarity":"yes","conditional":false,"tags":{"environment":["floor","wall"]},"mentions":[],"text":"Sikaflex® Fillet is designed for use as a fillet joint for movement junctions (wall to wall, wall to floor) in waterproofing installations.","heading":"USES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/d/sikaflex_fillet.pdf","page":1,"page_end":1,"doc_version":"April 2023, Version 01.02","section":"USES","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/waterproofing-sealants/sikaflex-fillet.html"}},{"id":"sikaflex-fillet:restriction:13357927","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"However a change in colour will not adversely influence the technical performance or the durability of the product.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/d/sikaflex_fillet.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/waterproofing-sealants/sikaflex-fillet.html"}},{"id":"sikaflex-fillet:suitability:5e8106e8","type":"suitability","polarity":"no","conditional":false,"tags":{"substrate":["glass"]},"mentions":[],"text":"Do not use Sikaflex® Fillet as a glass sealer, on bituminous substrates, natural rubber, EPDM rubber or on building materials which might bleed oils, plasticizers or solvents which could attack the sealant.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/d/sikaflex_fillet.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/waterproofing-sealants/sikaflex-fillet.html"}},{"id":"sikaflex-fillet:suitability:aa2e8d73","type":"suitability","polarity":"no","conditional":false,"tags":{"environment":["submerged"]},"mentions":[],"text":"Do not use Sikaflex® Fillet to seal swimming pools.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/d/sikaflex_fillet.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/waterproofing-sealants/sikaflex-fillet.html"}},{"id":"sikaflex-fillet:primer:b85b0385","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sika-primer-3-n"],"text":"use a brush to apply Sika® Primer-3 N and allow a further flash-off time of > 30 minutes (< 8 hours) before sealing the joints","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/d/sikaflex_fillet.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/waterproofing-sealants/sikaflex-fillet.html"}},{"id":"sikaflex-fillet:primer:593f11db","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sika-primer-215"],"text":"PVC has to be cleaned and pre-treated using Sika® Primer-215 applied with a brush","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/d/sikaflex_fillet.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/waterproofing-sealants/sikaflex-fillet.html"}},{"id":"sikaflex-fillet:primer:27393458","type":"primer","polarity":"yes","conditional":false,"tags":{"substrate":["aac","concrete","porous_substrate"]},"mentions":["sika-primer-3-n"],"text":"Porous substrates Concrete, aerated concrete and cement based renders, mortars and bricks shall be primed using Sika® Primer-3 N applied with a brush","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/d/sikaflex_fillet.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/waterproofing-sealants/sikaflex-fillet.html"}}]}