{"id":"sikaflex-pro-3-purform","rules":[{"id":"sikaflex-pro-3-purform:suitability:8869671d","type":"suitability","polarity":"yes","conditional":false,"tags":{"environment":["external","internal"]},"mentions":[],"text":"The Product is used for the following horizontal and vertical interior and exterior joint sealing applications: Food industry","heading":"USES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sikaflex-pro-3-purform.pdf","page":1,"page_end":1,"doc_version":"July 2025, Version 04.01","section":"USES","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikaflex-pro-3-purform.html"}},{"id":"sikaflex-pro-3-purform:alternative:c546318f","type":"alternative","polarity":"no","conditional":false,"tags":{},"mentions":["4649"],"text":"Do not use the Sikaflex® PRO-3 Purform® on stone substrates","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sikaflex-pro-3-purform.pdf","page":3,"page_end":3,"doc_version":"July 2025, Version 04.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikaflex-pro-3-purform.html"}},{"id":"sikaflex-pro-3-purform:alternative:bcebb7ab","type":"alternative","polarity":"no","conditional":false,"tags":{"environment":["submerged"]},"mentions":["4649"],"text":"Do not use the Sikaflex® PRO-3 Purform® to seal joints in and around swimming pools containing water treatment agents such as chlorine.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sikaflex-pro-3-purform.pdf","page":3,"page_end":3,"doc_version":"July 2025, Version 04.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikaflex-pro-3-purform.html"}},{"id":"sikaflex-pro-3-purform:restriction:225e4572","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use on bituminous substrates, natural rubber, EPDM rubber or on any building materials which might leach oils, plasticisers or solvents that could degrade the sealant.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sikaflex-pro-3-purform.pdf","page":4,"page_end":4,"doc_version":"July 2025, Version 04.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikaflex-pro-3-purform.html"}},{"id":"sikaflex-pro-3-purform:restriction:64ccaa20","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use on polyethylene (PE), polypropylene (PP), polytetrafluoroethylene (PTFE / Teflon), and certain plasticised synthetic materials","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sikaflex-pro-3-purform.pdf","page":4,"page_end":4,"doc_version":"July 2025, Version 04.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikaflex-pro-3-purform.html"}},{"id":"sikaflex-pro-3-purform:primer:75339b76","type":"primer","polarity":"yes","conditional":true,"tags":{},"mentions":["sika-primer-3-n","4649"],"text":"When using Sikaflex® PRO-3 Purform® for joints under water pressure or for permanent water immersion, Sika® Primer 3N must be used.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sikaflex-pro-3-purform.pdf","page":4,"page_end":4,"doc_version":"July 2025, Version 04.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikaflex-pro-3-purform.html"}},{"id":"sikaflex-pro-3-purform:primer:0db090ac","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sika-primer-3-n"],"text":"Apply Sika® Primer-3 N by brush.","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sikaflex-pro-3-purform.pdf","page":4,"page_end":4,"doc_version":"July 2025, Version 04.01","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikaflex-pro-3-purform.html"}},{"id":"sikaflex-pro-3-purform:primer:26cf307d","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sika-primer-215"],"text":"PVC Clean and prime the surface using Sika® Primer-215 applied with a brush.","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sikaflex-pro-3-purform.pdf","page":4,"page_end":4,"doc_version":"July 2025, Version 04.01","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikaflex-pro-3-purform.html"}},{"id":"sikaflex-pro-3-purform:primer:75343a98","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sika-primer-3-n"],"text":"Prime surface using Sika® Primer-3 N applied by brush.","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sikaflex-pro-3-purform.pdf","page":4,"page_end":4,"doc_version":"July 2025, Version 04.01","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikaflex-pro-3-purform.html"}},{"id":"sikaflex-pro-3-purform:primer:09953cb0","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sika-primer-3-n"],"text":"Prime the surface using Sika® Primer-3 N applied by brush.","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sikaflex-pro-3-purform.pdf","page":4,"page_end":4,"doc_version":"July 2025, Version 04.01","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikaflex-pro-3-purform.html"}}]}