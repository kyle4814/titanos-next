{"id":"sikaflex-pro-plus","rules":[{"id":"sikaflex-pro-plus:product_relation:8a70e3db","type":"product_relation","polarity":"yes","conditional":false,"tags":{"substrate":["brick_block","concrete"]},"mentions":["4649"],"text":"Sikaflex® PRO+ is designed for movement and connection joints in concrete and masonry facades.","heading":"USES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/y/sikaflex_pro_.pdf","page":1,"page_end":1,"doc_version":"April 2023, Version 01.02","section":"USES","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikaflex-pro-plus.html"}},{"id":"sikaflex-pro-plus:alternative:2ff149a4","type":"alternative","polarity":"no","conditional":false,"tags":{"tile_type":["natural_stone"]},"mentions":["4649"],"text":"Do not use Sikaflex® PRO+ on natural stone","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/y/sikaflex_pro_.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 01.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikaflex-pro-plus.html"}},{"id":"sikaflex-pro-plus:alternative:1bbfd4f0","type":"alternative","polarity":"no","conditional":false,"tags":{},"mentions":["4649"],"text":"Do not use Sikaflex® PRO+ on bituminous substrates, natural rubber, EPDM rubber or on any building materials which might bleed oils, plasticizers or solvents that could attack the sealant.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/y/sikaflex_pro_.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 01.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikaflex-pro-plus.html"}},{"id":"sikaflex-pro-plus:alternative:1f01e476","type":"alternative","polarity":"no","conditional":false,"tags":{"environment":["submerged"]},"mentions":["4649"],"text":"Do not use Sikaflex® PRO+ to seal joints in and around swimming pools.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/y/sikaflex_pro_.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 01.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikaflex-pro-plus.html"}},{"id":"sikaflex-pro-plus:alternative:983cb31f","type":"alternative","polarity":"no","conditional":false,"tags":{},"mentions":["4649"],"text":"Do not use Sikaflex® PRO+ for joints under water pressure or for permanent water immersion.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/y/sikaflex_pro_.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 01.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikaflex-pro-plus.html"}},{"id":"sikaflex-pro-plus:primer:b85b0385","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sika-primer-3-n"],"text":"use a brush to apply Sika® Primer-3 N and allow a further flash-off time of > 30 minutes (< 8 hours) before sealing the joints","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/y/sikaflex_pro_.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 01.02","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikaflex-pro-plus.html"}},{"id":"sikaflex-pro-plus:primer:593f11db","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sika-primer-215"],"text":"PVC has to be cleaned and pre-treated using Sika® Primer-215 applied with a brush","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://au