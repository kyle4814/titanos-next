{"id":"sikafloor-08-primer","rules":[{"id":"sikafloor-08-primer:suitability:a69dbf74","type":"suitability","polarity":"yes","conditional":false,"tags":{"substrate":["concrete"]},"mentions":[],"text":"This consistency is used for priming porous concrete surfaces","heading":"DESCRIPTION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/q/sikafloor-08-primer.pdf","page":1,"page_end":1,"doc_version":"April 2023, Version 01.04","section":"DESCRIPTION","web_url":"https://aus.sika.com/en/construction/flooring/cement-levellingsystems/sikafloor-08-primer.html"}},{"id":"sikafloor-08-primer:primer:c89f98ef","type":"primer","polarity":"yes","conditional":true,"tags":{"substrate":["fibre_cement","timber"]},"mentions":["sikafloor-4020-fiberlevel"],"text":"Alternatively Sikafloor®-08 Primer can be applied neat on suitably prepared timber/wood or cement sheeting substrates prior to Sikafloor®-4020 Fiber- Level.","heading":"DESCRIPTION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/q/sikafloor-08-primer.pdf","page":1,"page_end":1,"doc_version":"April 2023, Version 01.04","section":"DESCRIPTION","web_url":"https://aus.sika.com/en/construction/flooring/cement-levellingsystems/sikafloor-08-primer.html"}},{"id":"sikafloor-08-primer:suitability:ade1e96c","type":"suitability","polarity":"yes","conditional":false,"tags":{"environment":["commercial","domestic","floor","wall"]},"mentions":[],"text":"Can be used in residential, commercial and industrial applications Can be applied on floors and walls where required","heading":"USES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/q/sikafloor-08-primer.pdf","page":1,"page_end":1,"doc_version":"April 2023, Version 01.04","section":"USES","web_url":"https://aus.sika.com/en/construction/flooring/cement-levellingsystems/sikafloor-08-primer.html"}},{"id":"sikafloor-08-primer:suitability:cd08aaac","type":"suitability","polarity":"yes","conditional":false,"tags":{"en