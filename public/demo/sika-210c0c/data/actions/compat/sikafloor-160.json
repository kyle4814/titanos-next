{"id":"sikafloor-160","rules":[{"id":"sikafloor-160:restriction:e69a59a6","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not apply Sikafloor®-160 on substrates with rising moisture.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/7/sikafloor_-160.pdf","page":4,"page_end":4,"doc_version":"April 2023, Version 05.04","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/resin-flooring/epoxy-flooring-productssystems/epoxy-flooring-products/sikafloor-160.html"}},{"id":"sikafloor-160:suitability:e242bbc9","type":"suitability","polarity":"no","conditional":true,"tags":{"substrate":["cement_screed"]},"mentions":[],"text":"Sikafloor®-160 mortar screed is not suitable for frequent or permanent contact with water unless sealed.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/7/sikafloor_-160.pdf","page":4,"page_end":4,"doc_version":"April 2023, Version 05.04","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/resin-flooring/epoxy-flooring-productssystems/epoxy-flooring-products/sikafloor-160.html"}},{"id":"sikafloor-160:restriction:2c4178d0","type":"restriction","polarity":"no","conditional":true,"tags":{},"mentions":[],"text":"If heating is required do not use gas, oil, paraffin or other fossil fuel heaters, these produce large quantities of both CO2 and H2O water vapour, which may adversely affect the finish","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/7/sikafloor_-160.pdf","page":4,"page_end":4,"doc_version":"April 2023, Version 05.04","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/resin-flooring/epoxy-flooring-productssystems/epoxy-flooring-products/sikafloor-160.html"}}]}