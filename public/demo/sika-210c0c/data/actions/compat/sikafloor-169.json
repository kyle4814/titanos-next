{"id":"sikafloor-169","rules":[{"id":"sikafloor-169:restriction:56cdb97f","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not apply Sikafloor®-169 on substrates with rising moisture","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/a/sikafloor_-169.pdf","page":3,"page_end":4,"doc_version":"April 2023, Version 04.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/resin-flooring/epoxy-flooring-productssystems/epoxy-flooring-products/sikafloor-169.html"}},{"id":"sikafloor-169:restriction:2c4178d0","type":"restriction","polarity":"no","conditional":true,"tags":{},"mentions":[],"text":"If heating is required do not use gas, oil, paraffin or other fossil fuel heaters, these produce large quantities of both CO2 and H2O water vapour, which may adversely affect the finish","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/a/sikafloor_-169.pdf","page":4,"page_end":4,"doc_version":"April 2023, Version 04.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/resin-flooring/epoxy-flooring-productssystems/epoxy-flooring-products/sikafloor-169.html"}}]}