{"id":"sikafloor-220-wconductive","rules":[{"id":"sikafloor-220-wconductive:primer:d40216b0","type":"primer","polarity":"yes","conditional":false,"tags":{},"mentions":["sikafloor-262-asn"],"text":"Sikafloor®-220 W Conductive must be applied as conductive primer underneath all Sikafloor® conductive wearing courses, such as Sikafloor®-262 AS N, 262 AS N Thixo, -235 ESD, -269 ECF CR, -381 ECF and -390 ECF.","heading":"USES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/p/sikafloor_-220_wconductive.pdf","page":1,"page_end":1,"doc_version":"April 2023, Version 06.01","section":"USES","web_url":"https://aus.sika.com/en/construction/flooring/resin-flooring/epoxy-flooring-productssystems/epoxy-flooring-products/sikafloor-220-wconductive.html"}},{"id":"sikafloor-220-wconductive:restriction:ee40aaa9","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not apply Sikafloor®-220 W Conductive on substrates with rising moisture.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/p/sikafloor_-220_wconductive.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 06.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/resin-flooring/epoxy-flooring-productssystems/epoxy-flooring-products/sikafloor-220-wconductive.html"}},{"id":"sikafloor-220-wconductive:restriction:2c4178d0","type":"restriction","polarity":"no","conditional":true,"tags":{},"mentions":[],"text":"If heating is required do not use gas, oil, paraffin or other fossil fuel heaters, these produce large quantities of both CO2 and H2O water vapour, which may adversely affect the finish","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/p/sikafloor_-220_wconductive.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 06.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/resin-flooring/epoxy-flooring-productssystems/epoxy-flooring-products/sikafloor-220-wconductive.html"}}]}