{"id":"sikafloor-235-esd","rules":[{"id":"sikafloor-235-esd:restriction:c384bb2d","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not apply Sikafloor®-235 ESD on substrates in which significant vapour pressure may occur.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/n/sikafloor_-235_esd.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 02.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/resin-flooring/epoxy-flooring-productssystems/epoxy-flooring-products/sikafloor-235-esd.html"}},{"id":"sikafloor-235-esd:restriction:3f9783b6","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Sikafloor®-235 ESD is not suitable for permanent water load.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/n/sikafloor_-235_esd.pdf","page":4,"page_end":4,"doc_version":"April 2023, Version 02.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/resin-flooring/epoxy-flooring-productssystems/epoxy-flooring-products/sikafloor-235-esd.html"}},{"id":"sikafloor-235-esd:restriction:b2d54fc1","type":"restriction","polarity":"no","conditional":true,"tags":{},"mentions":[],"text":"If heating is required do not use gas, oil, paraffin or other fossil fuel heaters, these produce large quantities of both CO² and H2O water vapour, which may adversely affect the finish","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/n/sikafloor_-235_esd.pdf","page":4,"page_end":4,"doc_version":"April 2023, Version 02.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/resin-flooring/epoxy-flooring-productssystems/epoxy-flooring-products/sikafloor-235-esd.html"}},{"id":"sikafloor-235-esd:restriction:faba9048","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use Sikafloor®-230 ESD TopCoat to overcoat Sikafloor®-235 ESD.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/n/sikafloor_-235_esd.pdf","page":4,"page_end":4,"doc_version":"April 2023, Version 02.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/resin-flooring/epoxy-flooring-productssystems/epoxy-flooring-products/sikafloor-235-esd.html"}}]}