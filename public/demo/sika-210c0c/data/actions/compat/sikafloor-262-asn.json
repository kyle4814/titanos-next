{"id":"sikafloor-262-asn","rules":[{"id":"sikafloor-262-asn:restriction:91df10c2","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not apply Sikafloor®-262 AS N on substrates in which significant vapour pressure may occur.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/5/sikafloor_-262_asn.pdf","page":6,"page_end":6,"doc_version":"April 2023, Version 02.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/resin-flooring/epoxy-flooring-productssystems/epoxy-flooring-products/sikafloor-262-asn.html"}},{"id":"sikafloor-262-asn:restriction:2c4178d0","type":"restriction","polarity":"no","conditional":true,"tags":{},"mentions":[],"text":"If heating is required do not use gas, oil, paraffin or other fossil fuel heaters, these produce large quantities of both CO2 and H2O water vapour, which may adversely affect the finish","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/5/sikafloor_-262_asn.pdf","page":6,"page_end":6,"doc_version":"April 2023, Version 02.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/resin-flooring/epoxy-flooring-productssystems/epoxy-flooring-products/sikafloor-262-asn.html"}}]}