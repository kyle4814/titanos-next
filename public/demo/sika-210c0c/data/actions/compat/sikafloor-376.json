{"id":"sikafloor-376","rules":[{"id":"sikafloor-376:restriction:d690c032","type":"restriction","polarity":"no","conditional":true,"tags":{},"mentions":[],"text":"If heating is required, do not use gas, oil, paraffin or other fossil fuel heaters, these produce large quantities of both CO2 and H2O water vapour, which may adversely affect the finish","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/m/sikafloor_-376.pdf","page":3,"page_end":4,"doc_version":"April 2023, Version 01.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/resin-flooring/polyurethane-flooringproductssystems/polyurethane-flooringproducts/sikafloor-376.html"}},{"id":"sikafloor-376:restriction:36ad29c9","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not apply on substrates with rising moisture.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/m/sikafloor_-376.pdf","page":4,"page_end":4,"doc_version":"April 2023, Version 01.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/resin-flooring/polyurethane-flooringproductssystems/polyurethane-flooringproducts/sikafloor-376.html"}},{"id":"sikafloor-376:suitability:928e23da","type":"suitability","polarity":"no","conditional":false,"tags":{"substrate":["porous_substrate"]},"mentions":[],"text":"Do not apply to porous surfaces where significant moisture vapour transmission (out-gassing) will occur during application.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/m/sikafloor_-376.pdf","page":4,"page_end":4,"doc_version":"April 2023, Version 01.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/resin-flooring/polyurethane-flooringproductssystems/polyurethane-flooringproducts/sikafloor-376.html"}}]}