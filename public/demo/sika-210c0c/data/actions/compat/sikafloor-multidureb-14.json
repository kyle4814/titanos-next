{"id":"sikafloor-multidureb-14","rules":[{"id":"sikafloor-multidureb-14:restriction:d5af89d0","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not apply Sikafloor® MultiDur EB-14 on substrates with rising moisture.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/3/sikafloor_multidureb-14.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 03.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/resin-flooring/epoxy-flooring-productssystems/epoxy-flooring-systems/sikafloor-multidureb-14.html"}},{"id":"sikafloor-multidureb-14:restriction:2c4178d0","type":"restriction","polarity":"no","conditional":true,"tags":{},"mentions":[],"text":"If heating is required do not use gas, oil, paraffin or other fossil fuel heaters, these produce large quantities of both CO2 and H2O water vapour, which may adversely affect the finish","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/3/sikafloor_multidureb-14.pdf","page":4,"page_end":4,"doc_version":"April 2023, Version 03.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/resin-flooring/epoxy-flooring-productssystems/epoxy-flooring-systems/sikafloor-multidureb-14.html"}}]}