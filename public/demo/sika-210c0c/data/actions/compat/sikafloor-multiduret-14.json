{"id":"sikafloor-multiduret-14","rules":[{"id":"sikafloor-multiduret-14:suitability:fb3f419f","type":"suitability","polarity":"yes","conditional":false,"tags":{"environment":["wall"]},"mentions":[],"text":"Sikafloor® MultiDur ET-14 can also be used vertically on coves and walls.","heading":"DESCRIPTION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/e/sikafloor_multiduret-14.pdf","page":1,"page_end":1,"doc_version":"April 2023, Version 03.05","section":"DESCRIPTION","web_url":"https://aus.sika.com/en/construction/flooring/resin-flooring/epoxy-flooring-productssystems/epoxy-flooring-systems/sikafloor-multiduret-14.html"}},{"id":"sikafloor-multiduret-14:restriction:95df3427","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not apply Sikafloor® MultiDur ET-14 on substrates with rising moisture.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/e/sikafloor_multiduret-14.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 03.05","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/resin-flooring/epoxy-flooring-productssystems/epoxy-flooring-systems/sikafloor-multiduret-14.html"}},{"id":"sikafloor-multiduret-14:restriction:2c4178d0","type":"restriction","polarity":"no","conditional":true,"tags":{},"mentions":[],"text":"If heating is required do not use gas, oil, paraffin or other fossil fuel heaters, these produce large quantities of both CO2 and H2O water vapour, which may adversely affect the finish","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/e/sikafloor_multiduret-14.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 03.05","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/flooring/resin-flooring/epoxy-flooring-productssystems/epoxy-flooring-systems/sikafloor-multiduret-1