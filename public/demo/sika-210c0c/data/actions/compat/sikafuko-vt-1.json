{"id":"sikafuko-vt-1","rules":[{"id":"sikafuko-vt-1:suitability:72a9ddcf","type":"suitability","polarity":"yes","conditional":true,"tags":{"substrate":["epoxy_coating"]},"mentions":[],"text":"To seal the joint, SikaFuko® VT-1 is injected with suitable Sika® Injection materials, such as acrylate and microfine cement suspensions (for multiple injections) or polyurethane and epoxy resins (for single injection)","heading":"DESCRIPTION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/u/sikafuko_vt-1.pdf","page":1,"page_end":1,"doc_version":"April 2023, Version 01.02","section":"DESCRIPTION","web_url":"https://aus.sika.com/en/construction/waterproofing/injections-and-hydrophilicsystems/sikafuko-vt-1.html"}},{"id":"sikafuko-vt-1:suitability:cdc8c722","type":"suitability","polarity":"yes","conditional":false,"tags":{"environment":["external"]},"mentions":[],"text":"External test reports for suitable injection material","heading":"CHARACTERISTICS / ADVANTAGES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/u/sikafuko_vt-1.pdf","page":1,"page_end":1,"doc_version":"April 2023, Version 01.02","section":"CHARACTERISTICS / ADVANTAGES","web_url":"https://aus.sika.com/en/construction/waterproofing/injections-and-hydrophilicsystems/sikafuko-vt-1.html"}},{"id":"sikafuko-vt-1:restriction:6c9decf4","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use SikaFuko® VT-1 for sealing expansion / movement joints.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/u/sikafuko_vt-1.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 01.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/waterproofing/injections-and-hydrophilicsystems/sikafuko-vt-1.html"}}]}