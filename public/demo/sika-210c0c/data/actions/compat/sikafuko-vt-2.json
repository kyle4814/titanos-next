{"id":"sikafuko-vt-2","rules":[{"id":"sikafuko-vt-2:suitability:2de62ee7","type":"suitability","polarity":"yes","conditional":true,"tags":{"substrate":["epoxy_coating"]},"mentions":[],"text":"To seal the joint, SikaFuko® VT-2 is injected with suitable Sika® Injection materials, such as acrylate and cement suspensions (for multiple injections) or polyurethane and epoxy resins (for single injection)","heading":"DESCRIPTION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/i/sikafuko_vt-2.pdf","page":1,"page_end":1,"doc_version":"April 2023, Version 01.02","section":"DESCRIPTION","web_url":"https://aus.sika.com/en/construction/waterproofing/injections-and-hydrophilicsystems/sikafuko-vt-2.html"}},{"id":"sikafuko-vt-2:restriction:c9e63e5b","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use SikaFuko® VT-2 for sealing expansion / movement joints.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/i/sikafuko_vt-2.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/waterproofing/injections-and-hydrophilicsystems/sikafuko-vt-2.html"}}]}