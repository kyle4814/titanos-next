{"id":"sikagrout-ultra","rules":[{"id":"sikagrout-ultra:restriction:c3a28ef0","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use in combination with retarding admixtures as this may accelerate the reaction.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/u/sikagrout_ultra.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/grouts-anchoring/cementitious-grouts/sikagrout-ultra.html"}},{"id":"sikagrout-ultra:restriction:c1e3d525","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Never apply to a dry substrate.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/u/sikagrout_ultra.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/grouts-anchoring/cementitious-grouts/sikagrout-ultra.html"}}]}