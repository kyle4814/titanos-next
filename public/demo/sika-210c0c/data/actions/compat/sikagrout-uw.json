{"id":"sikagrout-uw","rules":[{"id":"sikagrout-uw:suitability:2c67261c","type":"suitability","polarity":"yes","conditional":false,"tags":{"substrate":["concrete","metal","timber"]},"mentions":[],"text":"SikaGrout® UW can be used individually for underwater grouting or as a system in conjunction with Sika Pile Jacket systems or other confinement jacket repair systems for rehabilitation of concrete, steel and timber piles in marine applications","heading":"USES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/z/sikagrout_uw.pdf","page":1,"page_end":1,"doc_version":"September 2023, Version 01.03","section":"USES","web_url":"https://aus.sika.com/en/construction/grouts-anchoring/cementitious-grouts/sikagrout-uw.html"}},{"id":"sikagrout-uw:restriction:4697c13a","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not apply SikaGrout® UW in temperatures below 5°C.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/z/sikagrout_uw.pdf","page":2,"page_end":2,"doc_version":"September 2023, Version 01.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/grouts-anchoring/cementitious-grouts/sikagrout-uw.html"}},{"id":"sikagrout-uw:restriction:0576719f","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Never raise the tube used to place SikaGrout® UW above the surface level of the grout.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/z/sikagrout_uw.pdf","page":2,"page_end":2,"doc_version":"September 2023, Version 01.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/grouts-anchoring/cementitious-grouts/sikagrout-uw.html"}}]}