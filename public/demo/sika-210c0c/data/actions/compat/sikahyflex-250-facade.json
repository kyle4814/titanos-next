{"id":"sikahyflex-250-facade","rules":[{"id":"sikahyflex-250-facade:restriction:564afdec","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use SikaHyflex®-250 Facade on bituminous substrates, natural rubber, EPDM rubber or on any building materials which might bleed oils, plasticizers or solvents that could attack the sealant.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/8/sikahyflex_-250_facade.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 03.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikahyflex-250-facade.html"}},{"id":"sikahyflex-250-facade:suitability:488333e6","type":"suitability","polarity":"no","conditional":false,"tags":{"environment":["submerged"]},"mentions":[],"text":"Do not use SikaHyflex®-250 Facade to seal joints in and around swimming pools.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/8/sikahyflex_-250_facade.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 03.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikahyflex-250-facade.html"}},{"id":"sikahyflex-250-facade:restriction:559a703f","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use SikaHyflex®-250 Facade for joints under water pressure or for permanent water immersion.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/8/sikahyflex_-250_facade.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 03.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/expansion-perimeterjoints/sikahyflex-250-facade.html"}},{"id":"sikahyflex-250-facade:prime