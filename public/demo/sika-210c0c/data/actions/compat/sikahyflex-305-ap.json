{"id":"sikahyflex-305-ap","rules":[{"id":"sikahyflex-305-ap:suitability:d96567e6","type":"suitability","polarity":"no","conditional":false,"tags":{"tile_type":["natural_stone"]},"mentions":[],"text":"Do not use SikaHyflex®-305 AP on natural stone.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/v/sikahyflex_-305_ap.pdf","page":3,"page_end":3,"doc_version":"November 2023, Version 03.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/curtain-walling-glazingandweathersealants/sikahyflex-305-ap.html"}},{"id":"sikahyflex-305-ap:restriction:aaa69f9e","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use SikaHyflex®-305 AP on bituminous substrates, natural rubber or any building materials which might bleed oils, plasticizers or solvents that could attack the sealant","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/v/sikahyflex_-305_ap.pdf","page":3,"page_end":3,"doc_version":"November 2023, Version 03.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/curtain-walling-glazingandweathersealants/sikahyflex-305-ap.html"}},{"id":"sikahyflex-305-ap:restriction:feff90f3","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use SikaHyflex®-305 AP on pre-stressed polyacrylate and polycarbonate as it may cause environmental stress cracking (crazing).","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/v/sikahyflex_-305_ap.pdf","page":3,"page_end":3,"doc_version":"November 2023, Version 03.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/curtain-walling-glazingandweathersealants/sikahyflex-305-ap.html"}},{"id":"sikahyflex-305-ap:suitability:b59f68de","type":"suitability","polarity":"no","conditional":false,"tags":{"environment":["submerged"]},"mentions":[],"text":"Do not use SikaHyflex®-305 AP to seal joints in and around swimming pools.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/v/sikahyflex_-305_ap.pdf","page":3,"page_end":3,"doc_version":"November 2023, Version 03.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/curtain-walling-glazingandweathersealants/sikahyflex-305-ap.html"}},{"id":"sikahyflex-305-ap:restriction:acac0c0a","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use SikaHyflex®-305 AP for joints under water pressure or for permanent water immersion.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/v/sikahyflex_-305_ap.pdf","page":3,"page_end":3,"doc_version":"November 2023, Version 03.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/curtain-walling-glazingandweathersealants/sikahyflex-305-ap.html"}},{"id":"sikahyflex-305-ap:primer:1df8936f","type":"primer","polarity":"yes","conditional":false,"tags":{"substrate":["aac","concrete","porous_substrate"]},"mentions":["sika-primer-210","sika-primer-3-n"],"text":"Porous substrates Concrete, aerated concrete and cement based renders, mortars and bricks shall be primed using Sika® Primer-3 N or Sika® Primer-210. For details like application and flash-off times refer to the most recent PDS of the respective pre-treatment product","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/v/sikahyflex_-305_ap.pdf","page":3,"page_end":3,"doc_version":"November 2023, Version 03.03","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/curtain-walling-glazingandweathersealants/sikahyflex-305-ap.html"}}]}