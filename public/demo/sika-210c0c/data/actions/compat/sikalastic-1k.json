{"id":"sikalastic-1k","rules":[{"id":"sikalastic-1k:suitability:49af4e3c","type":"suitability","polarity":"yes","conditional":false,"tags":{"environment":["submerged"]},"mentions":[],"text":"Avoid direct contact with chlorinated water i.e. in swimming pools, by using suitable protection.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/9/sikalastic_-1k.pdf","page":3,"page_end":3,"doc_version":"September 2026, Version 03.02","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/waterproofing/liquid-applied-membranes/mortars-coatings/sikalastic-1k.html"}},{"id":"sikalastic-1k:suitability:a284e0e7","type":"suitability","polarity":"no","conditional":true,"tags":{"environment":["submerged"]},"mentions":[],"text":"It must be applied directly on the fresh first layer and then covered by the second layer of Sikalastic®-1K. Please Note Schonox ST Tape is not suitable for swimming pools","heading":"APPLICATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/9/sikalastic_-1k.pdf","page":4,"page_end":4,"doc_version":"September 2026, Version 03.02","section":"APPLICATION","web_url":"https://aus.sika.com/en/construction/waterproofing/liquid-applied-membranes/mortars-coatings/sikalastic-1k.html"}}]}