{"id":"sikaseal-kitchenandbathroom","rules":[{"id":"sikaseal-kitchenandbathroom:suitability:d31f7a3b","type":"suitability","polarity":"no","conditional":true,"tags":{"substrate":["metal"]},"mentions":[],"text":"*Not for use on all metal substrates i.e. copper. -See Important Considerations below prior to use.","heading":"CHARACTERISTICS / ADVANTAGES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/a/sikaseal_kitchenandbathroom.pdf","page":1,"page_end":1,"doc_version":"April 2023, Version 03.01","section":"CHARACTERISTICS / ADVANTAGES","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/sikaseal-kitchenandbathroom.html"}},{"id":"sikaseal-kitchenandbathroom:suitability:bc757d19","type":"suitability","polarity":"no","conditional":false,"tags":{"tile_type":["natural_stone"]},"mentions":[],"text":"Do not use on natural stone.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/a/sikaseal_kitchenandbathroom.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 03.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/sikaseal-kitchenandbathroom.html"}},{"id":"sikaseal-kitchenandbathroom:restriction:72a71352","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use on bituminous substrates, natural rubber or any building materials which might leach oils, plasticisers or solvents that could degrade the sealant","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/a/sikaseal_kitchenandbathroom.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 03.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/sikaseal-kitchenandbathroom.html"}},{"id":"sikaseal-kitchenandbathroom:suitability:a0375c33","type":"suitability","polarity":"no","conditional":false,"tags":{"environment":["wet_area"]},"mentions":[],"text":"Do not use SikaSeal® Kitchen and Bathroom in areas which are exposed to strong oxidising acids (e.g. nitric acid) and bases.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/a/sikaseal_kitchenandbathroom.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 03.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/sikaseal-kitchenandbathroom.html"}},{"id":"sikaseal-kitchenandbathroom:suitability:9c64d06f","type":"suitability","polarity":"no","conditional":false,"tags":{"environment":["submerged"]},"mentions":[],"text":"Do not use to seal joints in or around swimming pools.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/a/sikaseal_kitchenandbathroom.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 03.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/sikaseal-kitchenandbathroom.html"}},{"id":"sikaseal-kitchenandbathroom:restriction:1b12cc50","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use for joints under water pressure or permanent water immersion.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/a/sikaseal_kitchenandbathroom.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 03.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/sikaseal-kitchenandbathroom.html"}},{"id":"sikaseal-kitchenandbathroom:suitability:55678def","type":"suitability","polarity":"no","conditional":false,"tags":{"environment":["wet_area"]},"mentions":[],"text":"Do not use SikaSeal® Kitchen and Bathroom in totally confined spaces as it requires atmospheric moisture to cure.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/a/sikaseal_kitchenandbathroom.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 03.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/sikaseal-kitchenandbathroom.html"}},{"id":"sikaseal-kitchenandbathroom:restriction:8586c41d","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use for medical or pharmaceutical applications.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/a/sikaseal_kitchenandbathroom.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 03.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/sikaseal-kitchenandbathroom.html"}},{"id":"sikaseal-kitchenandbathroom:primer:9e5b66a6","type":"primer","polarity":"yes","conditional":false,"tags":{"substrate":["aac","concrete","porous_substrate"]},"mentions":["sika-primer-3-n"],"text":"Porous substrates Concrete, aerated concrete and cement based renders, mortars and bricks must be primed using Sika® Primer-3 N. For more details such as application and flash-off times, refer to the most recent Product Data Sheet of the respective pre-treatment product","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/a/sikaseal_kitchenandbathroom.pdf","page":3,"page_end":3,"doc_version":"April 2023, Version 03.01","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/sikaseal-kitchenandbathroom.html"}}]}