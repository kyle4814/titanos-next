{"id":"sikaseal-roof-gutter","rules":[{"id":"sikaseal-roof-gutter:suitability:bc757d19","type":"suitability","polarity":"no","conditional":false,"tags":{"tile_type":["natural_stone"]},"mentions":[],"text":"Do not use on natural stone.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/d/sikaseal_roof_gutter.pdf","page":2,"page_end":2,"doc_version":"June 2023, Version 04.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/roofing-sealantsadhesives/sikaseal-roof-gutter.html"}},{"id":"sikaseal-roof-gutter:restriction:72a71352","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use on bituminous substrates, natural rubber or any building materials which might leach oils, plasticisers or solvents that could degrade the sealant","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/d/sikaseal_roof_gutter.pdf","page":2,"page_end":2,"doc_version":"June 2023, Version 04.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/roofing-sealantsadhesives/sikaseal-roof-gutter.html"}},{"id":"sikaseal-roof-gutter:restriction:c8ad0b95","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use SikaSeal® Roof & Gutter in areas which are exposed to strong oxidising acids (e.g. nitric acid) and bases.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/d/sikaseal_roof_gutter.pdf","page":2,"page_end":2,"doc_version":"June 2023, Version 04.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/roofing-sealantsadhesives/sikaseal-roof-gutter.html"}},{"id":"sikaseal-roof-gutter:suitability:9c64d06f","type":"suitability","polarity":"no","conditional":false,"tags":{"environment":["submerged"]},"mentions":[],"text":"Do not use to seal joints in or around swimming pools.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/d/sikaseal_roof_gutter.pdf","page":2,"page_end":2,"doc_version":"June 2023, Version 04.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/roofing-sealantsadhesives/sikaseal-roof-gutter.html"}},{"id":"sikaseal-roof-gutter:restriction:1b12cc50","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use for joints under water pressure or permanent water immersion.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/d/sikaseal_roof_gutter.pdf","page":2,"page_end":2,"doc_version":"June 2023, Version 04.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/roofing-sealantsadhesives/sikaseal-roof-gutter.html"}},{"id":"sikaseal-roof-gutter:restriction:e0fc69fa","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use SikaSeal® Roof & Gutter in totally confined spaces as it requires atmospheric moisture to cure.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/d/sikaseal_roof_gutter.pdf","page":2,"page_end":2,"doc_version":"June 2023, Version 04.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/roofing-sealantsadhesives/sikaseal-roof-gutter.html"}},{"id":"sikaseal-roof-gutter:restriction:8586c41d","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use for medical or pharmaceutical applications.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/d/sikaseal_roof_gutter.pdf","page":2,"page_end":2,"doc_version":"June 2023, Version 04.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/roofing-sealantsadhesives/sikaseal-roof-gutter.html"}},{"id":"sikaseal-roof-gutter:suitability:94ab2289","type":"suitability","polarity":"no","conditional":false,"tags":{"substrate":["metal"]},"mentions":[],"text":"Not for use on some metal substrates i.e. copper.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/d/sikaseal_roof_gutter.pdf","page":2,"page_end":2,"doc_version":"June 2023, Version 04.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/roofing-sealantsadhesives/sikaseal-roof-gutter.html"}},{"id":"sikaseal-roof-gutter:primer:9e5b66a6","type":"primer","polarity":"yes","conditional":false,"tags":{"substrate":["aac","concrete","porous_substrate"]},"mentions":["sika-primer-3-n"],"text":"Porous substrates Concrete, aerated concrete and cement based renders, mortars and bricks must be primed using Sika® Primer-3 N. For more details such as application and flash-off times, refer to the most recent Product Data Sheet of the respective pre-treatment product","heading":"SUBSTRATE PREPARATION","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/d/sikaseal_roof_gutter.pdf","page":3,"page_end":3,"doc_version":"June 2023, Version 04.01","section":"SUBSTRATE PREPARATION","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/roofing-sealantsadhesives/sikaseal-roof-gutter.html"}}]}