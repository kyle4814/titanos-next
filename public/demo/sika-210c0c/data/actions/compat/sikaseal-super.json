{"id":"sikaseal-super","rules":[{"id":"sikaseal-super:suitability:88b9f59c","type":"suitability","polarity":"yes","conditional":false,"tags":{"environment":["internal"]},"mentions":[],"text":"Suitable for use in kitchens, as well as in most general interior small joint sealing and gap filling applications (with no permanent water immersion)","heading":"USES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/w/sikaseal_super_200.pdf","page":1,"page_end":1,"doc_version":"April 2023, Version 01.03","section":"USES","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/paint-preparation/sikaseal-super.html"}},{"id":"sikaseal-super:restriction:25e594b4","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Limitations For horizontal gaps with little or no movement the maximum thickness should not exceed 15mm.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/w/sikaseal_super_200.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/paint-preparation/sikaseal-super.html"}},{"id":"sikaseal-super:restriction:ede32c67","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Maximum vertical joint/gap and depth should not exceed 5mm.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/w/sikaseal_super_200.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/paint-preparation/sikaseal-super.html"}},{"id":"sikaseal-super:suitability:4842dee1","type":"suitability","polarity":"no","conditional":false,"tags":{"substrate":["metal"]},"mentions":[],"text":"Do not use on easy corroding substrates such as blank steel, iron etc.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/w/sikaseal_super_200.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/paint-preparation/sikaseal-super.html"}},{"id":"sikaseal-super:suitability:97682d25","type":"suitability","polarity":"no","conditional":false,"tags":{"substrate":["glass"]},"mentions":[],"text":"Do not use SikaSeal® Super as glass sealer and in joints with permanent water immersion.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/w/sikaseal_super_200.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/paint-preparation/sikaseal-super.html"}},{"id":"sikaseal-super:restriction:4f7564f7","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use on bituminous substrates, natural rubber, chloropene, EPDM or on building materials which might bleed oils, plastisicers or solvent.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/w/sikaseal_super_200.pdf","page":2,"page_end":2,"doc_version":"April 2023, Version 01.03","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/paint-preparation/sikaseal-super.html"}}]}