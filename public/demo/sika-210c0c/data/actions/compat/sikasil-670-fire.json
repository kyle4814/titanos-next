{"id":"sikasil-670-fire","rules":[{"id":"sikasil-670-fire:suitability:1c9debf5","type":"suitability","polarity":"yes","conditional":false,"tags":{"substrate":["nonporous_substrate"],"environment":["external","internal"]},"mentions":[],"text":"Sikasil®-670 Fire is designed for fire rated movement and connection joints on porous and non-porous substrates for interior and exterior applications.","heading":"USES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sikasil_-670_fire.pdf","page":1,"page_end":1,"doc_version":"January 2026, Version 06.01","section":"USES","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/facade-sealants/sikasil-670-fire.html"}},{"id":"sikasil-670-fire:restriction:d64c9c93","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use Sikasil®-670 Fire on natural, cast and reconstituted stone as plasticiser migration may occur.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sikasil_-670_fire.pdf","page":3,"page_end":3,"doc_version":"January 2026, Version 06.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/facade-sealants/sikasil-670-fire.html"}},{"id":"sikasil-670-fire:restriction:a1f3d359","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use Sikasil®-670 Fire on bituminous substrates, natural rubber, EPDM rubber or on any building materials which might bleed oils, plasticizers or solvents that could degrade the sealant and cause the product to become tacky.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sikasil_-670_fire.pdf","page":3,"page_end":3,"doc_version":"January 2026, Version 06.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/facade-sealants/sikasil-670-fire.html"}},{"id":"sikasil-670-fire:suitability:fb8439a1","type":"suitability","polarity":"no","conditional":false,"tags":{"environment":["submerged"]},"mentions":[],"text":"Do not use Sikasil®-670 Fire to seal joints in and around swimming pools.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sikasil_-670_fire.pdf","page":3,"page_end":3,"doc_version":"January 2026, Version 06.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/facade-sealants/sikasil-670-fire.html"}},{"id":"sikasil-670-fire:restriction:f6b7e407","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use Sikasil®-670 Fire for joints under water pressure or for permanent water immersion.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sikasil_-670_fire.pdf","page":3,"page_end":3,"doc_version":"January 2026, Version 06.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/facade-sealants/sikasil-670-fire.html"}},{"id":"sikasil-670-fire:restriction:88734b08","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use the product in a totally confined space.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sikasil_-670_fire.pdf","page":3,"page_end":3,"doc_version":"January 2026, Version 06.01","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/facade-sealants/sikasil-670-fire.html"}}]}