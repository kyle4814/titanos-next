{"id":"sikasil-702","rules":[{"id":"sikasil-702:suitability:c2d2a214","type":"suitability","polarity":"yes","conditional":false,"tags":{"environment":["wet_area"]},"mentions":[],"text":"Sikasil®-702 All Purpose is suitable for: Kitchens & Bathrooms","heading":"USES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/f/sikasil-702.pdf","page":1,"page_end":1,"doc_version":"September 2025, Version 01.04","section":"USES","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/sikasil-702.html"}},{"id":"sikasil-702:suitability:302110a7","type":"suitability","polarity":"no","conditional":false,"tags":{"tile_type":["natural_stone"]},"mentions":[],"text":"- Not suitable for natural stone, some porous materials and copper","heading":"USES","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/f/sikasil-702.pdf","page":1,"page_end":1,"doc_version":"September 2025, Version 01.04","section":"USES","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/sikasil-702.html"}},{"id":"sikasil-702:suitability:bc757d19","type":"suitability","polarity":"no","conditional":false,"tags":{"tile_type":["natural_stone"]},"mentions":[],"text":"Do not use on natural stone.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/f/sikasil-702.pdf","page":2,"page_end":2,"doc_version":"September 2025, Version 01.04","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/sikasil-702.html"}},{"id":"sikasil-702:restriction:d780bd1e","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use on bituminous substrates, natural rubber or any building materials which might leach oils, plasticisers or solvents that could degrade the sealant.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/f/sikasil-702.pdf","page":2,"page_end":2,"doc_version":"September 2025, Version 01.04","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/sikasil-702.html"}},{"id":"sikasil-702:restriction:570289ff","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use on pre-stressed polyacrylate and polycar- bonate as it may cause environmental stress cracking (crazing)","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/f/sikasil-702.pdf","page":2,"page_end":3,"doc_version":"September 2025, Version 01.04","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/sikasil-702.html"}},{"id":"sikasil-702:restriction:16dd9b90","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use on copper.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/f/sikasil-702.pdf","page":3,"page_end":3,"doc_version":"September 2025, Version 01.04","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/sikasil-702.html"}},{"id":"sikasil-702:restriction:29075821","type":"restriction","polarity":"no","conditional":false,"tags":{},"mentions":[],"text":"Do not use Sikasil®-702 in areas which are exposed to strong oxidising acids (e.g. nitric acid) and bases.","heading":"IMPORTANT CONSIDERATIONS","source":{"doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/f/sikasil-702.pdf","page":3,"page_end":3,"doc_version":"September 2025, Version 01.04","section":"IMPORTANT CONSIDERATIONS","web_url":"https://aus.sika.com/en/construction/sealants-adhesives/sanitary-sealants/sikasil-702.html"}},{"id":"sikasil-702:suitability:ab5ea1d3","type":"suitability","polarity":"no","conditional":