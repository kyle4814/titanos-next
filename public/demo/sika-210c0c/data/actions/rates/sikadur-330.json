],"pot_life":[{"id":"sikadur-330:pot_life:ebd6e831","kind":"pot_life","label":"Pot Life","text":"+10 °C | ~90 minutes (5 kg) | ~90 minutes","parsed":{"model":"time_table_row","at_c":10,"condition":"+10 °C","columns":[{"column":"pot life","min":90,"max":90,"unit":"min","text":"~90 minutes (5 kg)"},{"column":"open time","min":90,"max":90,"unit":"min","text":"~90 minutes"}],"header":["Temperature","Pot life","Open time"]},"source":{"web_url":"https://aus.sika.com/en/construction/structural-strengthening/structural-adhesives/sikadur-330.html","web_section":"Application Information","web_label":"Pot Life","doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/8/sikadur_-330.pdf","page":3,"page_end":3,"doc_version":"May 2023, Version 04.02","doc_date_listed":"30/05/2023"},"conditions":["The pot life begins when the resin and hardener are mixed. It is shorter at high temperatures and longer at low temperatures. The greater the quantity mixed, the shorter the pot life. To obtain longer workability at high temperatures, the mixed adhesive may be divided into portions. Another method is to chill components A+B before mixing them (not below +5 °C)."],"table_header":"Temperature | Pot life | Open time"},{"id":"sikadur-330:pot_life:29b39510","kind":"pot_life","label":"Pot Life","text":"+23 °C | ~60 minutes (5 kg) | ~60 minutes","parsed":{"model":"time_table_row","at_c":23,"condition":"+23 °C","columns":[{"column":"pot life","min":60,"max":60,"unit":"min","text":"~60 minutes (5 kg)"},{"column":"open time","min":60,"max":60,"unit":"min","text":"~60 minutes"}],"header":["Temperature","Pot life","Open time"]},"source":{"web_url":"https://aus.sika.com/en/construction/structural-strengthening/structural-adhesives/sikadur-330.html","web_section":"Application Information","web_label":"Pot Life","doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/8/sikadur_-330.pdf","page":3,"page_end":3,"doc_version":"May 2023, Version 04.02","doc_date_listed":"30/05/2023"},"conditions":["The pot life begins when the resin and hardener are mixed. It is shorter at high temperatures and longer at low temperatures. The greater the quantity mixed, the shorter the pot life. To obtain longer workability at high temperatures, the mixed adhesive may be divided into portions. Another method is to chill components A+B before mixing them (not below +5 °C)."],"table_header":"Temperature | Pot life | Open time"},{"id":"sikadur-330:pot_life:28afeda1","kind":"pot_life","label":"Pot Life","text":"+35 °C | ~30 minutes (5 kg) | ~30 minutes","parsed":{"model":"time_table_row","at_c":35,"condition":"+35 °C","columns":[{"column":"pot life","min":30,"max":30,"unit":"min","text":"~30 minutes (5 kg)"},{"column":"open time","min":30,"max":30,"unit":"min","text":"~30 minutes"}],"header":["Temperature","Pot life","Open time"]},"source":{"web_url":"https://aus.sika.com/en/construction/structural-strengthening/structural-adhesives/sikadur-330.html","web_section":"Application Information","web_label":"Pot Life","doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/8/sikadur_-330.pdf","page":3,"page_end":3,"doc_version":"May 2023, Version 04.02","doc_date_listed":"30/05/2023"},"conditions":["The pot life begins when the resin and hardener are mixed. It is shorter at high temperatures and longer at low temperatures. The greater the quantity mixed, the shorter the pot life. To obtain longer workability at high temperatures, the mixed adhesive may be divided into portions. Another method is to chill components A+B before mixing them (not below +5 °C)."],"table_header":"Temperature | Pot life | Open time"}],"cure_times":[{"id":"sikadur-330:cure_times:89c2f12c","kind":"cure_times","label":"Curing Time","text":"TG 30 days +30 °C +58 °C 7 days +30 °C +60 °C (EN 12614) (ASTM D3418)","parsed":{"model":"durations_listed","at_c":null,"values":[{"min":30,"max":30,"unit":"d","at_c_each":null},{"min":7,"max":7,"unit":"d","at_c_each":null}],"note":"several durations in one statement; the datasheet columns are not labelled in the text, read the phrase"},"source":{"web_url":"https://aus.sika.com/en/construction/structural-strengthening/structural-adhesives/sikadur-330.html","web_section":"PDS Technical Information","web_label":"Curing Time","doc_type":"PDS","url":"https://aus.sika.com/content/dam/dms/au01/8/sikadur_-330.pdf","page":2,"page_end":2,"doc_version":"May 2023, Version 04.02","doc_date_listed":"30/05/2023"},"via":"pds-text"}]}}