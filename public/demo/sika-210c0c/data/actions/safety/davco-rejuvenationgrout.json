"id":"davco-rejuvenationgrout:sds:0a5c7f:handling:3151dad9"},{"label":"Advice on safe handling","text":"Avoid exceeding the given occupational exposure limits (see section 8). For personal protection see section 8. Follow standard hygiene measures when handling chemical products","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sds-davco-rejuvenationgrout.pdf","page":3,"page_end":3,"doc_version":"Revision 15.07.2026, Version 3.0"},"id":"davco-rejuvenationgrout:sds:0a5c7f:handling:870b8bf2"},{"label":"Hygiene measures","text":"Handle in accordance with good industrial hygiene and safety practice. When using do not eat or drink. When using do not smoke. Wash hands before breaks and at the end of workday.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sds-davco-rejuvenationgrout.pdf","page":3,"page_end":3,"doc_version":"Revision 15.07.2026, Version 3.0"},"id":"davco-rejuvenationgrout:sds:0a5c7f:handling:ef026cd3"}],"ppe":{"respiratory":{"label":"Respiratory protection","text":"In case of inadequate ventilation wear respiratory protection. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sds-davco-rejuvenationgrout.pdf","page":4,"page_end":4,"doc_version":"Revision 15.07.2026, Version 3.0"},"id":"davco-rejuvenationgrout:sds:0a5c7f:ppe.respiratory:1228c275"},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber/nitrile rubber gloves. Contaminated gloves should be removed.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sds-davco-rejuvenationgrout.pdf","page":4,"page_end":4,"doc_version":"Revision 15.07.2026, Version 3.0"},"id":"davco-rejuvenationgrout:sds:0a5c7f:ppe.hands:27ef0e7d"},"eyes":{"label":"Eye protection","text":"Safety glasses","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sds-davco-rejuvenationgrout.pdf","page":4,"page_end":4,"doc_version":"Revision 15.07.2026, Version 3.0"},"id":"davco-rejuvenationgrout:sds:0a5c7f:ppe.eyes:03ca7e7f"},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sds-davco-rejuvenationgrout.pdf","page":4,"page_end":4,"doc_version":"Revision 15.07.2026, Version 3.0"},"id":"davco-rejuvenationgrout:sds:0a5c7f:ppe.skin_body:8701f223"},"engineering_controls":{"label":"Appropriate engineering controls","text":"Use adequate ventilation and/or engineering controls to prevent exposure to vapours.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sds-davco-rejuvenationgrout.pdf","page":4,"page_end":4,"doc_version":"Revision 15.07.2026, Version 3.0"},"id":"davco-rejuvenationgrout:sds:0a5c7f:ppe.engineering_controls:b525b6f3"}},"transport_adg":{"un_number":"UN 3082","class":"9 Packing","text":"UN number : UN 3082","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/6/sds-davco-rejuvenationgrout.pdf","page":8,"page_end":8,"doc_version":"Revision 15.07.2026, Version 3.0"},"id":"davco-rejuvenationgrout:sds:0a5c7f:transport_adg:8c70cce7"},"latest_for_name":true,"name_matches_product":true}]}