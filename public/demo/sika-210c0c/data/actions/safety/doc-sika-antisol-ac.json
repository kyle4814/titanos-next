ersion":"Revision 26.06.2025, Version 3.0"},"id":"doc-sika-antisol-ac:sds:c0d7cc:hazard_statements:5f4d93b1"}],"precautionary_statements":[{"group":"Prevention","code":"P261","statement":"Avoid breathing mist or vapours.","text":"P261 Avoid breathing mist or vapours.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/5a78282c-04f7-42fb-aced-4a0fac14017d/MSDS%20Sika%20Antisol%20AC%20GHS7.pdf","page":1,"page_end":1,"doc_version":"Revision 26.06.2025, Version 3.0"},"id":"doc-sika-antisol-ac:sds:c0d7cc:precautionary_statements:7895cfea"},{"group":"Prevention","code":"P264","statement":"Wash skin thoroughly after handling.","text":"P264 Wash skin thoroughly after handling.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/5a78282c-04f7-42fb-aced-4a0fac14017d/MSDS%20Sika%20Antisol%20AC%20GHS7.pdf","page":1,"page_end":1,"doc_version":"Revision 26.06.2025, Version 3.0"},"id":"doc-sika-antisol-ac:sds:c0d7cc:precautionary_statements:5d1a9355"},{"group":"Prevention","code":"P271","statement":"Use only outdoors or in a well-ventilated area.","text":"P271 Use only outdoors or in a well-ventilated area.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/5a78282c-04f7-42fb-aced-4a0fac14017d/MSDS%20Sika%20Antisol%20AC%20GHS7.pdf","page":1,"page_end":1,"doc_version":"Revision 26.06.2025, Version 3.0"},"id":"doc-sika-antisol-ac:sds:c0d7cc:precautionary_statements:057fa8f6"},{"group":"Prevention","code":"P272","statement":"Contaminated work clothing should not be allowed out of the workplace.","text":"P272 Contaminated work clothing should not be allowed out of the workplace.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/5a78282c-04f7-42fb-aced-4a0fac14017d/MSDS%20Sika%20Antisol%20AC%20GHS7.pdf","page":2,"page_end":2,"doc_version":"Revision 26.06.2025, Version 3.0"},"id":"doc-sika-antisol-ac:sds:c0d7cc:precautionary_statements:2222e81e"},{"group":"Prevention","code":"P273","statement":"Avoid release to the environment.","text":"P273 Avoid release to the environment.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/5a78282c-04f7-42fb-aced-4a0fac14017d/MSDS%20Sika%20Antisol%20AC%20GHS7.pdf","page":2,"page_end":2,"doc_version":"Revision 26.06.2025, Version 3.0"},"id":"doc-sika-antisol-ac:sds:c0d7cc:precautionary_statements:967777c8"},{"group":"Prevention","code":"P280","statement":"Wear protective gloves.","text":"P280 Wear protective gloves.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/5a78282c-04f7-42fb-aced-4a0fac14017d/MSDS%20Sika%20Antisol%20AC%20GHS7.pdf","page":2,"page_end":2,"doc_version":"Revision 26.06.2025, Version 3.0"},"id":"doc-sika-antisol-ac:sds:c0d7cc:precautionary_statements:87630ec7"},{"group":"Response","code":"P302 + P352","statement":"IF ON SKIN: Wash with plenty of water.","text":"P302 + P352 IF ON SKIN: Wash with plenty of water.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/5a78282c-04f7-42fb-aced-4a0fac14017d/MSDS%20Sika%20Antisol%20AC%20GHS7.pdf","page":2,"page_end":2,"doc_version":"Revision 26.06.2025, Version 3.0"},"id":"doc-sika-antisol-ac:sds:c0d7cc:precautionary_statements:153d8276"},{"group":"Response","code":"P304 + P340 + P312","statement":"IF INHALED: Remove person to fresh air and keep comfortable for breathing. Call a POISON CENTER/ doctor if you feel unwell.","text":"P304 + P340 + P312 IF INHALED: Remove person to fresh air and keep comfortable for breathing. Call a POISON CENTER/ doctor if you feel unwell.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/5a78282c-04f7-42fb-aced-4a0fac14017d/MSDS%20Sika%20Antisol%20AC%20GHS7.pdf","page":2,"page_end":2,"doc_version":"Revision 26.06.2025, Version 3.0"},"id":"doc-sika-antisol-ac:sds:c0d7cc:precautionary_statements:dd2d7689"},{"group":"Response","code":"P333 + P313","statement":"If skin irritation or rash occurs: Get medical advice/ attention.","text":"P333 + P313 If skin irritation or rash occurs: Get medical advice/ attention.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/5a78282c-04f7-42fb-aced-4a0fac14017d/MSDS%20Sika%20Antisol%20AC%20GHS7.pdf","page":2,"page_end":2,"doc_version":"Revision 26.06.2025, Version 3.0"},"id":"doc-sika-antisol-ac:sds:c0d7cc:precautionary_statements:0c2e03d6"},{"group":"Response","code":"P362 + P364","statement":"Take off contaminated clothing and wash it before reuse.","text":"P362 + P364 Take off contaminated clothing and wash it before reuse.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/5a78282c-04f7-42fb-aced-4a0fac14017d/MSDS%20Sika%20Antisol%20AC%20GHS7.pdf","page":2,"page_end":2,"doc_version":"Revision 26.06.2025, Version 3.0"},"id":"doc-sika-antisol-ac:sds:c0d7cc:precautionary_statements:4732b4f8"},{"group":"Storage","code":"P403 + P233","statement":"Store in a well-ventilated place. Keep container tightly closed.","text":"P403 + P233 Store in a well-ventilated place. Keep container tightly closed.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/5a78282c-04f7-42fb-aced-4a0fac14017d/MSDS%20Sika%20Antisol%20AC%20GHS7.pdf","page":2,"page_end":2,"doc_version":"Revision 26.06.2025, Version 3.0"},"id":"doc-sika-antisol-ac:sds:c0d7cc:precautionary_statements:6778a0d7"},{"group":"Storage","code":"P405","statement":"Store locked up.","text":"P405 Store locked up.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/5a78282c-04f7-42fb-aced-4a0fac14017d/MSDS%20Sika%20Antisol%20AC%20GHS7.pdf","page":2,"page_end":2,"doc_version":"Revision 26.06.2025, Version 3.0"},"id":"doc-sika-antisol-ac:sds:c0d7cc:precautionary_statements:f2d90307"},{"group":"Disposal","code":"P501","statement":"Dispose of contents/ container to an approved waste disposal plant.","text":"P501 Dispose of contents/ container to an approved waste disposal plant.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/5a78282c-04f7-42fb-aced-4a0fac14017d/MSDS%20Sika%20Antisol%20AC%20GHS7.pdf","page":2,"page_end":2,"doc_version":"Revision 26.06.2025, Version 3.0"},"id":"doc-sika-antisol-ac:sds:c0d7cc:precautionary_statements:bc03aec3"}],"storage":[{"label":"Conditions for safe storage","text":"Store in original container. Keep in a well-ventilated place. Containers which are opened must be carefully resealed and kept upright to prevent leakage. Observe label precautions. Store in accordance with local regulations.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/5a78282c-04f7-42fb-aced-4a0fac14017d/MSDS%20Sika%20Antisol%20AC%20GHS7.pdf","page":4,"page_end":4,"doc_version":"Revision 26.06.2025, Version 3.0"},"id":"doc-sika-antisol-ac:sds:c0d7cc:storage:90ce497a"}],"handling":[{"label":"Advice on protection against fire and explosion","text":"Normal measures for preventive fire protection.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/5a78282c-04f7-42fb-aced-4a0fac14017d/MSDS%20Sika%20Antisol%20AC%20GHS7.pdf","page":4,"page_end":4,"doc_version":"Revision 26.06.2025, Version 3.0"},"id":"doc-sika-antisol-ac:sds:c0d7cc:handling:3151dad9"},{"label":"Advice on safe handling","text":"Avoid exceeding the given occupational exposure limits (see section 8). Do not get in eyes, on skin, or on clothing. For personal protection see section 8. Persons with a history of skin sensitisation problems or asthma, allergies, chronic or recurrent respiratory disease should not be employed in any process in which this mixture is being used. Smoking, eating and drinking should be prohibited in the application area. Follow standard hygiene measures when handling chemical products","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/5a78282c-04f7-42fb-aced-4a0fac14017d/MSDS%20Sika%20Antisol%20AC%20GHS7.pdf","page":4,"page_end":4,"doc_version":"Revision 26.06.2025, Version 3.0"},"id":"doc-sika-antisol-ac:sds:c0d7cc:handling:de03b4b8"},{"label":"Hygiene measures","text":"Handle in accordance with good industrial hygiene and safety practice. When using do not eat or drink. When using do not smoke. Wash hands before breaks and at the end of workday.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/5a78282c-04f7-42fb-aced-4a0fac14017d/MSDS%20Sika%20Antisol%20AC%20GHS7.pdf","page":4,"page_end":4,"doc_version":"Revision 26.06.2025, Version 3.0"},"id":"doc-sika-antisol-ac:sds:c0d7cc:handling:ef026cd3"}],"ppe":{"respiratory":{"label":"Respiratory protection","text":"In case of inadequate ventilation wear respiratory protection. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/5a78282c-04f7-42fb-aced-4a0fac14017d/MSDS%20Sika%20Antisol%20AC%20GHS7.pdf","page":4,"page_end":5,"doc_version":"Revision 26.06.2025, Version 3.0"},"id":"doc-sika-antisol-ac:sds:c0d7cc:ppe.respiratory:1228c275"},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber/nitrile rubber gloves. Contaminated gloves should be removed.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/5a78282c-04f7-42fb-aced-4a0fac14017d/MSDS%20Sika%20Antisol%20AC%20GHS7.pdf","page":5,"page_end":5,"doc_version":"Revision 26.06.2025, Version 3.0"},"id":"doc-sika-antisol-ac:sds:c0d7cc:ppe.hands:27ef0e7d"},"eyes":{"label":"Eye protection","text":"Safety glasses","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/5a78282c-04f7-42fb-aced-4a0fac14017d/MSDS%20Sika%20Antisol%20AC%20GHS7.pdf","page":5,"page_end":5,"doc_version":"Revision 26.06.2025, Version 3.0"},"id":"doc-sika-antisol-ac:sds:c0d7cc:ppe.eyes:03ca7e7f"},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/5a78282c-04f7-42fb-aced-4a0fac14017d/MSDS%20Sika%20Antisol%20AC%20GHS7.pdf","page":5,"page_end":5,"doc_version":"Revision 26.06.2025, Version 3.0"},"id":"doc-sika-antisol-ac:sds:c0d7cc:ppe.skin_body:8701f223"},"engineering_controls":{"label":"Appropriate engineering controls","text":"Use adequate ventilation and/or engineering controls to prevent exposure to vapours.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/5a78282c-04f7-42fb-aced-4a0fac14017d/MSDS%20Sika%20Antisol%20AC%20GHS7.pdf","page":4,"page_end":4,"doc_version":"Revision 26.06.2025, Version 3.0"},"id":"doc-sika-antisol-ac:sds:c0d7cc:ppe.engineering_controls:b525b6f3"}},"transport_adg":{"un_number":"Not applicable","class":"Not applicable","text":"UN number : Not applicable","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/5a78282c-04f7-42fb-aced-4a0fac14017d/MSDS%20Sika%20Antisol%20AC%20GHS7.pdf","page":9,"page_end":9,"doc_version":"Revision 26.06.2025, Version 3.0"},"id":"doc-sika-antisol-ac:sds:c0d7cc:transport_adg:24d6694d"},"latest_for_name":true,"name_matches_product":true}]}