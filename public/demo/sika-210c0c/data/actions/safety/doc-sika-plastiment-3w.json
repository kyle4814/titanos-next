d":1,"doc_version":"Revision 11.12.2025, Version 3.0"},"id":"doc-sika-plastiment-3w:sds:9cd485:precautionary_statements:5d1a9355"},{"group":"Prevention","code":"P270","statement":"Do not eat, drink or smoke when using this product.","text":"P270 Do not eat, drink or smoke when using this product.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/11c60230-4555-4d83-a3c7-6fb657d4c017_au01/sds-sika-plastiment-3w.pdf","page":1,"page_end":1,"doc_version":"Revision 11.12.2025, Version 3.0"},"id":"doc-sika-plastiment-3w:sds:9cd485:precautionary_statements:702446ec"},{"group":"Prevention","code":"P273","statement":"Avoid release to the environment.","text":"P273 Avoid release to the environment.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/11c60230-4555-4d83-a3c7-6fb657d4c017_au01/sds-sika-plastiment-3w.pdf","page":1,"page_end":1,"doc_version":"Revision 11.12.2025, Version 3.0"},"id":"doc-sika-plastiment-3w:sds:9cd485:precautionary_statements:967777c8"},{"group":"Prevention","code":"P280","statement":"Wear eye protection/ face protection.","text":"P280 Wear eye protection/ face protection.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/11c60230-4555-4d83-a3c7-6fb657d4c017_au01/sds-sika-plastiment-3w.pdf","page":1,"page_end":1,"doc_version":"Revision 11.12.2025, Version 3.0"},"id":"doc-sika-plastiment-3w:sds:9cd485:precautionary_statements:23ef5ea3"},{"group":"Response","code":"P301 + P312 + P330","statement":"IF SWALLOWED: Call a POISON CENTER/ doctor if you feel unwell. Rinse mouth.","text":"P301 + P312 + P330 IF SWALLOWED: Call a POISON CENTER/ doctor if you feel unwell. Rinse mouth.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/11c60230-4555-4d83-a3c7-6fb657d4c017_au01/sds-sika-plastiment-3w.pdf","page":2,"page_end":2,"doc_version":"Revision 11.12.2025, Version 3.0"},"id":"doc-sika-plastiment-3w:sds:9cd485:precautionary_statements:7a934780"},{"group":"Response","code":"P305 + P351 + P338 + P310","statement":"IF IN EYES: Rinse cautiously with water for several minutes. Remove contact lenses, if present and easy to do. Continue rinsing. Immediately call a POISON CENTER/ doctor.","text":"P305 + P351 + P338 + P310 IF IN EYES: Rinse cautiously with water for several minutes. Remove contact lenses, if present and easy to do. Continue rinsing. Immediately call a POISON CENTER/ doctor.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/11c60230-4555-4d83-a3c7-6fb657d4c017_au01/sds-sika-plastiment-3w.pdf","page":2,"page_end":2,"doc_version":"Revision 11.12.2025, Version 3.0"},"id":"doc-sika-plastiment-3w:sds:9cd485:precautionary_statements:ecd5dbac"},{"group":"Disposal","code":"P501","statement":"Dispose of contents/ container to an approved waste disposal plant.","text":"P501 Dispose of contents/ container to an approved waste disposal plant.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/11c60230-4555-4d83-a3c7-6fb657d4c017_au01/sds-sika-plastiment-3w.pdf","page":2,"page_end":2,"doc_version":"Revision 11.12.2025, Version 3.0"},"id":"doc-sika-plastiment-3w:sds:9cd485:precautionary_statements:bc03aec3"}],"storage":[{"label":"Conditions for safe storage","text":"Keep container tightly closed in a dry and well-ventilated place. Containers which are opened must be carefully resealed and kept upright to prevent leakage. Store in accordance with local regulations.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/11c60230-4555-4d83-a3c7-6fb657d4c017_au01/sds-sika-plastiment-3w.pdf","page":4,"page_end":4,"doc_version":"Revision 11.12.2025, Version 3.0"},"id":"doc-sika-plastiment-3w:sds:9cd485:storage:6defd744"}],"handling":[{"label":"Advice on protection against fire and explosion","text":"Normal measures for preventive fire protection.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/11c60230-4555-4d83-a3c7-6fb657d4c017_au01/sds-sika-plastiment-3w.pdf","page":3,"page_end":3,"doc_version":"Revision 11.12.2025, Version 3.0"},"id":"doc-sika-plastiment-3w:sds:9cd485:handling:3151dad9"},{"label":"Advice on safe handling","text":"Avoid exceeding the given occupational exposure limits (see section 8). Do not get in eyes, on skin, or on clothing. For personal protection see section 8. Smoking, eating and drinking should be prohibited in the application area. Follow standard hygiene measures when handling chemical products","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/11c60230-4555-4d83-a3c7-6fb657d4c017_au01/sds-sika-plastiment-3w.pdf","page":3,"page_end":4,"doc_version":"Revision 11.12.2025, Version 3.0"},"id":"doc-sika-plastiment-3w:sds:9cd485:handling:424f7fe5"},{"label":"Hygiene measures","text":"Handle in accordance with good industrial hygiene and safety practice. When using do not eat or drink. When using do not smoke. Wash hands before breaks and at the end of workday.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/11c60230-4555-4d83-a3c7-6fb657d4c017_au01/sds-sika-plastiment-3w.pdf","page":4,"page_end":4,"doc_version":"Revision 11.12.2025, Version 3.0"},"id":"doc-sika-plastiment-3w:sds:9cd485:handling:ef026cd3"}],"ppe":{"respiratory":{"label":"Respiratory protection","text":"In case of inadequate ventilation wear respiratory protection. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/11c60230-4555-4d83-a3c7-6fb657d4c017_au01/sds-sika-plastiment-3w.pdf","page":4,"page_end":4,"doc_version":"Revision 11.12.2025, Version 3.0"},"id":"doc-sika-plastiment-3w:sds:9cd485:ppe.respiratory:1228c275"},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber/nitrile rubber gloves. Contaminated gloves should be removed.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/11c60230-4555-4d83-a3c7-6fb657d4c017_au01/sds-sika-plastiment-3w.pdf","page":4,"page_end":4,"doc_version":"Revision 11.12.2025, Version 3.0"},"id":"doc-sika-plastiment-3w:sds:9cd485:ppe.hands:27ef0e7d"},"eyes":{"label":"Eye protection","text":"Safety glasses","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/11c60230-4555-4d83-a3c7-6fb657d4c017_au01/sds-sika-plastiment-3w.pdf","page":4,"page_end":4,"doc_version":"Revision 11.12.2025, Version 3.0"},"id":"doc-sika-plastiment-3w:sds:9cd485:ppe.eyes:03ca7e7f"},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/11c60230-4555-4d83-a3c7-6fb657d4c017_au01/sds-sika-plastiment-3w.pdf","page":4,"page_end":4,"doc_version":"Revision 11.12.2025, Version 3.0"},"id":"doc-sika-plastiment-3w:sds:9cd485:ppe.skin_body:8701f223"},"engineering_controls":{"label":"Appropriate engineering controls","text":"Use adequate ventilation and/or engineering controls to prevent exposure to vapours.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/11c60230-4555-4d83-a3c7-6fb657d4c017_au01/sds-sika-plastiment-3w.pdf","page":4,"page_end":4,"doc_version":"Revision 11.12.2025, Version 3.0"},"id":"doc-sika-plastiment-3w:sds:9cd485:ppe.engineering_controls:b525b6f3"}},"transport_adg":{"un_number":"Not applicable","class":"Not applicable","text":"UN number : Not applicable","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/11c60230-4555-4d83-a3c7-6fb657d4c017_au01/sds-sika-plastiment-3w.pdf","page":8,"page_end":8,"doc_version":"Revision 11.12.2025, Version 3.0"},"id":"doc-sika-plastiment-3w:sds:9cd485:transport_adg:24d6694d"},"latest_for_name":true,"name_matches_product":true}]}