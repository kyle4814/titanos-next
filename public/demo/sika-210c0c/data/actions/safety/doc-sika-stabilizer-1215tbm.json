":1,"doc_version":"Revision 19.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1215tbm:sds:05140f:hazard_statements:0bafcf6b"},{"code":"H402","statement":"Harmful to aquatic life.","text":"H402 Harmful to aquatic life.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/566375d5-e5d8-4500-9611-1bf17c842ebc_au01/sds-sika-stabilizer-1215tbm.pdf","page":1,"page_end":1,"doc_version":"Revision 19.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1215tbm:sds:05140f:hazard_statements:5f4d93b1"}],"precautionary_statements":[{"group":"Prevention","code":"P264","statement":"Wash skin thoroughly after handling.","text":"P264 Wash skin thoroughly after handling.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/566375d5-e5d8-4500-9611-1bf17c842ebc_au01/sds-sika-stabilizer-1215tbm.pdf","page":1,"page_end":1,"doc_version":"Revision 19.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1215tbm:sds:05140f:precautionary_statements:5d1a9355"},{"group":"Prevention","code":"P273","statement":"Avoid release to the environment.","text":"P273 Avoid release to the environment.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/566375d5-e5d8-4500-9611-1bf17c842ebc_au01/sds-sika-stabilizer-1215tbm.pdf","page":1,"page_end":1,"doc_version":"Revision 19.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1215tbm:sds:05140f:precautionary_statements:967777c8"},{"group":"Prevention","code":"P280","statement":"Wear eye protection/ face protection.","text":"P280 Wear eye protection/ face protection.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/566375d5-e5d8-4500-9611-1bf17c842ebc_au01/sds-sika-stabilizer-1215tbm.pdf","page":1,"page_end":1,"doc_version":"Revision 19.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1215tbm:sds:05140f:precautionary_statements:23ef5ea3"},{"group":"Response","code":"P305 + P351 + P338","statement":"IF IN EYES: Rinse cautiously with water for several minutes. Remove contact lenses, if present and easy to do. Continue rinsing.","text":"P305 + P351 + P338 IF IN EYES: Rinse cautiously with water for several minutes. Remove contact lenses, if present and easy to do. Continue rinsing.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/566375d5-e5d8-4500-9611-1bf17c842ebc_au01/sds-sika-stabilizer-1215tbm.pdf","page":1,"page_end":1,"doc_version":"Revision 19.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1215tbm:sds:05140f:precautionary_statements:063cfb57"},{"group":"Response","code":"P337 + P313","statement":"If eye irritation persists: Get medical advice/ attention.","text":"P337 + P313 If eye irritation persists: Get medical advice/ attention.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/566375d5-e5d8-4500-9611-1bf17c842ebc_au01/sds-sika-stabilizer-1215tbm.pdf","page":1,"page_end":1,"doc_version":"Revision 19.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1215tbm:sds:05140f:precautionary_statements:3c696809"},{"group":"Disposal","code":"P501","statement":"Dispose of contents/ container to an approved waste disposal plant.","text":"P501 Dispose of contents/ container to an approved waste disposal plant.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/566375d5-e5d8-4500-9611-1bf17c842ebc_au01/sds-sika-stabilizer-1215tbm.pdf","page":1,"page_end":1,"doc_version":"Revision 19.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1215tbm:sds:05140f:precautionary_statements:bc03aec3"}],"storage":[{"label":"Conditions for safe storage","text":"Keep container tightly closed in a dry and well-ventilated place. Containers which are opened must be carefully resealed and kept upright to prevent leakage. Store in accordance with local regulations.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/566375d5-e5d8-4500-9611-1bf17c842ebc_au01/sds-sika-stabilizer-1215tbm.pdf","page":3,"page_end":3,"doc_version":"Revision 19.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1215tbm:sds:05140f:storage:6defd744"}],"handling":[{"label":"Advice on protection against fire and explosion","text":"Normal measures for preventive fire protection.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/566375d5-e5d8-4500-9611-1bf17c842ebc_au01/sds-sika-stabilizer-1215tbm.pdf","page":3,"page_end":3,"doc_version":"Revision 19.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1215tbm:sds:05140f:handling:3151dad9"},{"label":"Advice on safe handling","text":"Avoid exceeding the given occupational exposure limits (see section 8). Do not get in eyes, on skin, or on clothing. For personal protection see section 8. Smoking, eating and drinking should be prohibited in the application area. Follow standard hygiene measures when handling chemical products","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/566375d5-e5d8-4500-9611-1bf17c842ebc_au01/sds-sika-stabilizer-1215tbm.pdf","page":3,"page_end":3,"doc_version":"Revision 19.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1215tbm:sds:05140f:handling:424f7fe5"},{"label":"Hygiene measures","text":"Handle in accordance with good industrial hygiene and safety practice. When using do not eat or drink. When using do not smoke. Wash hands before breaks and at the end of workday.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/566375d5-e5d8-4500-9611-1bf17c842ebc_au01/sds-sika-stabilizer-1215tbm.pdf","page":3,"page_end":3,"doc_version":"Revision 19.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1215tbm:sds:05140f:handling:ef026cd3"}],"ppe":{"respiratory":{"label":"Respiratory protection","text":"No special measures required. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/566375d5-e5d8-4500-9611-1bf17c842ebc_au01/sds-sika-stabilizer-1215tbm.pdf","page":4,"page_end":4,"doc_version":"Revision 19.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1215tbm:sds:05140f:ppe.respiratory:9e406749"},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber/nitrile rubber gloves. Contaminated gloves should be removed.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/566375d5-e5d8-4500-9611-1bf17c842ebc_au01/sds-sika-stabilizer-1215tbm.pdf","page":4,"page_end":4,"doc_version":"Revision 19.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1215tbm:sds:05140f:ppe.hands:27ef0e7d"},"eyes":{"label":"Eye protection","text":"Safety glasses","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/566375d5-e5d8-4500-9611-1bf17c842ebc_au01/sds-sika-stabilizer-1215tbm.pdf","page":4,"page_end":4,"doc_version":"Revision 19.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1215tbm:sds:05140f:ppe.eyes:03ca7e7f"},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/566375d5-e5d8-4500-9611-1bf17c842ebc_au01/sds-sika-stabilizer-1215tbm.pdf","page":4,"page_end":4,"doc_version":"Revision 19.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1215tbm:sds:05140f:ppe.skin_body:8701f223"},"engineering_controls":{"label":"Appropriate engineering controls","text":"Use adequate ventilation and/or engineering controls to prevent exposure to vapours.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/566375d5-e5d8-4500-9611-1bf17c842ebc_au01/sds-sika-stabilizer-1215tbm.pdf","page":3,"page_end":3,"doc_version":"Revision 19.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1215tbm:sds:05140f:ppe.engineering_controls:b525b6f3"}},"transport_adg":{"un_number":"Not applicable","class":"Not applicable","text":"UN number : Not applicable","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/566375d5-e5d8-4500-9611-1bf17c842ebc_au01/sds-sika-stabilizer-1215tbm.pdf","page":7,"page_end":7,"doc_version":"Revision 19.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1215tbm:sds:05140f:transport_adg:24d6694d"},"latest_for_name":true,"name_matches_product":true},{"title":"Sika® Stabilizer-1215 TBM","url":"https://aus.sika.com/dms/getdocument.get/0e57b6ab-65ee-4aa0-ae75-97c7ae9280e8_au01/sds-sika-stabilizer-1215tbm.pdf","revision_date":"12.06.2025","version":"1.0","sds_number":"100000066360","pages":10,"sha256":"da6e0bcd5eb47bd9f5b0e72a24052ea2e0c6795ed75ddf2244cfaeabfc54fe7d","product_name_on_sds":"Sika® Stabilizer-1215 TBM","component":null,"revision_age_years":1.4,"older_than_3_years":false,"classification":[{"hazard_class":"Skin corrosion/irritation","category":"Category 1","text":"Skin corrosion/irritation : Category 1","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/0e57b6ab-65ee-4aa0-ae75-97c7ae9280e8_au01/sds-sika-stabilizer-1215tbm.pdf","page":1,"page_end":1,"doc_version":"Revision 12.06.2025, Version 1.0"},"id":"doc-sika-stabilizer-1215tbm:sds:ac1d0f:classification:28fb1eda"},{"hazard_class":"Serious eye damage/eye irritation","category":"Category 1","text":"Serious eye damage/eye irritation : Category 1","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/0e57b6ab-65ee-4aa0-ae75-97c7ae9280e8_au01/sds-sika-stabilizer-1215tbm.pdf","page":1,"page_end":1,"doc_version":"Revision 12.06.2025, Version 1.0"},"id":"doc-sika-stabilizer-1215tbm:sds:ac1d0f:classification:08d28e3c"},{"hazard_class":"Short-term (acute) aquatic hazard","category":"Category 2","text":"Short-term (acute) aquatic hazard : Category 2","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/0e57b6ab