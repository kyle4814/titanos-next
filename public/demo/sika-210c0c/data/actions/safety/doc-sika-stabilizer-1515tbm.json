280 Wear protective gloves/ protective clothing/ eye protection/ face protection/ hearing protection.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/eb850cba-8a29-4347-857a-e5a4956be421_au01/sds-sika-stabilizer-1515tbm.pdf","page":1,"page_end":1,"doc_version":"Revision 24.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1515tbm:sds:f4879b:precautionary_statements:15fc2146"},{"group":"Response","code":"P301 + P330 + P331","statement":"IF SWALLOWED: Rinse mouth. Do NOT induce vomiting.","text":"P301 + P330 + P331 IF SWALLOWED: Rinse mouth. Do NOT induce vomiting.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/eb850cba-8a29-4347-857a-e5a4956be421_au01/sds-sika-stabilizer-1515tbm.pdf","page":1,"page_end":1,"doc_version":"Revision 24.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1515tbm:sds:f4879b:precautionary_statements:c562ee2e"},{"group":"Response","code":"P303 + P361 + P353","statement":"IF ON SKIN (or hair): Take off immediately all contaminated clothing. Rinse skin with water.","text":"P303 + P361 + P353 IF ON SKIN (or hair): Take off immediately all contaminated clothing. Rinse skin with water.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/eb850cba-8a29-4347-857a-e5a4956be421_au01/sds-sika-stabilizer-1515tbm.pdf","page":1,"page_end":1,"doc_version":"Revision 24.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1515tbm:sds:f4879b:precautionary_statements:cafd7b96"},{"group":"Response","code":"P304 + P340 + P310","statement":"IF INHALED: Remove person to fresh air and keep comfortable for breathing. Immediately call a POISON CENTER/ doctor.","text":"P304 + P340 + P310 IF INHALED: Remove person to fresh air and keep comfortable for breathing. Immediately call a POISON CENTER/ doctor.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/eb850cba-8a29-4347-857a-e5a4956be421_au01/sds-sika-stabilizer-1515tbm.pdf","page":1,"page_end":1,"doc_version":"Revision 24.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1515tbm:sds:f4879b:precautionary_statements:35330b32"},{"group":"Response","code":"P305 + P351 + P338 + P310","statement":"IF IN EYES: Rinse cautiously with water for several minutes. Remove contact lenses, if present and easy to do. Continue rinsing. Immediately call a POISON CENTER/ doctor.","text":"P305 + P351 + P338 + P310 IF IN EYES: Rinse cautiously with water for several minutes. Remove contact lenses, if present and easy to do. Continue rinsing. Immediately call a POISON CENTER/ doctor.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/eb850cba-8a29-4347-857a-e5a4956be421_au01/sds-sika-stabilizer-1515tbm.pdf","page":1,"page_end":2,"doc_version":"Revision 24.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1515tbm:sds:f4879b:precautionary_statements:ecd5dbac"},{"group":"Response","code":"P363","statement":"Wash contaminated clothing before reuse.","text":"P363 Wash contaminated clothing before reuse.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/eb850cba-8a29-4347-857a-e5a4956be421_au01/sds-sika-stabilizer-1515tbm.pdf","page":2,"page_end":2,"doc_version":"Revision 24.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1515tbm:sds:f4879b:precautionary_statements:4222d290"},{"group":"Disposal","code":"P501","statement":"Dispose of contents/ container to an approved waste disposal plant.","text":"P501 Dispose of contents/ container to an approved waste disposal plant.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/eb850cba-8a29-4347-857a-e5a4956be421_au01/sds-sika-stabilizer-1515tbm.pdf","page":2,"page_end":2,"doc_version":"Revision 24.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1515tbm:sds:f4879b:precautionary_statements:bc03aec3"}],"storage":[{"label":"Conditions for safe storage","text":"Store in original container. Keep container tightly closed in a dry and well-ventilated place. Containers which are opened must be carefully resealed and kept upright to prevent leakage. Observe label precautions. Store in accordance with local regulations.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/eb850cba-8a29-4347-857a-e5a4956be421_au01/sds-sika-stabilizer-1515tbm.pdf","page":4,"page_end":4,"doc_version":"Revision 24.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1515tbm:sds:f4879b:storage:d5446d2a"}],"handling":[{"label":"Advice on protection against fire and explosion","text":"Normal measures for preventive fire protection.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/eb850cba-8a29-4347-857a-e5a4956be421_au01/sds-sika-stabilizer-1515tbm.pdf","page":3,"page_end":3,"doc_version":"Revision 24.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1515tbm:sds:f4879b:handling:3151dad9"},{"label":"Advice on safe handling","text":"Avoid exceeding the given occupational exposure limits (see section 8). Do not get in eyes, on skin, or on clothing. For personal protection see section 8. Smoking, eating and drinking should be prohibited in the application area. Follow standard hygiene measures when handling chemical products","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/eb850cba-8a29-4347-857a-e5a4956be421_au01/sds-sika-stabilizer-1515tbm.pdf","page":3,"page_end":3,"doc_version":"Revision 24.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1515tbm:sds:f4879b:handling:424f7fe5"},{"label":"Hygiene measures","text":"Handle in accordance with good industrial hygiene and safety practice. When using do not eat or drink. When using do not smoke. Wash hands before breaks and at the end of workday.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/eb850cba-8a29-4347-857a-e5a4956be421_au01/sds-sika-stabilizer-1515tbm.pdf","page":3,"page_end":4,"doc_version":"Revision 24.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1515tbm:sds:f4879b:handling:ef026cd3"}],"ppe":{"respiratory":{"label":"Respiratory protection","text":"No special measures required. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/eb850cba-8a29-4347-857a-e5a4956be421_au01/sds-sika-stabilizer-1515tbm.pdf","page":4,"page_end":4,"doc_version":"Revision 24.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1515tbm:sds:f4879b:ppe.respiratory:9e406749"},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber/nitrile rubber gloves. Contaminated gloves should be removed.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/eb850cba-8a29-4347-857a-e5a4956be421_au01/sds-sika-stabilizer-1515tbm.pdf","page":4,"page_end":4,"doc_version":"Revision 24.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1515tbm:sds:f4879b:ppe.hands:27ef0e7d"},"eyes":{"label":"Eye protection","text":"Safety glasses","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/eb850cba-8a29-4347-857a-e5a4956be421_au01/sds-sika-stabilizer-1515tbm.pdf","page":4,"page_end":4,"doc_version":"Revision 24.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1515tbm:sds:f4879b:ppe.eyes:03ca7e7f"},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3 Rubber aprons","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/eb850cba-8a29-4347-857a-e5a4956be421_au01/sds-sika-stabilizer-1515tbm.pdf","page":4,"page_end":4,"doc_version":"Revision 24.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1515tbm:sds:f4879b:ppe.skin_body:c2cdd16e"},"engineering_controls":{"label":"Appropriate engineering controls","text":"Use adequate ventilation and/or engineering controls to prevent exposure to vapours.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/eb850cba-8a29-4347-857a-e5a4956be421_au01/sds-sika-stabilizer-1515tbm.pdf","page":4,"page_end":4,"doc_version":"Revision 24.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1515tbm:sds:f4879b:ppe.engineering_controls:b525b6f3"}},"transport_adg":{"un_number":"UN 1760","class":"8 Packing","text":"UN number : UN 1760","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/eb850cba-8a29-4347-857a-e5a4956be421_au01/sds-sika-stabilizer-1515tbm.pdf","page":7,"page_end":7,"doc_version":"Revision 24.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1515tbm:sds:f4879b:transport_adg:5b1bd377"},"latest_for_name":true,"name_matches_product":true},{"title":"Sika® Stabilizer-1515 TBM","url":"https://aus.sika.com/dms/getdocument.get/ed9c35c5-3b20-40db-b69c-08a3823a52e4_au01/sds-sika-stabilizer-1515tbm.pdf","revision_date":"23.03.2026","version":"2.0","sds_number":"100000060623","pages":9,"sha256":"0bb814d24f61620322f328c401bb472ce0b97918bbefd92d71b8f9c8e66b4984","product_name_on_sds":"Sika® Stabilizer-1515 TBM","component":null,"revision_age_years":0.6,"older_than_3_years":false,"classification":[{"hazard_class":"Serious eye damage/eye irritation","category":"Category 1","text":"Serious eye damage/eye irritation : Category 1","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/ed9c35c5-3b20-40db-b69c-08a3823a52e4_au01/sds-sika-stabilizer-1515tbm.pdf","page":1,"page_end":1,"doc_version":"Revision 23.03.2026, Version 2.0"},"id":"doc-sika-stabilizer-1515tbm:sds:c9a5b4:classification:08d28e3c"},{"hazard_class":"Short-term (acute) aquatic hazard","category":"Category 3","text":"Short-term (acute) aquatic hazard : Category 3","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/ed9c35c5-3b20-40db-b69c-08a3823a52e4_au01/sds-sika-stabilizer-1515tbm.pdf","p