l products","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/65611626-9eee-4a3d-a677-41b39e562408_au01/sds-sika-viscocrete-5001lc3.pdf","page":2,"page_end":2,"doc_version":"Revision 14.09.2026, Version 2.0"},"id":"doc-sika-viscocrete-5001lc3:sds:504287:handling:a6f4ac4e"},{"label":"Hygiene measures","text":"When using do not eat or drink. When using do not smoke.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/65611626-9eee-4a3d-a677-41b39e562408_au01/sds-sika-viscocrete-5001lc3.pdf","page":2,"page_end":3,"doc_version":"Revision 14.09.2026, Version 2.0"},"id":"doc-sika-viscocrete-5001lc3:sds:504287:handling:57e17a76"}],"ppe":{"respiratory":{"label":"Respiratory protection","text":"No special measures required. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/65611626-9eee-4a3d-a677-41b39e562408_au01/sds-sika-viscocrete-5001lc3.pdf","page":3,"page_end":3,"doc_version":"Revision 14.09.2026, Version 2.0"},"id":"doc-sika-viscocrete-5001lc3:sds:504287:ppe.respiratory:9e406749"},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber/nitrile rubber gloves. Contaminated gloves should be removed.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/65611626-9eee-4a3d-a677-41b39e562408_au01/sds-sika-viscocrete-5001lc3.pdf","page":3,"page_end":3,"doc_version":"Revision 14.09.2026, Version 2.0"},"id":"doc-sika-viscocrete-5001lc3:sds:504287:ppe.hands:27ef0e7d"},"eyes":{"label":"Eye protection","text":"Safety glasses","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/65611626-9eee-4a3d-a677-41b39e562408_au01/sds-sika-viscocrete-5001lc3.pdf","page":3,"page_end":3,"doc_version":"Revision 14.09.2026, Version 2.0"},"id":"doc-sika-viscocrete-5001lc3:sds:504287:ppe.eyes:03ca7e7f"},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/65611626-9eee-4a3d-a677-41b39e562408_au01/sds-sika-viscocrete-5001lc3.pdf","page":3,"page_end":3,"doc_version":"Revision 14.09.2026, Version 2.0"},"id":"doc-sika-viscocrete-5001lc3:sds:504287:ppe.skin_body:8701f223"},"engineering_controls":{"label":"Appropriate engineering controls","text":"Use adequate ventilation and/or engineering controls to prevent exposure to vapours.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/65611626-9eee-4a3d-a677-41b39e562408_au01/sds-sika-viscocrete-5001lc3.pdf","page":3,"page_end":3,"doc_version":"Revision 14.09.2026, Version 2.0"},"id":"doc-sika-viscocrete-5001lc3:sds:504287:ppe.engineering_controls:b525b6f3"}},"transport_adg":{"un_number":"Not applicable","class":"Not applicable","text":"UN number : Not applicable","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/65611626-9eee-4a3d-a677-41b39e562408_au01/sds-sika-viscocrete-5001lc3.pdf","page":6,"page_end":6,"doc_version":"Revision 14.09.2026, Version 2.0"},"id":"doc-sika-viscocrete-5001lc3:sds:504287:transport_adg:24d6694d"},"latest_for_name":true,"name_matches_product":true}]}