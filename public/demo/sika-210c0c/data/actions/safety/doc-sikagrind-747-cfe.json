tic life.","id":"doc-sikagrind-747-cfe:sds:b9efde:hazard_statements:5f4d93b1","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/364b21a5-0f5d-48db-b0c0-adb89433455c_au01/sds-sikagrind-747cfe.pdf","v":"Revision 27.07.2026, Version 1.0","p":1,"pe":1}}],"precautionary_statements":[{"group":"Prevention","code":"P264","statement":"Wash skin thoroughly after handling.","text":"P264 Wash skin thoroughly after handling.","id":"doc-sikagrind-747-cfe:sds:b9efde:precautionary_statements:5d1a9355","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/364b21a5-0f5d-48db-b0c0-adb89433455c_au01/sds-sikagrind-747cfe.pdf","v":"Revision 27.07.2026, Version 1.0","p":1,"pe":1}},{"group":"Prevention","code":"P273","statement":"Avoid release to the environment.","text":"P273 Avoid release to the environment.","id":"doc-sikagrind-747-cfe:sds:b9efde:precautionary_statements:967777c8","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/364b21a5-0f5d-48db-b0c0-adb89433455c_au01/sds-sikagrind-747cfe.pdf","v":"Revision 27.07.2026, Version 1.0","p":1,"pe":1}},{"group":"Prevention","code":"P280","statement":"Wear eye protection/ face protection.","text":"P280 Wear eye protection/ face protection.","id":"doc-sikagrind-747-cfe:sds:b9efde:precautionary_statements:23ef5ea3","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/364b21a5-0f5d-48db-b0c0-adb89433455c_au01/sds-sikagrind-747cfe.pdf","v":"Revision 27.07.2026, Version 1.0","p":1,"pe":1}},{"group":"Response","code":"P305 + P351 + P338","statement":"IF IN EYES: Rinse cautiously with water for several minutes. Remove contact lenses, if present and easy to do. Continue rinsing.","text":"P305 + P351 + P338 IF IN EYES: Rinse cautiously with water for several minutes. Remove contact lenses, if present and easy to do. Continue rinsing.","id":"doc-sikagrind-747-cfe:sds:b9efde:precautionary_statements:063cfb57","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/364b21a5-0f5d-48db-b0c0-adb89433455c_au01/sds-sikagrind-747cfe.pdf","v":"Revision 27.07.2026, Version 1.0","p":1,"pe":1}},{"group":"Response","code":"P337 + P313","statement":"If eye irritation persists: Get medical advice/ attention.","text":"P337 + P313 If eye irritation persists: Get medical advice/ attention.","id":"doc-sikagrind-747-cfe:sds:b9efde:precautionary_statements:3c696809","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/364b21a5-0f5d-48db-b0c0-adb89433455c_au01/sds-sikagrind-747cfe.pdf","v":"Revision 27.07.2026, Version 1.0","p":2,"pe":2}},{"group":"Disposal","code":"P501","statement":"Dispose of contents/ container to an approved waste disposal plant.","text":"P501 Dispose of contents/ container to an approved waste disposal plant.","id":"doc-sikagrind-747-cfe:sds:b9efde:precautionary_statements:bc03aec3","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/364b21a5-0f5d-48db-b0c0-adb89433455c_au01/sds-sikagrind-747cfe.pdf","v":"Revision 27.07.2026, Version 1.0","p":2,"pe":2}}],"storage":[{"label":"Conditions for safe storage","text":"Keep container tightly closed in a dry and well-ventilated place. Containers which are opened must be carefully resealed and kept upright to prevent leakage. Store in accordance with local regulations.","id":"doc-sikagrind-747-cfe:sds:b9efde:storage:6defd744","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/364b21a5-0f5d-48db-b0c0-adb89433455c_au01/sds-sikagrind-747cfe.pdf","v":"Revision 27.07.2026, Version 1.0","p":3,"pe":4}}],"handling":[{"label":"Advice on protection against fire and explosion","text":"Normal measures for preventive fire protection.","id":"doc-sikagrind-747-cfe:sds:b9efde:handling:3151dad9","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/364b21a5-0f5d-48db-b0c0-adb89433455c_au01/sds-sikagrind-747cfe.pdf","v":"Revision 27.07.2026, Version 1.0","p":3,"pe":3}},{"label":"Advice on safe handling","text":"Avoid exceeding the given occupational exposure limits (see section 8). Do not get in eyes, on skin, or on clothing. For personal protection see section 8. Smoking, eating and drinking should be prohibited in the application area. Follow standard hygiene measures when handling chemical products","id":"doc-sikagrind-747-cfe:sds:b9efde:handling:424f7fe5","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/364b21a5-0f5d-48db-b0c0-adb89433455c_au01/sds-sikagrind-747cfe.pdf","v":"Revision 27.07.2026, Version 1.0","p":3,"pe":3}},{"label":"Hygiene measures","text":"Handle in accordance with good industrial hygiene and safety practice. When using do not eat or drink. When using do not smoke. Wash hands before breaks and at the end of workday.","id":"doc-sikagrind-747-cfe:sds:b9efde:handling:ef026cd3","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/364b21a5-0f5d-48db-b0c0-adb89433455c_au01/sds-sikagrind-747cfe.pdf","v":"Revision 27.07.2026, Version 1.0","p":3,"pe":3}}],"ppe":{"respiratory":{"label":"Respiratory protection","text":"In case of inadequate ventilation wear respiratory protection. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","id":"doc-sikagrind-747-cfe:sds:b9efde:ppe.respiratory:1228c275","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/364b21a5-0f5d-48db-b0c0-adb89433455c_au01/sds-sikagrind-747cfe.pdf","v":"Revision 27.07.2026, Version 1.0","p":4,"pe":4}},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber/nitrile rubber gloves. Contaminated gloves should be removed.","id":"doc-sikagrind-747-cfe:sds:b9efde:ppe.hands:27ef0e7d","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/364b21a5-0f5d-48db-b0c0-adb89433455c_au01/sds-sikagrind-747cfe.pdf","v":"Revision 27.07.2026, Version 1.0","p":4,"pe":4}},"eyes":{"label":"Eye protection","text":"Safety glasses","id":"doc-sikagrind-747-cfe:sds:b9efde:ppe.eyes:03ca7e7f","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/364b21a5-0f5d-48db-b0c0-adb89433455c_au01/sds-sikagrind-747cfe.pdf","v":"Revision 27.07.2026, Version 1.0","p":4,"pe":4}},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3","id":"doc-sikagrind-747-cfe:sds:b9efde:ppe.skin_body:8701f223","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/364b21a5-0f5d-48db-b0c0-adb89433455c_au01/sds-sikagrind-747cfe.pdf","v":"Revision 27.07.2026, Version 1.0","p":4,"pe":4}},"engineering_controls":{"label":"Appropriate engineering controls","text":"Use adequate ventilation and/or engineering controls to prevent exposure to vapours.","id":"doc-sikagrind-747-cfe:sds:b9efde:ppe.engineering_controls:b525b6f3","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/364b21a5-0f5d-48db-b0c0-adb89433455c_au01/sds-sikagrind-747cfe.pdf","v":"Revision 27.07.2026, Version 1.0","p":4,"pe":4}}},"transport_adg":{"un_number":"Not applicable","class":"Not applicable","text":"UN number : Not applicable","id":"doc-sikagrind-747-cfe:sds:b9efde:transport_adg:24d6694d","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/364b21a5-0f5d-48db-b0c0-adb89433455c_au01/sds-sikagrind-747cfe.pdf","v":"Revision 27.07.2026, Version 1.0","p":8,"pe":8}},"latest_for_name":true,"name_matches_product":true}]}