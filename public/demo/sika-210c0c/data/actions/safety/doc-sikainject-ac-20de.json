stopfs-c.pdf","page":1,"page_end":1,"doc_version":"Revision 22.09.2026, Version 1.1"},"id":"doc-sikainject-ac-20de:sds:40f855:signal_word:ecac447f"},"hazard_statements":[{"code":"H227","statement":"Combustible liquid.","text":"H227 Combustible liquid.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d9abfc74-45f5-4215-ac67-154a1cf814d2_au01/sds-sikainject-ac-20detphpur-o-stopfs-c.pdf","page":1,"page_end":1,"doc_version":"Revision 22.09.2026, Version 1.1"},"id":"doc-sikainject-ac-20de:sds:40f855:hazard_statements:0f901f4f"},{"code":"H315","statement":"Causes skin irritation.","text":"H315 Causes skin irritation.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d9abfc74-45f5-4215-ac67-154a1cf814d2_au01/sds-sikainject-ac-20detphpur-o-stopfs-c.pdf","page":1,"page_end":1,"doc_version":"Revision 22.09.2026, Version 1.1"},"id":"doc-sikainject-ac-20de:sds:40f855:hazard_statements:272833a5"},{"code":"H318","statement":"Causes serious eye damage.","text":"H318 Causes serious eye damage.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d9abfc74-45f5-4215-ac67-154a1cf814d2_au01/sds-sikainject-ac-20detphpur-o-stopfs-c.pdf","page":1,"page_end":1,"doc_version":"Revision 22.09.2026, Version 1.1"},"id":"doc-sikainject-ac-20de:sds:40f855:hazard_statements:da8179dd"}],"precautionary_statements":[{"group":"Prevention","code":"P210","statement":"Keep away from heat, hot surfaces, sparks, open flames and other ignition sources. No smoking.","text":"P210 Keep away from heat, hot surfaces, sparks, open flames and other ignition sources. No smoking.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d9abfc74-45f5-4215-ac67-154a1cf814d2_au01/sds-sikainject-ac-20detphpur-o-stopfs-c.pdf","page":1,"page_end":1,"doc_version":"Revision 22.09.2026, Version 1.1"},"id":"doc-sikainject-ac-20de:sds:40f855:precautionary_statements:010c5ba3"},{"group":"Prevention","code":"P264","statement":"Wash skin thoroughly after handling.","text":"P264 Wash skin thoroughly after handling.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d9abfc74-45f5-4215-ac67-154a1cf814d2_au01/sds-sikainject-ac-20detphpur-o-stopfs-c.pdf","page":1,"page_end":1,"doc_version":"Revision 22.09.2026, Version 1.1"},"id":"doc-sikainject-ac-20de:sds:40f855:precautionary_statements:5d1a9355"},{"group":"Prevention","code":"P280","statement":"Wear protective gloves/ protective clothing/ eye protection/ face protection/ hearing protection.","text":"P280 Wear protective gloves/ protective clothing/ eye protection/ face protection/ hearing protection.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d9abfc74-45f5-4215-ac67-154a1cf814d2_au01/sds-sikainject-ac-20detphpur-o-stopfs-c.pdf","page":1,"page_end":1,"doc_version":"Revision 22.09.2026, Version 1.1"},"id":"doc-sikainject-ac-20de:sds:40f855:precautionary_statements:15fc2146"},{"group":"Response","code":"P302 + P352","statement":"IF ON SKIN: Wash with plenty of water.","text":"P302 + P352 IF ON SKIN: Wash with plenty of water.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d9abfc74-45f5-4215-ac67-154a1cf814d2_au01/sds-sikainject-ac-20detphpur-o-stopfs-c.pdf","page":2,"page_end":2,"doc_version":"Revision 22.09.2026, Version 1.1"},"id":"doc-sikainject-ac-20de:sds:40f855:precautionary_statements:153d8276"},{"group":"Response","code":"P305 + P351 + P338 + P310","statement":"IF IN EYES: Rinse cautiously with water for several minutes. Remove contact lenses, if present and easy to do. Continue rinsing. Immediately call a POISON CENTER/ doctor.","text":"P305 + P351 + P338 + P310 IF IN EYES: Rinse cautiously with water for several minutes. Remove contact lenses, if present and easy to do. Continue rinsing. Immediately call a POISON CENTER/ doctor.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d9abfc74-45f5-4215-ac67-154a1cf814d2_au01/sds-sikainject-ac-20detphpur-o-stopfs-c.pdf","page":2,"page_end":2,"doc_version":"Revision 22.09.2026, Version 1.1"},"id":"doc-sikainject-ac-20de:sds:40f855:precautionary_statements:ecd5dbac"},{"group":"Response","code":"P332 + P313","statement":"If skin irritation occurs: Get medical advice/ attention.","text":"P332 + P313 If skin irritation occurs: Get medical advice/ attention.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d9abfc74-45f5-4215-ac67-154a1cf814d2_au01/sds-sikainject-ac-20detphpur-o-stopfs-c.pdf","page":2,"page_end":2,"doc_version":"Revision 22.09.2026, Version 1.1"},"id":"doc-sikainject-ac-20de:sds:40f855:precautionary_statements:48ff9c32"},{"group":"Response","code":"P362 + P364","statement":"Take off contaminated clothing and wash it before reuse.","text":"P362 + P364 Take off contaminated clothing and wash it before reuse.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d9abfc74-45f5-4215-ac67-154a1cf814d2_au01/sds-sikainject-ac-20detphpur-o-stopfs-c.pdf","page":2,"page_end":2,"doc_version":"Revision 22.09.2026, Version 1.1"},"id":"doc-sikainject-ac-20de:sds:40f855:precautionary_statements:4732b4f8"},{"group":"Response","code":"P370 + P378","statement":"In case of fire: Use dry sand, dry chemical or alcohol-resistant foam to extinguish.","text":"P370 + P378 In case of fire: Use dry sand, dry chemical or alcohol-resistant foam to extinguish.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d9abfc74-45f5-4215-ac67-154a1cf814d2_au01/sds-sikainject-ac-20detphpur-o-stopfs-c.pdf","page":2,"page_end":2,"doc_version":"Revision 22.09.2026, Version 1.1"},"id":"doc-sikainject-ac-20de:sds:40f855:precautionary_statements:bd7cf0d8"},{"group":"Storage","code":"P403","statement":"Store in a well-ventilated place.","text":"P403 Store in a well-ventilated place.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d9abfc74-45f5-4215-ac67-154a1cf814d2_au01/sds-sikainject-ac-20detphpur-o-stopfs-c.pdf","page":2,"page_end":2,"doc_version":"Revision 22.09.2026, Version 1.1"},"id":"doc-sikainject-ac-20de:sds:40f855:precautionary_statements:78dbaeaf"},{"group":"Disposal","code":"P501","statement":"Dispose of contents/ container to an approved waste disposal plant.","text":"P501 Dispose of contents/ container to an approved waste disposal plant.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d9abfc74-45f5-4215-ac67-154a1cf814d2_au01/sds-sikainject-ac-20detphpur-o-stopfs-c.pdf","page":2,"page_end":2,"doc_version":"Revision 22.09.2026, Version 1.1"},"id":"doc-sikainject-ac-20de:sds:40f855:precautionary_statements:bc03aec3"}],"storage":[{"label":"Conditions for safe storage","text":"Store in original container. Keep in a well-ventilated place. Containers which are opened must be carefully resealed and kept upright to prevent leakage. Observe label precautions. Store in accordance with local regulations.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d9abfc74-45f5-4215-ac67-154a1cf814d2_au01/sds-sikainject-ac-20detphpur-o-stopfs-c.pdf","page":4,"page_end":4,"doc_version":"Revision 22.09.2026, Version 1.1"},"id":"doc-sikainject-ac-20de:sds:40f855:storage:90ce497a"}],"handling":[{"label":"Advice on protection against fire and explosion","text":"Normal measures for preventive fire protection.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d9abfc74-45f5-4215-ac67-154a1cf814d2_au01/sds-sikainject-ac-20detphpur-o-stopfs-c.pdf","page":4,"page_end":4,"doc_version":"Revision 22.09.2026, Version 1.1"},"id":"doc-sikainject-ac-20de:sds:40f855:handling:3151dad9"},{"label":"Advice on safe handling","text":"Avoid exceeding the given occupational exposure limits (see section 8). Do not get in eyes, on skin, or on clothing. For personal protection see section 8. Smoking, eating and drinking should be prohibited in the application area. Follow standard hygiene measures when handling chemical products","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d9abfc74-45f5-4215-ac67-154a1cf814d2_au01/sds-sikainject-ac-20detphpur-o-stopfs-c.pdf","page":4,"page_end":4,"doc_version":"Revision 22.09.2026, Version 1.1"},"id":"doc-sikainject-ac-20de:sds:40f855:handling:424f7fe5"},{"label":"Hygiene measures","text":"Handle in accordance with good industrial hygiene and safety practice. When using do not eat or drink. When using do not smoke. Wash hands before breaks and at the end of workday.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d9abfc74-45f5-4215-ac67-154a1cf814d2_au01/sds-sikainject-ac-20detphpur-o-stopfs-c.pdf","page":4,"page_end":4,"doc_version":"Revision 22.09.2026, Version 1.1"},"id":"doc-sikainject-ac-20de:sds:40f855:handling:ef026cd3"}],"ppe":{"respiratory":{"label":"Respiratory protection","text":"No special measures required. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d9abfc74-45f5-4215-ac67-154a1cf814d2_au01/sds-sikainject-ac-20detphpur-o-stopfs-c.pdf","page":4,"page_end":4,"doc_version":"Revision 22.09.2026, Version 1.1"},"id":"doc-sikainject-ac-20de:sds:40f855:ppe.respiratory:9e406749"},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber/nitrile rubber gloves. Contaminated gloves should be removed.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d9abfc74-45f5-4215-ac67-154a1cf814d2_au01/sds-sikainject-ac-20detphpur-o-stopfs-c.pdf","page":4,"page_end":4,"doc_version":"Revision 22.09.2026, Version 1.1"},"id":"doc-sikainject-ac-20de:sds:40f855:ppe.hands:27ef0e7d"},"eyes":{"label":"Eye protection","text":"Safety glasses","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d9abfc74-45f5-4215-ac67-154a1cf814d2_au01/sds-sikainject-ac-20detphpur-o-stopfs-c.pdf","page":4,"page_end":4,"doc_version":"Revision 22.09.2026, Version 1.1"},"id":"doc-sikainject-ac-20de:sds:40f855:ppe.eyes:03ca7e7f"},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3 Protective clothing needs to be made of cotton.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d9abfc74-45f5-4215-ac67-154a1cf814d2_au01/sds-sikainject-ac-20detphpur-o-stopfs-c.pdf","page":4,"page_end":5,"doc_version":"Revision 22.09.2026, Version 1.1"},"id":"doc-sikainject-ac-20de:sds:40f855:ppe.skin_body:086497a7"},"engineering_controls":{"label":"Appropriate engineering controls","text":"Use adequate ventilation and/or engineering controls to prevent exposure to vapours.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d9abfc74-45f5-4215-ac67-154a1cf814d2_au01/sds-sikainject-ac-20detphpur-o-stopfs-c.pdf","page":4,"page_end":4,"doc_version":"Revision 22.09.2026, Version 1.1"},"id":"doc-sikainject-ac-20de:sds:40f855:ppe.engineering_controls:b525b6f3"}},"transport_adg":{"un_number":"Not applicable","class":"Not applicable","text":"UN number : Not applicable","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d9abfc74-45f5-4215-ac67-154a1cf814d2_au01/sds-sikainject-ac-20detphpur-o-stopfs-c.pdf","page":8,"page_end":8,"doc_version":"Revision 22.09.2026, Version 1.1"},"id":"doc-sikainject-ac-20de:sds:40f855:transport_adg:24d6694d"},"latest_for_name":true,"name_matches_product":true}]}