ntion","code":"P273","statement":"Avoid release to the environment.","text":"P273 Avoid release to the environment.","id":"doc-sikaplast-3-in-1e:sds:f68e65:precautionary_statements:967777c8","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a322747-7545-4dcc-9279-14cba8c41f65_au01/sds-sikaplast-3-in-1e.pdf","v":"Revision 28.10.2025, Version 2.0","p":1,"pe":1}},{"group":"Disposal","code":"P501","statement":"Dispose of contents/ container to an approved waste disposal plant.","text":"P501 Dispose of contents/ container to an approved waste disposal plant.","id":"doc-sikaplast-3-in-1e:sds:f68e65:precautionary_statements:bc03aec3","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a322747-7545-4dcc-9279-14cba8c41f65_au01/sds-sikaplast-3-in-1e.pdf","v":"Revision 28.10.2025, Version 2.0","p":1,"pe":1}}],"storage":[{"label":"Conditions for safe storage","text":"Keep container tightly closed in a dry and well-ventilated place. Store in accordance with local regulations.","id":"doc-sikaplast-3-in-1e:sds:f68e65:storage:efaa6aee","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a322747-7545-4dcc-9279-14cba8c41f65_au01/sds-sikaplast-3-in-1e.pdf","v":"Revision 28.10.2025, Version 2.0","p":3,"pe":3}},{"label":"Materials to avoid","text":"No special restrictions on storage with other products.","id":"doc-sikaplast-3-in-1e:sds:f68e65:storage:ca8dd6c0","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a322747-7545-4dcc-9279-14cba8c41f65_au01/sds-sikaplast-3-in-1e.pdf","v":"Revision 28.10.2025, Version 2.0","p":3,"pe":3}}],"handling":[{"label":"Advice on protection against fire and explosion","text":"Normal measures for preventive fire protection.","id":"doc-sikaplast-3-in-1e:sds:f68e65:handling:3151dad9","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a322747-7545-4dcc-9279-14cba8c41f65_au01/sds-sikaplast-3-in-1e.pdf","v":"Revision 28.10.2025, Version 2.0","p":3,"pe":3}},{"label":"Advice on safe handling","text":"For personal protection see section 8. No special handling advice required. Follow standard hygiene measures when handling chemical products","id":"doc-sikaplast-3-in-1e:sds:f68e65:handling:a6f4ac4e","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a322747-7545-4dcc-9279-14cba8c41f65_au01/sds-sikaplast-3-in-1e.pdf","v":"Revision 28.10.2025, Version 2.0","p":3,"pe":3}},{"label":"Hygiene measures","text":"When using do not eat or drink. When using do not smoke.","id":"doc-sikaplast-3-in-1e:sds:f68e65:handling:57e17a76","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a322747-7545-4dcc-9279-14cba8c41f65_au01/sds-sikaplast-3-in-1e.pdf","v":"Revision 28.10.2025, Version 2.0","p":3,"pe":3}}],"ppe":{"respiratory":{"label":"Respiratory protection","text":"No special measures required. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","id":"doc-sikaplast-3-in-1e:sds:f68e65:ppe.respiratory:9e406749","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a322747-7545-4dcc-9279-14cba8c41f65_au01/sds-sikaplast-3-in-1e.pdf","v":"Revision 28.10.2025, Version 2.0","p":3,"pe":3}},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber/nitrile rubber gloves. Contaminated gloves should be removed.","id":"doc-sikaplast-3-in-1e:sds:f68e65:ppe.hands:27ef0e7d","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a322747-7545-4dcc-9279-14cba8c41f65_au01/sds-sikaplast-3-in-1e.pdf","v":"Revision 28.10.2025, Version 2.0","p":3,"pe":3}},"eyes":{"label":"Eye protection","text":"Safety glasses","id":"doc-sikaplast-3-in-1e:sds:f68e65:ppe.eyes:03ca7e7f","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a322747-7545-4dcc-9279-14cba8c41f65_au01/sds-sikaplast-3-in-1e.pdf","v":"Revision 28.10.2025, Version 2.0","p":3,"pe":3}},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3","id":"doc-sikaplast-3-in-1e:sds:f68e65:ppe.skin_body:8701f223","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a322747-7545-4dcc-9279-14cba8c41f65_au01/sds-sikaplast-3-in-1e.pdf","v":"Revision 28.10.2025, Version 2.0","p":3,"pe":3}},"engineering_controls":{"label":"Appropriate engineering controls","text":"Use adequate ventilation and/or engineering controls to prevent exposure to vapours.","id":"doc-sikaplast-3-in-1e:sds:f68e65:ppe.engineering_controls:b525b6f3","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a322747-7545-4dcc-9279-14cba8c41f65_au01/sds-sikaplast-3-in-1e.pdf","v":"Revision 28.10.2025, Version 2.0","p":3,"pe":3}}},"transport_adg":null,"latest_for_name":true,"name_matches_product":true}]}