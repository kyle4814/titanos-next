,"source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sds-icosit-kc-34065parta.pdf","page":1,"page_end":1,"doc_version":"Revision 04.07.2025, Version 2.0"},"id":"sika-icosit-kc-34065:sds:c4b756:hazard_statements:d4c10fb8"},{"code":"H411","statement":"Toxic to aquatic life with long lasting effects.","text":"H411 Toxic to aquatic life with long lasting effects.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sds-icosit-kc-34065parta.pdf","page":1,"page_end":1,"doc_version":"Revision 04.07.2025, Version 2.0"},"id":"sika-icosit-kc-34065:sds:c4b756:hazard_statements:acf7222c"}],"precautionary_statements":[{"group":"Prevention","code":"P261","statement":"Avoid breathing mist or vapours.","text":"P261 Avoid breathing mist or vapours.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sds-icosit-kc-34065parta.pdf","page":1,"page_end":1,"doc_version":"Revision 04.07.2025, Version 2.0"},"id":"sika-icosit-kc-34065:sds:c4b756:precautionary_statements:7895cfea"},{"group":"Prevention","code":"P272","statement":"Contaminated work clothing should not be allowed out of the workplace.","text":"P272 Contaminated work clothing should not be allowed out of the workplace.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sds-icosit-kc-34065parta.pdf","page":1,"page_end":1,"doc_version":"Revision 04.07.2025, Version 2.0"},"id":"sika-icosit-kc-34065:sds:c4b756:precautionary_statements:2222e81e"},{"group":"Prevention","code":"P273","statement":"Avoid release to the environment.","text":"P273 Avoid release to the environment.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sds-icosit-kc-34065parta.pdf","page":1,"page_end":1,"doc_version":"Revision 04.07.2025, Version 2.0"},"id":"sika-icosit-kc-34065:sds:c4b756:precautionary_statements:967777c8"},{"group":"Prevention","code":"P280","statement":"Wear protective gloves.","text":"P280 Wear protective gloves.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sds-icosit-kc-34065parta.pdf","page":1,"page_end":1,"doc_version":"Revision 04.07.2025, Version 2.0"},"id":"sika-icosit-kc-34065:sds:c4b756:precautionary_statements:87630ec7"},{"group":"Response","code":"P302 + P352","statement":"IF ON SKIN: Wash with plenty of water.","text":"P302 + P352 IF ON SKIN: Wash with plenty of water.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sds-icosit-kc-34065parta.pdf","page":2,"page_end":2,"doc_version":"Revision 04.07.2025, Version 2.0"},"id":"sika-icosit-kc-34065:sds:c4b756:precautionary_statements:153d8276"},{"group":"Response","code":"P333 + P313","statement":"If skin irritation or rash occurs: Get medical advice/ attention.","text":"P333 + P313 If skin irritation or rash occurs: Get medical advice/ attention.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sds-icosit-kc-34065parta.pdf","page":2,"page_end":2,"doc_version":"Revision 04.07.2025, Version 2.0"},"id":"sika-icosit-kc-34065:sds:c4b756:precautionary_statements:0c2e03d6"},{"group":"Response","code":"P362 + P364","statement":"Take off contaminated clothing and wash it before reuse.","text":"P362 + P364 Take off contaminated clothing and wash it before reuse.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sds-icosit-kc-34065parta.pdf","page":2,"page_end":2,"doc_version":"Revision 04.07.2025, Version 2.0"},"id":"sika-icosit-kc-34065:sds:c4b756:precautionary_statements:4732b4f8"},{"group":"Response","code":"P391","statement":"Collect spillage.","text":"P391 Collect spillage.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sds-icosit-kc-34065parta.pdf","page":2,"page_end":2,"doc_version":"Revision 04.07.2025, Version 2.0"},"id":"sika-icosit-kc-34065:sds:c4b756:precautionary_statements:ea864d16"},{"group":"Disposal","code":"P501","statement":"Dispose of contents/ container to an approved waste disposal plant.","text":"P501 Dispose of contents/ container to an approved waste disposal plant.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sds-icosit-kc-34065parta.pdf","page":2,"page_end":2,"doc_version":"Revision 04.07.2025, Version 2.0"},"id":"sika-icosit-kc-34065:sds:c4b756:precautionary_statements:bc03aec3"}],"storage":[{"label":"Conditions for safe storage","text":"Keep container tightly closed in a dry and well-ventilated place. Containers which are opened must be carefully resealed and kept upright to prevent leakage. Store in accordance with local regulations.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sds-icosit-kc-34065parta.pdf","page":4,"page_end":4,"doc_version":"Revision 04.07.2025, Version 2.0"},"id":"sika-icosit-kc-34065:sds:c4b756:storage:6defd744"}],"handling":[{"label":"Advice on protection against fire and explosion","text":"Normal measures for preventive fire protection.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sds-icosit-kc-34065parta.pdf","page":4,"page_end":4,"doc_version":"Revision 04.07.2025, Version 2.0"},"id":"sika-icosit-kc-34065:sds:c4b756:handling:3151dad9"},{"label":"Advice on safe handling","text":"Avoid exceeding the given occupational exposure limits (see section 8). Do not get in eyes, on skin, or on clothing. For personal protection see section 8. Persons with a history of skin sensitisation problems or asthma, allergies, chronic or recurrent respiratory disease should not be employed in any process in which this mixture is being used. Smoking, eating and drinking should be prohibited in the application area. Follow standard hygiene measures when handling chemical products","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sds-icosit-kc-34065parta.pdf","page":4,"page_end":4,"doc_version":"Revision 04.07.2025, Version 2.0"},"id":"sika-icosit-kc-34065:sds:c4b756:handling:de03b4b8"},{"label":"Hygiene measures","text":"Handle in accordance with good industrial hygiene and safety practice. When using do not eat or drink. When using do not smoke. Wash hands before breaks and at the end of workday.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sds-icosit-kc-34065parta.pdf","page":4,"page_end":4,"doc_version":"Revision 04.07.2025, Version 2.0"},"id":"sika-icosit-kc-34065:sds:c4b756:handling:ef026cd3"}],"ppe":{"respiratory":{"label":"Respiratory protection","text":"No special measures required. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sds-icosit-kc-34065parta.pdf","page":4,"page_end":4,"doc_version":"Revision 04.07.2025, Version 2.0"},"id":"sika-icosit-kc-34065:sds:c4b756:ppe.respiratory:9e406749"},"eyes":{"label":"Eye protection","text":"Safety glasses","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sds-icosit-kc-34065parta.pdf","page":5,"page_end":5,"doc_version":"Revision 04.07.2025, Version 2.0"},"id":"sika-icosit-kc-34065:sds:c4b756:ppe.eyes:03ca7e7f"},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sds-icosit-kc-34065parta.pdf","page":5,"page_end":5,"doc_version":"Revision 04.07.2025, Version 2.0"},"id":"sika-icosit-kc-34065:sds:c4b756:ppe.skin_body:8701f223"},"engineering_controls":{"label":"Appropriate engineering controls","text":"Use adequate ventilation and/or engineering controls to prevent exposure to vapours.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sds-icosit-kc-34065parta.pdf","page":4,"page_end":4,"doc_version":"Revision 04.07.2025, Version 2.0"},"id":"sika-icosit-kc-34065:sds:c4b756:ppe.engineering_controls:b525b6f3"}},"transport_adg":{"un_number":"UN 3082","class":"9 Packing","text":"UN number : UN 3082","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/c/sds-icosit-kc-34065parta.pdf","page":8,"page_end":8,"doc_version":"Revision 04.07.2025, Version 2.0"},"id":"sika-icosit-kc-34065:sds:c4b756:transport_adg:8c70cce7"},"latest_for_name":true,"name_matches_product":false}]}