{"id":"sika-plastiment-30","sds":[{"title":"SDS Sika® Plastiment®-30","url":"https://aus.sika.com/content/dam/dms/au01/3/sds-sika-plastiment-30.pdf","revision_date":"10.12.2025","version":"6.0","sds_number":"100000012742","pages":8,"sha256":"206ede228711be15033c4c6799b2f95d551da957fedc36c239e0b26afb3c15df","product_name_on_sds":"Sika® Plastiment®-30","component":null,"revision_age_years":0.9,"older_than_3_years":false,"classification":[{"hazard_class":"Short-term (acute) aquatic hazard","category":"Category 3","text":"Short-term (acute) aquatic hazard : Category 3","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/3/sds-sika-plastiment-30.pdf","page":1,"page_end":1,"doc_version":"Revision 10.12.2025, Version 6.0"},"id":"sika-plastiment-30:sds:6e77ca:classification:99b25c25"},{"hazard_class":"Long-term (chronic) aquatic hazard","category":"Category 3","text":"Long-term (chronic) aquatic hazard : Category 3","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/3/sds-sika-plastiment-30.pdf","page":1,"page_end":1,"doc_version":"Revision 10.12.2025, Version 6.0"},"id":"sika-plastiment-30:sds:6e77ca:classification:917ba362"}],"signal_word":{"value":"None","text":"Signal word : None","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/3/sds-sika-plastiment-30.pdf","page":1,"page_end":1,"doc_version":"Revision 10.12.2025, Version 6.0"},"id":"sika-plastiment-30:sds:6e77ca:signal_word:1022e277"},"hazard_statements":[{"code":"H412","statement":"Harmful to aquatic life with long lasting effects.","text":"H412 Harmful to aquatic life with long lasting effects.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/3/sds-sika-plastiment-30.pdf","page":1,"page_end":1,"doc_version":"Revision 10.12.2025, Version 6.0"},"id":"sika-plastiment-30:sds:6e77ca:hazard_statements:b35e8c1c"}],"precautionary_statements":[{"group":"Prevention","code":"P273","statement":"Avoid release to the environment.","text":"P273 Avoid release to the environment.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/3/sds-sika-plastiment-30.pdf","page":1,"page_end":1,"doc_version":"Revision 10.12.2025, Version 6.0"},"id":"sika-plastiment-30:sds:6e77ca:precautionary_statements:967777c8"},{"group":"Disposal","code":"P501","statement":"Dispose of contents/ container to an approved waste disposal plant.","text":"P501 Dispose of contents/ container to an approved waste disposal plant.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/3/sds-sika-plastiment-30.pdf","page":1,"page_end":1,"doc_version":"Revision 10.12.2025, Version 6.0"},"id":"sika-plastiment-30:sds:6e77ca:precautionary_statements:bc03aec3"}],"storage":[{"label":"Conditions for safe storage","text":"Keep container tightly closed in a dry and well-ventilated place. Store in accordance with local regulations.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/3/sds-sika-plastiment-30.pdf","page":3,"page_end":3,"doc_version":"Revision 10.12.2025, Version 6.0"},"id":"sika-plastiment-30:sds:6e77ca:storage:efaa6aee"},{"label":"Materials to avoid","text":"No special restrictions on storage with other products.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/3/sds-sika-plastiment-30.pdf","page":3,"page_end":3,"doc_version":"Revision 10.12.2025, Version 6.0"},"id":"sika-plastiment-30:sds:6e77ca:storage:ca8dd6c0"}],"handling":[{"label":"Advice on protection against fire and explosion","text":"Normal measures for preventive fire protection.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/3/sds-sika-plastiment-30.pdf","page":3,"page_end":3,"doc_version":"Revision 10.12.2025, Version 6.0"},"id":"sika-plastiment-30:sds:6e77ca:handling:3151dad9"},{"label":"Advice on safe handling","text":"For personal protection see section 8. No special handling advice required. Follow standard hygiene measures when handling chemical products","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/3/sds-sika-plastiment-30.pdf","page":3,"page_end":3,"doc_version":"Revision 10.12.2025, Version 6.0"},"id":"sika-plastiment-30:sds:6e77ca:handling:a6f4ac4e"},{"label":"Hygiene measures","text":"When using do not eat or drink. When using do not smoke.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/3/sds-sika-plastiment-30.pdf","page":3,"page_end":3,"doc_version":"Revision 10.12.2025, Version 6.0"},"id":"sika-plastiment-30:sds:6e77ca:handling:57e17a76"}],"ppe":{"respiratory":{"label":"Respiratory protection","text":"No special measures required. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/3/sds-sika-plastiment-30.pdf","page":3,"page_end":3,"doc_version":"Revision 10.12.2025, Version 6.0"},"id":"sika-plastiment-30:sds:6e77ca:ppe.respiratory:9e406749"},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber/nitrile rubber gloves. Contaminated gloves should be removed.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/3/sds-sika-plastiment-30.pdf","page":3,"page_end":3,"doc_version":"Revision 10.12.2025, Version 6.0"},"id":"sika-plastiment-30:sds:6e77ca:ppe.hands:27ef0e7d"},"eyes":{"label":"Eye protection","text":"Safety glasses","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/3/sds-sika-plastiment-30.pdf","page":3,"page_end":3,"doc_version":"Revision 10.12.2025, Version 6.0"},"id":"sika-plastiment-30:sds:6e77ca:ppe.eyes:03ca7e7f"},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/3/sds-sika-plastiment-30.pdf","page":3,"page_end":3,"doc_version":"Revision 10.12.2025, Version 6.0"},"id":"sika-plastiment-30:sds:6e77ca:ppe.skin_body:8701f223"},"engineering_controls":{"label":"Appropriate engineering controls","text":"Use adequate ventilation and/or engineering controls to prevent exposure to vapours.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/3/sds-sika-plastiment-30.pdf","page":3,"page_end":3,"doc_version":"Revision 10.12.2025, Version 6.0"},"id":"sika-plastiment-30:sds:6e77ca:ppe.engineering_controls:b525b6f3"}},"transport_adg":{"un_number":"Not applicable","class":"Not applicable","text":"UN number : Not applicable","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/3/sds-sika-plastiment-30.pdf","page":7,"page_end":7,"doc_version":"Revision 10.12.2025, Version 6.0"},"id":"sika-plastiment-30:sds:6e77ca:transport_adg:24d6694d"},"latest_for_name":true,"name_matches_product":true},{"title":"Sika Plastiment 30","url":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sika%20Plastiment%C2%AE%2030%20GHS7.pdf","revision_date":"10.02.2025","version":"5.0","sds_number":"100000012742","pages":9,"sha256":"e5ed544de2f1ee317374d3140535356b06117ad23da4bec0d90a4297c0beccb3","product_name_on_sds":"Sika® Plastiment®-30","component":null,"revision_age_years":1.7,"older_than_3_years":false,"classification":[{"hazard_class":"Serious eye damage/eye irritation","category":"Category 2A","text":"Serious eye damage/eye irritation : Category 2A","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sika%20Plastiment%C2%AE%2030%20GHS7.pdf","page":1,"page_end":1,"doc_version":"Revision 10.02.2025, Version 5.0"},"id":"sika-plastiment-30:sds:264632:classification:13c22001"},{"hazard_class":"Short-term (acute) aquatic hazard","category":"Category 3","text":"Short-term (acute) aquatic hazard : Category 3","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sika%20Plastiment%C2%AE%2030%20GHS7.pdf","page":1,"page_end":1,"doc_version":"Revision 10.02.2025, Version 5.0"},"id":"sika-plastiment-30:sds:264632:classification:99b25c25"},{"hazard_class":"Long-term (chronic) aquatic hazard","category":"Category 3","text":"Long-term (chronic) aquatic hazard : Category 3","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sika%20Plastiment%C2%AE%2030%20GHS7.pdf","page":1,"page_end":1,"doc_version":"Revision 10.02.2025, Version 5.0"},"id":"sika-plastiment-30:sds:264632:classification:917ba362"}],"signal_word":{"value":"Warning","text":"Signal word : Warning","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sika%20Plastiment%C2%AE%2030%20GHS7.pdf","page":1,"page_end":1,"doc_version":"Revision 10.02.2025, Version 5.0"},"id":"sika-plastiment-30:sds:264632:signal_word:81c5033b"},"hazard_statements":[{"code":"H319","statement":"Causes serious eye irritation.","text":"H319 Causes serious eye irritation.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sika%20Plastiment%C2%AE%2030%20GHS7.pdf","page":1,"page_end":1,"doc_version":"Revision 10.02.2025, Version 5.0"},"id":"sika-plastiment-30:sds:264632:hazard_statements:0bafcf6b"},{"code":"H412","statement":"Harmful to aquatic life with long lasting effects.","text":"H412 Harmful to aquatic life with long lasting effects.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sika%20Plastiment%C2%AE%2030%20GHS7.pdf","page":1,"page_end":1,"doc_version":"Revision 10.02.2025, Version 5.0"},"id":"sika-plastiment-30:sds:264632:hazard_statements:b35e8c1c"}],"precautionary_statements":[{"group":"Prevention","code":"P264","statement":"Wash skin thoroughly after handling.","text":"P264 Wash skin thoroughly after handling.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sika%20Plastiment%C2%AE%2030%20GHS7.pdf","page":1,"page_end":1,"doc_version":"Revision 10.02.2025, Version 5.0"},"id":"sika-plastiment-30:sds:264632:precautionary_statements:5d1a9355"},{"group":"Prevention","code":"P273","statement":"Avoid release to the environment.","text":"P273 Avoid release to the environment.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sika%20Plastiment%C2%AE%2030%20GHS7.pdf","page":1,"page_end":1,"doc_version":"Revision 10.02.2025, Version 5.0"},"id":"sika-plastiment-30:sds:264632:precautionary_statements:967777c8"},{"group":"Prevention","code":"P280","statement":"Wear eye protection/ face protection.","text":"P280 Wear eye protection/ face protection.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sika%20Plastiment%C2%AE%2030%20GHS7.pdf","page":1,"page_end":1,"doc_version":"Revision 10.02.2025, Version 5.0"},"id":"sika-plastiment-30:sds:264632:precautionary_statements:23ef5ea3"},{"group":"Response","code":"P305 + P351 + P338","statement":"IF IN EYES: Rinse cautiously with water for several minutes. Remove contact lenses, if present and easy to do. Continue rinsing.","text":"P305 + P351 + P338 IF IN EYES: Rinse cautiously with water for several minutes. Remove contact lenses, if present and easy to do. Continue rinsing.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sika%20Plastiment%C2%AE%2030%20GHS7.pdf","page":1,"page_end":1,"doc_version":"Revision 10.02.2025, Version 5.0"},"id":"sika-plastiment-30:sds:264632:precautionary_statements:063cfb57"},{"group":"Response","code":"P337 + P313","statement":"If eye irritation persists: Get medical advice/ attention.","text":"P337 + P313 If eye irritation persists: Get medical advice/ attention.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sika%20Plastiment%C2%AE%2030%20GHS7.pdf","page":1,"page_end":2,"doc_version":"Revision 10.02.2025, Version 5.0"},"id":"sika-plastiment-30:sds:264632:precautionary_statements:3c696809"},{"group":"Disposal","code":"P501","statement":"Dispose of contents/ container to an approved waste disposal plant.","text":"P501 Dispose of contents/ container to an approved waste disposal plant.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sika%20Plastiment%C2%AE%2030%20GHS7.pdf","page":2,"page_end":2,"doc_version":"Revision 10.02.2025, Version 5.0"},"id":"sika-plastiment-30:sds:264632:precautionary_statements:bc03aec3"}],"storage":[{"label":"Conditions for safe storage","text":"Keep container tightly closed in a dry and well-ventilated place. Containers which are opened must be carefully resealed and kept upright to prevent leakage. Store in accordance with local regulations.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sika%20Plastiment%C2%AE%2030%20GHS7.pdf","page":3,"page_end":3,"doc_version":"Revision 10.02.2025, Version 5.0"},"id":"sika-plastiment-30:sds:264632:storage:6defd744"}],"handling":[{"label":"Advice on protection against fire and explosion","text":"Normal measures for preventive fire protection.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sika%20Plastiment%C2%AE%2030%20GHS7.pdf","page":3,"page_end":3,"doc_version":"Revision 10.02.2025, Version 5.0"},"id":"sika-plastiment-30:sds:264632:handling:3151dad9"},{"label":"Advice on safe handling","text":"Avoid exceeding the given occupational exposure limits (see section 8). Do not get in eyes, on skin, or on clothing. For personal protection see section 8. Smoking, eating and drinking should be prohibited in the application area. Follow standard hygiene measures when handling chemical products","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sika%20Plastiment%C2%AE%2030%20GHS7.pdf","page":3,"page_end":3,"doc_version":"Revision 10.02.2025, Version 5.0"},"id":"sika-plastiment-30:sds:264632:handling:424f7fe5"},{"label":"Hygiene measures","text":"Handle in accordance with good industrial hygiene and safety practice. When using do not eat or drink. When using do not smoke. Wash hands before breaks and at the end of workday.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sika%20Plastiment%C2%AE%2030%20GHS7.pdf","page":3,"page_end":3,"doc_version":"Revision 10.02.2025, Version 5.0"},"id":"sika-plastiment-30:sds:264632:handling:ef026cd3"}],"ppe":{"respiratory":{"label":"Respiratory protection","text":"No special measures required. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sika%20Plastiment%C2%AE%2030%20GHS7.pdf","page":4,"page_end":4,"doc_version":"Revision 10.02.2025, Version 5.0"},"id":"sika-plastiment-30:sds:264632:ppe.respiratory:9e406749"},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber/nitrile rubber gloves. Contaminated gloves should be removed.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sika%20Plastiment%C2%AE%2030%20GHS7.pdf","page":4,"page_end":4,"doc_version":"Revision 10.02.2025, Version 5.0"},"id":"sika-plastiment-30:sds:264632:ppe.hands:27ef0e7d"},"eyes":{"label":"Eye protection","text":"Safety glasses","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sika%20Plastiment%C2%AE%2030%20GHS7.pdf","page":4,"page_end":4,"doc_version":"Revision 10.02.2025, Version 5.0"},"id":"sika-plastiment-30:sds:264632:ppe.eyes:03ca7e7f"},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sika%20Plastiment%C2%AE%2030%20GHS7.pdf","page":4,"page_end":4,"doc_version":"Revision 10.02.2025, Version 5.0"},"id":"sika-plastiment-30:sds:264632:ppe.skin_body:8701f223"},"engineering_controls":{"label":"Appropriate engineering controls","text":"Use adequate ventilation and/or engineering controls to prevent exposure to vapours.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sika%20Plastiment%C2%AE%2030%20GHS7.pdf","page":4,"page_end":4,"doc_version":"Revision 10.02.2025, Version 5.0"},"id":"sika-plastiment-30:sds:264632:ppe.engineering_controls:b525b6f3"}},"transport_adg":{"un_number":"Not applicable","class":"Not applicable","text":"UN number : Not applicable","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sika%20Plastiment%C2%AE%2030%20GHS7.pdf","page":8,"page_end":8,"doc_version":"Revision 10.02.2025, Version 5.0"},"id":"sika-plastiment-30:sds:264632:transport_adg:24d6694d"},"latest_for_name":false,"name_matches_product":true}]}