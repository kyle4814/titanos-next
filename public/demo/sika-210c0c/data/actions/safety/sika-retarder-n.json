{"id":"sika-retarder-n","sds":[{"title":"SDS Sika® Retarder N","url":"https://aus.sika.com/content/dam/dms/au01/2/sds-sika-retardern.pdf","revision_date":"26.06.2025","version":"7.0","sds_number":"000000609170","pages":9,"sha256":"4d92a51e0fddddf403723bf653570ae7a1d1107a777b85b279468c2f335ebe48","product_name_on_sds":"Sika® Retarder N","component":null,"revision_age_years":1.3,"older_than_3_years":false,"classification":[{"hazard_class":"Short-term (acute) aquatic hazard","category":"Category 3","text":"Short-term (acute) aquatic hazard : Category 3","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sds-sika-retardern.pdf","page":1,"page_end":1,"doc_version":"Revision 26.06.2025, Version 7.0"},"id":"sika-retarder-n:sds:717612:classification:99b25c25"},{"hazard_class":"Long-term (chronic) aquatic hazard","category":"Category 3","text":"Long-term (chronic) aquatic hazard : Category 3","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sds-sika-retardern.pdf","page":1,"page_end":1,"doc_version":"Revision 26.06.2025, Version 7.0"},"id":"sika-retarder-n:sds:717612:classification:917ba362"}],"signal_word":{"value":"None","text":"Signal word : None","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sds-sika-retardern.pdf","page":1,"page_end":1,"doc_version":"Revision 26.06.2025, Version 7.0"},"id":"sika-retarder-n:sds:717612:signal_word:1022e277"},"hazard_statements":[{"code":"H412","statement":"Harmful to aquatic life with long lasting effects.","text":"H412 Harmful to aquatic life with long lasting effects.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sds-sika-retardern.pdf","page":1,"page_end":1,"doc_version":"Revision 26.06.2025, Version 7.0"},"id":"sika-retarder-n:sds:717612:hazard_statements:b35e8c1c"}],"precautionary_statements":[{"group":"Prevention","code":"P273","statement":"Avoid release to the environment.","text":"P273 Avoid release to the environment.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sds-sika-retardern.pdf","page":1,"page_end":1,"doc_version":"Revision 26.06.2025, Version 7.0"},"id":"sika-retarder-n:sds:717612:precautionary_statements:967777c8"},{"group":"Disposal","code":"P501","statement":"Dispose of contents/ container to an approved waste disposal plant.","text":"P501 Dispose of contents/ container to an approved waste disposal plant.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sds-sika-retardern.pdf","page":1,"page_end":1,"doc_version":"Revision 26.06.2025, Version 7.0"},"id":"sika-retarder-n:sds:717612:precautionary_statements:bc03aec3"}],"storage":[{"label":"Conditions for safe storage","text":"Keep container tightly closed in a dry and well-ventilated place. Store in accordance with local regulations.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sds-sika-retardern.pdf","page":3,"page_end":3,"doc_version":"Revision 26.06.2025, Version 7.0"},"id":"sika-retarder-n:sds:717612:storage:efaa6aee"},{"label":"Materials to avoid","text":"No special restrictions on storage with other products.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sds-sika-retardern.pdf","page":3,"page_end":3,"doc_version":"Revision 26.06.2025, Version 7.0"},"id":"sika-retarder-n:sds:717612:storage:ca8dd6c0"}],"handling":[{"label":"Advice on protection against fire and explosion","text":"Normal measures for preventive fire protection.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sds-sika-retardern.pdf","page":3,"page_end":3,"doc_version":"Revision 26.06.2025, Version 7.0"},"id":"sika-retarder-n:sds:717612:handling:3151dad9"},{"label":"Advice on safe handling","text":"For personal protection see section 8. No special handling advice required. Follow standard hygiene measures when handling chemical products","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sds-sika-retardern.pdf","page":3,"page_end":3,"doc_version":"Revision 26.06.2025, Version 7.0"},"id":"sika-retarder-n:sds:717612:handling:a6f4ac4e"},{"label":"Hygiene measures","text":"When using do not eat or drink. When using do not smoke.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sds-sika-retardern.pdf","page":3,"page_end":3,"doc_version":"Revision 26.06.2025, Version 7.0"},"id":"sika-retarder-n:sds:717612:handling:57e17a76"}],"ppe":{"respiratory":{"label":"Respiratory protection","text":"No special measures required. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sds-sika-retardern.pdf","page":3,"page_end":3,"doc_version":"Revision 26.06.2025, Version 7.0"},"id":"sika-retarder-n:sds:717612:ppe.respiratory:9e406749"},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber/nitrile rubber gloves. Contaminated gloves should be removed.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sds-sika-retardern.pdf","page":3,"page_end":4,"doc_version":"Revision 26.06.2025, Version 7.0"},"id":"sika-retarder-n:sds:717612:ppe.hands:27ef0e7d"},"eyes":{"label":"Eye protection","text":"Safety glasses","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sds-sika-retardern.pdf","page":4,"page_end":4,"doc_version":"Revision 26.06.2025, Version 7.0"},"id":"sika-retarder-n:sds:717612:ppe.eyes:03ca7e7f"},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sds-sika-retardern.pdf","page":4,"page_end":4,"doc_version":"Revision 26.06.2025, Version 7.0"},"id":"sika-retarder-n:sds:717612:ppe.skin_body:8701f223"},"engineering_controls":{"label":"Appropriate engineering controls","text":"Use adequate ventilation and/or engineering controls to prevent exposure to vapours.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sds-sika-retardern.pdf","page":3,"page_end":3,"doc_version":"Revision 26.06.2025, Version 7.0"},"id":"sika-retarder-n:sds:717612:ppe.engineering_controls:b525b6f3"}},"transport_adg":{"un_number":"Not applicable","class":"Not applicable","text":"UN number : Not applicable","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/2/sds-sika-retardern.pdf","page":7,"page_end":7,"doc_version":"Revision 26.06.2025, Version 7.0"},"id":"sika-retarder-n:sds:717612:transport_adg:24d6694d"},"latest_for_name":true,"name_matches_product":true}]}