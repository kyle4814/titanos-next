lease to the environment.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/i/MSDS%20Rugasol%20C%20GHS7.pdf","page":1,"page_end":1,"doc_version":"Revision 22.02.2024, Version 2.0"},"id":"sika-rugasol-c:sds:51e5cc:precautionary_statements:967777c8"},{"group":"Disposal","code":"P501","statement":"Dispose of contents/ container to an approved waste disposal plant.","text":"P501 Dispose of contents/ container to an approved waste disposal plant.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/i/MSDS%20Rugasol%20C%20GHS7.pdf","page":1,"page_end":1,"doc_version":"Revision 22.02.2024, Version 2.0"},"id":"sika-rugasol-c:sds:51e5cc:precautionary_statements:bc03aec3"}],"storage":[{"label":"Conditions for safe storage","text":"Keep container tightly closed in a dry and well-ventilated place. Store in accordance with local regulations.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/i/MSDS%20Rugasol%20C%20GHS7.pdf","page":3,"page_end":3,"doc_version":"Revision 22.02.2024, Version 2.0"},"id":"sika-rugasol-c:sds:51e5cc:storage:efaa6aee"},{"label":"Materials to avoid","text":"No special restrictions on storage with other products.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/i/MSDS%20Rugasol%20C%20GHS7.pdf","page":3,"page_end":3,"doc_version":"Revision 22.02.2024, Version 2.0"},"id":"sika-rugasol-c:sds:51e5cc:storage:ca8dd6c0"}],"handling":[{"label":"Advice on protection against fire and explosion","text":"Normal measures for preventive fire protection.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/i/MSDS%20Rugasol%20C%20GHS7.pdf","page":3,"page_end":3,"doc_version":"Revision 22.02.2024, Version 2.0"},"id":"sika-rugasol-c:sds:51e5cc:handling:3151dad9"},{"label":"Advice on safe handling","text":"For personal protection see section 8. No special handling advice required. Follow standard hygiene measures when handling chemical products","