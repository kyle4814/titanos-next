d":3,"doc_version":"Revision 10.02.2025, Version 4.0"},"id":"sika-stabilizer-4rau:sds:9cc59b:handling:3151dad9"},{"label":"Advice on safe handling","text":"For personal protection see section 8. No special handling advice required. Follow standard hygiene measures when handling chemical products","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/h/MSDS%20Sika%C2%AE%20Stabilizer%204R%20AU%20GHS7.pdf","page":3,"page_end":3,"doc_version":"Revision 10.02.2025, Version 4.0"},"id":"sika-stabilizer-4rau:sds:9cc59b:handling:a6f4ac4e"},{"label":"Hygiene measures","text":"When using do not eat or drink. When using do not smoke.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/h/MSDS%20Sika%C2%AE%20Stabilizer%204R%20AU%20GHS7.pdf","page":3,"page_end":3,"doc_version":"Revision 10.02.2025, Version 4.0"},"id":"sika-stabilizer-4rau:sds:9cc59b:handling:57e17a76"}],"ppe":{"respiratory":{"label":"Respiratory protection","text":"In case of inadequate ventilation wear respiratory protection. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/h/MSDS%20Sika%C2%AE%20Stabilizer%204R%20AU%20GHS7.pdf","page":3,"page_end":3,"doc_version":"Revision 10.02.2025, Version 4.0"},"id":"sika-stabilizer-4rau:sds:9cc59b:ppe.respiratory:1228c275"},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber/nitrile rubber gloves. Contaminated gloves should be removed.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/h/MSDS%20Sika%C2%AE%20Stabilizer%204R%20AU%20GHS7.pdf","page":3,"page_end":3,"doc_version":"Revision 10.02.2025, Version 4.0"},"id":"sika-stabilizer-4rau:sds:9cc59b:ppe.hands:27ef0e7d"},"eyes":{"label":"Eye protection","text":"Safety glasses","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/h/MSDS%20Sika%C2%AE%20Stabilizer%204R%20AU%20GHS7.pdf","page":3,"page_end":3,"doc_version":"Revision 10.02.2025, Version 4.0"},"id":"sika-stabilizer-4rau:sds:9cc59b:ppe.eyes:03ca7e7f"},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/h/MSDS%20Sika%C2%AE%20Stabilizer%204R%20AU%20GHS7.pdf","page":3,"page_end":4,"doc_version":"Revision 10.02.2025, Version 4.0"},"id":"sika-stabilizer-4rau:sds:9cc59b:ppe.skin_body:8701f223"},"engineering_controls":{"label":"Appropriate engineering controls","text":"Use adequate ventilation and/or engineering controls to prevent exposure to vapours.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/h/MSDS%20Sika%C2%AE%20Stabilizer%204R%20AU%20GHS7.pdf","page":3,"page_end":3,"doc_version":"Revision 10.02.2025, Version 4.0"},"id":"sika-stabilizer-4rau:sds:9cc59b:ppe.engineering_controls:b525b6f3"}},"transport_adg":{"un_number":"Not applicable","class":"Not applicable","text":"UN number : Not applicable","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/h/MSDS%20Sika%C2%AE%20Stabilizer%204R%20AU%20GHS7.pdf","page":7,"page_end":7,"doc_version":"Revision 10.02.2025, Version 4.0"},"id":"sika-stabilizer-4rau:sds:9cc59b:transport_adg:24d6694d"},"latest_for_name":true,"name_matches_product":true}]}