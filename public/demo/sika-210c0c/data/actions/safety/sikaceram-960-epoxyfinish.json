.get/a84dd108-cc0b-4080-98af-030fd0e11493_au01/sds-sikaceram-960epoxyfinish.pdf","page":4,"page_end":4,"doc_version":"Revision 18.06.2026, Version 1.1"},"id":"sikaceram-960-epoxyfinish:sds:bbf47e:ppe.eyes:03ca7e7f"},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/a84dd108-cc0b-4080-98af-030fd0e11493_au01/sds-sikaceram-960epoxyfinish.pdf","page":4,"page_end":4,"doc_version":"Revision 18.06.2026, Version 1.1"},"id":"sikaceram-960-epoxyfinish:sds:bbf47e:ppe.skin_body:8701f223"},"engineering_controls":{"label":"Appropriate engineering controls","text":"Provide appropriate exhaust ventilation at places where dust is formed.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/a84dd108-cc0b-4080-98af-030fd0e11493_au01/sds-sikaceram-960epoxyfinish.pdf","page":4,"page_end":4,"doc_version":"Revision 18.06.2026, Version 1.1"},"id":"sikaceram-960-epoxyfinish:sds:bbf47e:ppe.engineering_controls:6cabf1b5"}},"transport_adg":{"un_number":"Not applicable","class":"Not applicable","text":"UN number : Not applicable","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/a84dd108-cc0b-4080-98af-030fd0e11493_au01/sds-sikaceram-960epoxyfinish.pdf","page":7,"page_end":7,"doc_version":"Revision 18.06.2026, Version 1.1"},"id":"sikaceram-960-epoxyfinish:sds:bbf47e:transport_adg:24d6694d"},"latest_for_name":false,"name_matches_product":true}]}