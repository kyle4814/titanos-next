long lasting effects.","text":"H411 Toxic to aquatic life with long lasting effects.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d1ec2d4b-b3a2-4cc5-9094-52846726810e/MSDS%20Sikadur-53%20(A)%20GHS7.pdf","page":1,"page_end":1,"doc_version":"Revision 30.10.2024, Version 3.1"},"id":"sikadur-53:sds:cfce36:hazard_statements:acf7222c"}],"precautionary_statements":[{"group":"Prevention","code":"P261","statement":"Avoid breathing mist or vapours.","text":"P261 Avoid breathing mist or vapours.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d1ec2d4b-b3a2-4cc5-9094-52846726810e/MSDS%20Sikadur-53%20(A)%20GHS7.pdf","page":2,"page_end":2,"doc_version":"Revision 30.10.2024, Version 3.1"},"id":"sikadur-53:sds:cfce36:precautionary_statements:7895cfea"},{"group":"Prevention","code":"P264","statement":"Wash skin thoroughly after handling.","text":"P264 Wash skin thoroughly after handling.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d1ec2d4b-b3a2-4cc5-9094-52846726810e/MSDS%20Sikadur-53%20(A)%20GHS7.pdf","page":2,"page_end":2,"doc_version":"Revision 30.10.2024, Version 3.1"},"id":"sikadur-53:sds:cfce36:precautionary_statements:5d1a9355"},{"group":"Prevention","code":"P272","statement":"Contaminated work clothing should not be allowed out of the workplace.","text":"P272 Contaminated work clothing should not be allowed out of the workplace.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d1ec2d4b-b3a2-4cc5-9094-52846726810e/MSDS%20Sikadur-53%20(A)%20GHS7.pdf","page":2,"page_end":2,"doc_version":"Revision 30.10.2024, Version 3.1"},"id":"sikadur-53:sds:cfce36:precautionary_statements:2222e81e"},{"group":"Prevention","code":"P273","statement":"Avoid release to the environment.","text":"P273 Avoid release to the environment.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d1ec2d4b-b3a2-4cc5-9094-52846726810e/MSDS%20Sikadur-53%20(A)%20GHS7.pdf","page":2,"page_end":2,"doc_version":"Revision 30.10.2024, Version 3.1"},"id":"sikadur-53:sds:cfce36:precautionary_statements:967777c8"},{"group":"Prevention","code":"P280","statement":"Wear protective gloves/ eye protection/ face protection.","text":"P280 Wear protective gloves/ eye protection/ face protection.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d1ec2d4b-b3a2-4cc5-9094-52846726810e/MSDS%20Sikadur-53%20(A)%20GHS7.pdf","page":2,"page_end":2,"doc_version":"Revision 30.10.2024, Version 3.1"},"id":"sikadur-53:sds:cfce36:precautionary_statements:8cf8d66f"},{"group":"Response","code":"P302 + P352","statement":"IF ON SKIN: Wash with plenty of water.","text":"P302 + P352 IF ON SKIN: Wash with plenty of water.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d1ec2d4b-b3a2-4cc5-9094-52846726810e/MSDS%20Sikadur-53%20(A)%20GHS7.pdf","page":2,"page_end":2,"doc_version":"Revision 30.10.2024, Version 3.1"},"id":"sikadur-53:sds:cfce36:precautionary_statements:153d8276"},{"group":"Response","code":"P305 + P351 + P338 + P310","statement":"IF IN EYES: Rinse cautiously with water for several minutes. Remove contact lenses, if present and easy to do. Continue rinsing. Immediately call a POISON CENTER/ doctor.","text":"P305 + P351 + P338 + P310 IF IN EYES: Rinse cautiously with water for several minutes. Remove contact lenses, if present and easy to do. Continue rinsing. Immediately call a POISON CENTER/ doctor.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d1ec2d4b-b3a2-4cc5-9094-52846726810e/MSDS%20Sikadur-53%20(A)%20GHS7.pdf","page":2,"page_end":2,"doc_version":"Revision 30.10.2024, Version 3.1"},"id":"sikadur-53:sds:cfce36:precautionary_statements:ecd5dbac"},{"group":"Response","code":"P333 + P313","statement":"If skin irritation or rash occurs: Get medical advice/ attention.","text":"P333 + P313 If skin irritation or rash occurs: Get medical advice/ attention.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d1ec2d4b-b3a2-4cc5-9094-52846726810e/MSDS%20Sikadur-53%20(A)%20GHS7.pdf","page":2,"page_end":2,"doc_version":"Revision 30.10.2024, Version 3.1"},"id":"sikadur-53:sds:cfce36:precautionary_statements:0c2e03d6"},{"group":"Response","code":"P362 + P364","statement":"Take off contaminated clothing and wash it before reuse.","text":"P362 + P364 Take off contaminated clothing and wash it before reuse.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d1ec2d4b-b3a2-4cc5-9094-52846726810e/MSDS%20Sikadur-53%20(A)%20GHS7.pdf","page":2,"page_end":2,"doc_version":"Revision 30.10.2024, Version 3.1"},"id":"sikadur-53:sds:cfce36:precautionary_statements:4732b4f8"},{"group":"Response","code":"P391","statement":"Collect spillage.","text":"P391 Collect spillage.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d1ec2d4b-b3a2-4cc5-9094-52846726810e/MSDS%20Sikadur-53%20(A)%20GHS7.pdf","page":2,"page_end":2,"doc_version":"Revision 30.10.2024, Version 3.1"},"id":"sikadur-53:sds:cfce36:precautionary_statements:ea864d16"},{"group":"Disposal","code":"P501","statement":"Dispose of contents/ container to an approved waste disposal plant.","text":"P501 Dispose of contents/ container to an approved waste disposal plant.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d1ec2d4b-b3a2-4cc5-9094-52846726810e/MSDS%20Sikadur-53%20(A)%20GHS7.pdf","page":2,"page_end":2,"doc_version":"Revision 30.10.2024, Version 3.1"},"id":"sikadur-53:sds:cfce36:precautionary_statements:bc03aec3"}],"storage":[{"label":"Conditions for safe storage","text":"Keep container tightly closed in a dry and well-ventilated place. Store in accordance with local regulations.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d1ec2d4b-b3a2-4cc5-9094-52846726810e/MSDS%20Sikadur-53%20(A)%20GHS7.pdf","page":4,"page_end":4,"doc_version":"Revision 30.10.2024, Version 3.1"},"id":"sikadur-53:sds:cfce36:storage:efaa6aee"}],"handling":[{"label":"Advice on protection against fire and explosion","text":"Normal measures for preventive fire protection.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d1ec2d4b-b3a2-4cc5-9094-52846726810e/MSDS%20Sikadur-53%20(A)%20GHS7.pdf","page":4,"page_end":4,"doc_version":"Revision 30.10.2024, Version 3.1"},"id":"sikadur-53:sds:cfce36:handling:3151dad9"},{"label":"Advice on safe handling","text":"Avoid exceeding the given occupational exposure limits (see section 8). Do not get in eyes, on skin, or on clothing. For personal protection see section 8. Persons with a history of skin sensitisation problems or asthma, allergies, chronic or recurrent respiratory disease should not be employed in any process in which this mixture is being used. Smoking, eating and drinking should be prohibited in the application area. Follow standard hygiene measures when handling chemical products","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d1ec2d4b-b3a2-4cc5-9094-52846726810e/MSDS%20Sikadur-53%20(A)%20GHS7.pdf","page":4,"page_end":4,"doc_version":"Revision 30.10.2024, Version 3.1"},"id":"sikadur-53:sds:cfce36:handling:de03b4b8"},{"label":"Hygiene measures","text":"Handle in accordance with good industrial hygiene and safety practice. When using do not eat or drink. When using do not smoke. Wash hands before breaks and at the end of workday.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d1ec2d4b-b3a2-4cc5-9094-52846726810e/MSDS%20Sikadur-53%20(A)%20GHS7.pdf","page":4,"page_end":4,"doc_version":"Revision 30.10.2024, Version 3.1"},"id":"sikadur-53:sds:cfce36:handling:ef026cd3"}],"ppe":{"respiratory":{"label":"Respiratory protection","text":"In case of inadequate ventilation wear respiratory protection. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d1ec2d4b-b3a2-4cc5-9094-52846726810e/MSDS%20Sikadur-53%20(A)%20GHS7.pdf","page":5,"page_end":5,"doc_version":"Revision 30.10.2024, Version 3.1"},"id":"sikadur-53:sds:cfce36:ppe.respiratory:1228c275"},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber/nitrile rubber gloves. Contaminated gloves should be removed.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d1ec2d4b-b3a2-4cc5-9094-52846726810e/MSDS%20Sikadur-53%20(A)%20GHS7.pdf","page":5,"page_end":5,"doc_version":"Revision 30.10.2024, Version 3.1"},"id":"sikadur-53:sds:cfce36:ppe.hands:27ef0e7d"},"eyes":{"label":"Eye protection","text":"Safety glasses","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d1ec2d4b-b3a2-4cc5-9094-52846726810e/MSDS%20Sikadur-53%20(A)%20GHS7.pdf","page":5,"page_end":5,"doc_version":"Revision 30.10.2024, Version 3.1"},"id":"sikadur-53:sds:cfce36:ppe.eyes:03ca7e7f"},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d1ec2d4b-b3a2-4cc5-9094-52846726810e/MSDS%20Sikadur-53%20(A)%20GHS7.pdf","page":5,"page_end":5,"doc_version":"Revision 30.10.2024, Version 3.1"},"id":"sikadur-53:sds:cfce36:ppe.skin_body:8701f223"},"engineering_controls":{"label":"Appropriate engineering controls","text":"Use adequate ventilation and/or engineering controls to prevent exposure to vapours.","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d1ec2d4b-b3a2-4cc5-9094-52846726810e/MSDS%20Sikadur-53%20(A)%20GHS7.pdf","page":4,"page_end":4,"doc_version":"Revision 30.10.2024, Version 3.1"},"id":"sikadur-53:sds:cfce36:ppe.engineering_controls:b525b6f3"}},"transport_adg":{"un_number":"UN 3077","class":"9 Packing","text":"UN number : UN 3077","source":{"doc_type":"SDS","url":"https://aus.sika.com/dms/getdocument.get/d1ec2d4b-b3a2-4cc5-9094-52846726810e/MSDS%20Sikadur-53%20(A)%20GHS7.pdf","page":9,"page_end":9,"doc_version":"Revision 30.10.2024, Version 3.1"},"id":"sikadur-53:sds:cfce36:transport_adg:357995e8"},"latest_for_name":true,"name_matches_product":true}]}