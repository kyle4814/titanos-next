{"id":"sikafloor-304-w","sds":[{"title":"SDS Sikafloor®-304 W Part A","url":"https://aus.sika.com/content/dam/dms/au01/0/sds-sikafloor-304wparta.pdf","revision_date":"21.07.2025","version":"7.0","sds_number":"000000604358","pages":10,"sha256":"b8e31e10173657f0974c0d1913cb509f10f781f81d731daf2d1365821b075b4f","product_name_on_sds":"Sikafloor®-304 W Part A","component":"Part A","revision_age_years":1.3,"older_than_3_years":false,"classification":[{"hazard_class":"Short-term (acute) aquatic hazard","category":"Category 3","text":"Short-term (acute) aquatic hazard : Category 3","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/0/sds-sikafloor-304wparta.pdf","page":1,"page_end":1,"doc_version":"Revision 21.07.2025, Version 7.0"},"id":"sikafloor-304-w:sds:c0432b:classification:99b25c25"}],"signal_word":{"value":"None","text":"Signal word : None","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/0/sds-sikafloor-304wparta.pdf","page":1,"page_end":1,"doc_version":"Revision 21.07.2025, Version 7.0"},"id":"sikafloor-304-w:sds:c0432b:signal_word:1022e277"},"hazard_statements":[{"code":"H402","statement":"Harmful to aquatic life.","text":"H402 Harmful to aquatic life.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/0/sds-sikafloor-304wparta.pdf","page":1,"page_end":1,"doc_version":"Revision 21.07.2025, Version 7.0"},"id":"sikafloor-304-w:sds:c0432b:hazard_statements:5f4d93b1"}],"precautionary_statements":[{"group":"Prevention","code":"P273","statement":"Avoid release to the environment.","text":"P273 Avoid release to the environment.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/0/sds-sikafloor-304wparta.pdf","page":1,"page_end":1,"doc_version":"Revision 21.07.2025, Version 7.0"},"id":"sikafloor-304-w:sds:c0432b:precautionary_statements:967777c8"},{"group":"Disposal","code":"P501","statement":"Dispose of contents/ container to an approved waste disposal plant.","text":"P501 Dispose of contents/ container to an approved waste disposal plant.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/0/sds-sikafloor-304wparta.pdf","page":1,"page_end":1,"doc_version":"Revision 21.07.2025, Version 7.0"},"id":"sikafloor-304-w:sds:c0432b:precautionary_statements:bc03aec3"}],"storage":[{"label":"Conditions for safe storage","text":"Keep container tightly closed in a dry and well-ventilated place. Store in accordance with local regulations.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/0/sds-sikafloor-304wparta.pdf","page":3,"page_end":3,"doc_version":"Revision 21.07.2025, Version 7.0"},"id":"sikafloor-304-w:sds:c0432b:storage:efaa6aee"}],"handling":[{"label":"Advice on protection against fire and explosion","text":"Normal measures for preventive fire protection.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/0/sds-sikafloor-304wparta.pdf","page":3,"page_end":3,"doc_version":"Revision 21.07.2025, Version 7.0"},"id":"sikafloor-304-w:sds:c0432b:handling:3151dad9"},{"label":"Advice on safe handling","text":"For personal protection see section 8. Follow standard hygiene measures when handling chemical products","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/0/sds-sikafloor-304wparta.pdf","page":3,"page_end":3,"doc_version":"Revision 21.07.2025, Version 7.0"},"id":"sikafloor-304-w:sds:c0432b:handling:d463acde"},{"label":"Hygiene measures","text":"Handle in accordance with good industrial hygiene and safety practice. When using do not eat or drink. When using do not smoke. Wash hands before breaks and at the end of workday.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/0/sds-sikafloor-304wparta.pdf","page":3,"page_end":3,"doc_version":"Revision 21.07.2025, Version 7.0"},"id":"sikafloor-304-w:sds:c0432b:handling:ef026cd3"}],"ppe":{"respiratory":{"label":"Respiratory protection","text":"No special measures required. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/0/sds-sikafloor-304wparta.pdf","page":3,"page_end":4,"doc_version":"Revision 21.07.2025, Version 7.0"},"id":"sikafloor-304-w:sds:c0432b:ppe.respiratory:9e406749"},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber/nitrile rubber gloves. Contaminated gloves should be removed.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/0/sds-sikafloor-304wparta.pdf","page":4,"page_end":4,"doc_version":"Revision 21.07.2025, Version 7.0"},"id":"sikafloor-304-w:sds:c0432b:ppe.hands:27ef0e7d"},"eyes":{"label":"Eye protection","text":"Safety glasses","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/0/sds-sikafloor-304wparta.pdf","page":4,"page_end":4,"doc_version":"Revision 21.07.2025, Version 7.0"},"id":"sikafloor-304-w:sds:c0432b:ppe.eyes:03ca7e7f"},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/0/sds-sikafloor-304wparta.pdf","page":4,"page_end":4,"doc_version":"Revision 21.07.2025, Version 7.0"},"id":"sikafloor-304-w:sds:c0432b:ppe.skin_body:8701f223"},"engineering_controls":{"label":"Appropriate engineering controls","text":"Use adequate ventilation and/or engineering controls to prevent exposure to vapours.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/0/sds-sikafloor-304wparta.pdf","page":3,"page_end":3,"doc_version":"Revision 21.07.2025, Version 7.0"},"id":"sikafloor-304-w:sds:c0432b:ppe.engineering_controls:b525b6f3"}},"transport_adg":{"un_number":"Not applicable","class":"Not applicable","text":"UN number : Not applicable","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/0/sds-sikafloor-304wparta.pdf","page":8,"page_end":8,"doc_version":"Revision 21.07.2025, Version 7.0"},"id":"sikafloor-304-w:sds:c0432b:transport_adg:24d6694d"},"latest_for_name":true,"name_matches_product":true}]}