}],"precautionary_statements":[{"group":"Prevention","code":"P273","statement":"Avoid release to the environment.","text":"P273 Avoid release to the environment.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/m/SikaPlast%C2%AE-82%20SCM%20Impact%20GHS7.pdf","page":1,"page_end":1,"doc_version":"Revision 14.10.2024, Version 1.0"},"id":"sikaplast-82-scmimpact:sds:ff13ba:precautionary_statements:967777c8"},{"group":"Disposal","code":"P501","statement":"Dispose of contents/ container to an approved waste disposal plant.","text":"P501 Dispose of contents/ container to an approved waste disposal plant.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/m/SikaPlast%C2%AE-82%20SCM%20Impact%20GHS7.pdf","page":1,"page_end":1,"doc_version":"Revision 14.10.2024, Version 1.0"},"id":"sikaplast-82-scmimpact:sds:ff13ba:precautionary_statements:bc03aec3"}],"storage":[{"label":"Conditions for safe storage","text":"Keep container tightly closed in a dry and well-ventilated place. Store in accordance with local regulations.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/m/SikaPlast%C2%AE-82%20SCM%20Impact%20GHS7.pdf","page":3,"page_end":3,"doc_version":"Revision 14.10.2024, Version 1.0"},"id":"sikaplast-82-scmimpact:sds:ff13ba:storage:efaa6aee"},{"label":"Materials to avoid","text":"No special restrictions on storage with other products.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/m/SikaPlast%C2%AE-82%20SCM%20Impact%20GHS7.pdf","page":3,"page_end":3,"doc_version":"Revision 14.10.2024, Version 1.0"},"id":"sikaplast-82-scmimpact:sds:ff13ba:storage:ca8dd6c0"}],"handling":[{"label":"Advice on protection against fire and explosion","text":"Normal measures for preventive fire protection.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/m/SikaPlast%C2%AE-82%20SCM%20Impact%20GHS7.pdf","page":3,"page_end":3,"doc_version":"Revision 14.10.2024, Version 1.0"},"id":"sikaplast-82-scmimpact:sds:ff13ba:handling:3151dad9"},{"label":"Advice on safe handling","text":"For personal protection see section 8. No special handling advice required. Follow standard hygiene measures when handling chemical products","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/m/SikaPlast%C2%AE-82%20SCM%20Impact%20GHS7.pdf","page":3,"page_end":3,"doc_version":"Revision 14.10.2024, Version 1.0"},"id":"sikaplast-82-scmimpact:sds:ff13ba:handling:a6f4ac4e"},{"label":"Hygiene measures","text":"When using do not eat or drink. When using do not smoke.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/m/SikaPlast%C2%AE-82%20SCM%20Impact%20GHS7.pdf","page":3,"page_end":3,"doc_version":"Revision 14.10.2024, Version 1.0"},"id":"sikaplast-82-scmimpact:sds:ff13ba:handling:57e17a76"}],"ppe":{"respiratory":{"label":"Respiratory protection","text":"No special measures required. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/m/SikaPlast%C2%AE-82%20SCM%20Impact%20GHS7.pdf","page":3,"page_end":3,"doc_version":"Revision 14.10.2024, Version 1.0"},"id":"sikaplast-82-scmimpact:sds:ff13ba:ppe.respiratory:9e406749"},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber/nitrile rubber gloves. Contaminated gloves should be removed.","source":{"doc_type":"SDS","url":"https://aus.sika.com/content/dam/dms/au01/m/SikaPlast%C2%AE-82%20SCM%20Impact%20GHS7.pdf","page":3,"page_end":3,"doc_version":"Revision 14.10.2024, Version 1.0"},"id":"sikaplast-82-scmimpact:sds:ff13ba:ppe.hands:27ef0e7d"},"eyes":{"label":"Eye protection",