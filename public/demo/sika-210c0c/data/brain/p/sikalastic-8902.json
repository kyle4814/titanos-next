{"v":1,"id":"sikalastic-8902","n":"Sikalastic-8902","b":"Sika","u":"https://aus.sika.com/en/construction/waterproofing/spray-applied-membranes/sikalastic-8902.html","c":"construction/waterproofing/spray-applied-membranes","d":{"t":"Polyurethane tack coat for Sikalastic-827 HT hot melt pellets","s":"Sikalastic-8902 is a 2-part, polyurethane, transparent tack coat for Sikalastic-827 HT hot melt pellets","a":["Easy to apply","Applied by brush, roller or airless spray","Heat resistant to mastic asphalt application"],"us":["Bonding Sikalastic-827 HT hot melt pellets on Sikalastic-851 and Sikalastic-8800 waterproofing membranes"],"pk":"Part A | 20,25 kg Part B | 4,75 kg Refer to current price list for packaging variations","sec":[{"l":"APPROVALS / CERTIFICATES","t":"HAPAS Certificate, Sikalastic-851-8902-827, BBA, Certificate No.15/H237","g":"Sustainability / Certifications / Approvals"},{"l":"Composition","t":"Polyurethane","g":"Product Information"},{"l":"Shelf life","t":"12 months from date of production","g":"Product Information"},{"l":"Storage conditions","t":"The product must be stored in original, unopened and undamaged sealed packaging in dry conditions at temperatures between +5 °C and +30 °C. Always refer to packaging.","g":"Product Information"},{"l":"Density","t":"~1,39 kg/l (mixed resin, at +23 °C)","g":"Product Information"},{"l":"Tensile strength","t":">10 N/m² | (DIN 53504)","g":"Technical Information"},{"l":"Temperature resistance","t":"Exposure | Dry heat Short term | up to +240 °C max.","g":"Technical Information"},{"l":"Mixing ratio","t":"81:19 by weight","g":"Application Information"},{"l":"Layer thickness","t":"~0,5 mm","g":"Application Information"},{"l":"Ambient air temperature","t":"+5 °C min. / +40 °C max.","g":"Application Information"},{"l":"Relative air humidity","t":"< 80 %","g":"Application Information"},{"l":"Dew point","t":"Substrate temperature must be min +3 °C above dew point, beware of condensation","g":"Application Information"},{"l":"Substrate temperature","t":"+5 °C min. / +50 °C max.","g":"Application Information"},{"l":"Pot Life","t":"~25 minutes at +23 °C","g":"Application Information"},{"l":"Waiting time to overcoating","t":"Minimum waiting time before paving asphalt overlay Temperature | Minimum | Maximum +10 °C | 24 hours | 1 week +20 °C | 16 hours | 1 week +30 °C | 12 hours | 1 week","g":"Application Information"},{"l":"Consumption","t":"~0,75 kg/m²","g":"Consumption"},{"l":"SUBSTRATE QUALITY","t":"Refer to Sikalastic-851 or Sikalastic-8800 Product Data Sheets","g":"Application steps"},{"l":"SUBSTRATE PREPARATION","t":"Apply Sikalastic-8902 within the indicated overcoating time of the applied waterproofing membrane. No further substrate preparation is necessary. If the overcoating time of the applied waterproofing membrane is exceeded, the surface must be prepared mechanically by a light grinding and application of the Sikalastic-810 adhesion promoter.","g":"Application steps"},{"l":"MIXING","t":"Stir part A for 3 minutes using a low speed single paddle electric stirrer (300–400 r/min). Add all of part B to part A and mix continuously until a uniform consistency has been achieved. To ensure thorough mixing pour materials into a clean container and mix again for at least 1,0 minute. Over mixing must be avoided to minimise air entrainment. During the final mixing stage, scrape down the sides and bottom of the mixing container with a flat or straight edge trowel at least once to ensure complete mixing. Mix full units only. Mixing time for A+B = 4,0 minutes.","g":"Application steps"},{"l":"CLEANING OF EQUIPMENT","t":"Clean all tools and application equipment with Thinner C immediately after use. Hardened/cured material can only be mechanically removed.","g":"Application steps"}]},"dc":[{"id":"d-ce8700591f","t":"Sikalastic-8902","ty":"product_data_sheet","tl":"Product Data Sheet (PDS)","v":"31/03/2023","u":"https://aus.sika.com/content/dam/dms/au01/6/sikalastic-8902.pdf","ok":true,"f":"PDF"}],"r":{"status":"published","ds":{"url":"https://aus.sika.com/content/dam/dms/au01/6/sikalastic-8902.pdf","doc_version":"April 2023, Version 02.01","pages":3,"sha256":"9936aae62d106f551e118c86a2044412888a7f82156924ac55d6025ac52ba4a8","listed_version_date":"31/03/2023"},"facts":{"consumption":[{"id":"sikalastic-8902:consumption:58aea1a0","label":"Consumption","text":"~0,75 kg/m²","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/6/sikalastic-8902.pdf","v":"April 2023, Version 02.01","p":1,"sec":"Consumption"},"parsed":{"model":"per_area","min":0.75,"max":0.75,"unit":"kg","area_unit":"m2","per":null,"basis_stated":true,"base_unit":"kg/m2","base_min":0.75,"base_max":0.75},"calc":true}],"coats":[],"layer_thickness":[{"id":"sikalastic-8902:layer_thickness:ee981c36","label":"Layer thickness","text":"~0,5 mm","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/6/sikalastic-8902.pdf","v":"April 2023, Version 02.01","p":2,"sec":"Application Information"},"parsed":{"values":[{"qualifier":null,"min":0.5,"max":0.5,"unit":"mm"}]}}],"mix_ratio":[{"id":"sikalastic-8902:mix_ratio:f9b7fb90","label":"Mixing ratio","text":"81:19 by weight","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/6/sikalastic-8902.pdf","v":"April 2023, Version 02.01","p":1,"sec":"Application Information"}}]}},"tm":{"open_time":[],"cure_times":[],"pot_life":[{"id":"sikalastic-8902:pot_life:401d5e37","label":"Pot Life","text":"~25 minutes at +23 °C","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/6/sikalastic-8902.pdf","v":"April 2023, Version 02.01","p":2,"sec":"Application Information"},"parsed":{"model":"duration","min":25,"max":25,"unit":"min","qualifier":"~","at_c":23}}],"recoat_times":[{"id":"sikalastic-8902:recoat_times:7adb8dde","label":"Waiting time to overcoating","text":"+10 °C | 24 hours | 1 week","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/6/sikalastic-8902.pdf","v":"April 2023, Version 02.01","p":2,"sec":"Application Information"},"parsed":{"model":"time_table_row","at_c":10,"condition":"+10 °C","columns":[{"column":"minimum","min":24,"max":24,"unit":"h","text":"24 hours"},{"column":"maximum","min":1,"max":1,"unit":"wk","text":"1 week"}],"header":["Temperature","Minimum","Maximum"]},"table_header":"Temperature | Minimum | Maximum"},{"id":"sikalastic-8902:recoat_times:54fefa54","label":"Waiting time to overcoating","text":"+20 °C | 16 hours | 1 week","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/6/sikalastic-8902.pdf","v":"April 2023, Version 02.01","p":2,"sec":"Application Information"},"parsed":{"model":"time_table_row","at_c":20,"condition":"+20 °C","columns":[{"column":"minimum","min":16,"max":16,"unit":"h","text":"16 hours"},{"column":"maximum","min":1,"max":1,"unit":"wk","text":"1 week"}],"header":["Temperature","Minimum","Maximum"]},"table_header":"Temperature | Minimum | Maximum"},{"id":"sikalastic-8902:recoat_times:1905279e","label":"Waiting time to overcoating","text":"+30 °C | 12 hours | 1 week","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/6/sikalastic-8902.pdf","v":"April 2023, Version 02.01","p":2,"sec":"Application Information"},"parsed":{"model":"time_table_row","at_c":30,"condition":"+30 °C","columns":[{"column":"minimum","min":12,"max":12,"unit":"h","text":"12 hours"},{"column":"maximum","min":1,"max":1,"unit":"wk","text":"1 week"}],"header":["Temperature","Minimum","Maximum"]},"table_header":"Temperature | Minimum | Maximum"}]},"cp":[{"id":"sikalastic-8902:suitability:4fa7af2f","type":"suitability","pol":"yes","cond":true,"tags":{"substrate":["asphalt"]},"text":"If the paving asphalt cannot take place within 3 days, the entire surface must be covered using suitable protective measures to prevent dirt and moisture contamination in addition to preventing mechanical damage of the pellets due to construction traffic.","heading":"IMPORTANT CONSIDERATIONS","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/6/sikalastic-8902.pdf","v":"April 2023, Version 02.01","p":2}}],"sf":{"status":"not published","sds":[]},"sp":{"ds":{"url":"https://aus.sika.com/content/dam/dms/au01/6/sikalastic-8902.pdf","title":"Sikalastic®-8902","edition":"April 2023, Version 02.01","version":"02.01","issued":"April 2023"},"std":[{"citation":"DIN 53504","section":"TECHNICAL INFORMATION","page":1,"context":"(DIN 53504)"}]}}