{"v":1,"id":"sikaseal-appliancesealant","n":"SikaSeal Appliance Sealant","b":"Sika","u":"https://aus.sika.com/en/construction/sealants-adhesives/specialty-sealants/sikaseal-appliancesealant.html","c":"construction/sealants-adhesives/specialty-sealants","d":{"t":"Premium one-component room temperature vulcanising silicone sealant","s":"SikaSeal Appliance Silicone Sealant is a premium one-component room temperature vulcanising (RTV) silicone rubber designed for flexible gasketing and sealing applications. SikaSeal Appliance Silicone Sealant forms a tough but flexible seal of all shapes and sizes and fills any surface voids. The cured product can withstand vibration, weathering, temperature extremes, water oil and grease without hardening, shrinking or cracking.","a":["High temperature resitance (-50°c to 250°c)","Excellent adhesion","Heat proof","Gap filling properties","Vibration resistant","Highly versatile","Excellent resistance to aging, shrinkage, cracking and disclouration."],"us":["Fridge and freezer sealing","Pizza oven sealing","Oven sealing","Aluminium","Glass"],"pk":"300ml Cartridge, 12 cartridges per box","sec":[{"l":"Composition","t":"1-C Silicone (acetoxy)","g":"Product Information"},{"l":"Shelf life","t":"18 months from date of production if in undamaged and unopened original sealed containers and stored according to the storage conditions.","g":"Product Information"},{"l":"Storage conditions","t":"Must be stored in dry conditions and protected from direct sunlight at temperatures between +10ºC and +25ºC.","g":"Product Information"},{"l":"Density","t":"~0.98 Kg/l (uncured)","g":"Product Information"},{"l":"Shore A hardness","t":"~22","g":"Technical Information"},{"l":"Secant tensile modulus","t":"~1.05 MPa","g":"Technical Information"},{"l":"Tensile adhesion strength","t":"~1.0 N/mm2","g":"Technical Information"},{"l":"Ambient air temperature","t":"+5°c to +45°c","g":"Application Information"},{"l":"Curing time","t":"~24 hours","g":"Application Information"},{"l":"Skinning time","t":"~10 minutes","g":"Application Information"},{"l":"Tack free time","t":"~20 minutes","g":"Application Information"},{"l":"SUBSTRATE PREPARATION","t":"Ensure all surfaces are clean, dry and free from dust, grease and loose material. Remove all old gasket material from surfaces before cleaning with a residue-free solvent and allowing to completely dry.","g":"Application steps"},{"l":"CLEANING OF EQUIPMENT","t":"Uncured, excess SikaSeal Appliance may be removed with Sika Remover-208 or another suitable solvent. Once cured, the excess sealant can be trimmed away from the edges with a knife.","g":"Application steps"}]},"dc":[{"id":"d-9c29a9f9c0","t":"SikaSeal Appliance Sealant","ty":"product_data_sheet","tl":"Product Data Sheet (PDS)","v":"31/03/2023","u":"https://aus.sika.com/content/dam/dms/au01/1/sikaseal_appliancesealant.pdf","ok":true,"f":"PDF"},{"id":"d-c305f76fe1","t":"SikaSeal Appliance Sealant","ty":"safety_data_sheet","tl":"Safety Data Sheet (SDS)","v":"23/06/2025","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","ok":true,"f":"PDF"}],"r":{"status":"not published","ds":{"url":"https://aus.sika.com/content/dam/dms/au01/1/sikaseal_appliancesealant.pdf","doc_version":"April 2023, Version 01.02","pages":2,"sha256":"3306d3fac8f0408ad5028491a2f84d8f6e5321b17b471a4747596f4b02362c50","listed_version_date":"31/03/2023"},"facts":{"consumption":[],"coats":[],"layer_thickness":[],"mix_ratio":[]}},"tm":{"skin_tack_times":[{"id":"sikaseal-appliancesealant:skin_tack_times:127132e1","label":"Skinning time","text":"~10 minutes","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/1/sikaseal_appliancesealant.pdf","v":"April 2023, Version 01.02","p":2,"pe":2,"sec":"Application Information"},"parsed":{"model":"duration","min":10,"max":10,"unit":"min","qualifier":"~","at_c":null},"calc":false,"at":null},{"id":"sikaseal-appliancesealant:skin_tack_times:ccf1a28f","label":"Tack free time","text":"~20 minutes","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/1/sikaseal_appliancesealant.pdf","v":"April 2023, Version 01.02","p":2,"pe":2,"sec":"Application Information"},"parsed":{"model":"duration","min":20,"max":20,"unit":"min","qualifier":"~","at_c":null},"calc":false,"at":null}],"cure_times":[{"id":"sikaseal-appliancesealant:cure_times:6e0b29cf","label":"Curing time","text":"~24 hours","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/1/sikaseal_appliancesealant.pdf","v":"April 2023, Version 01.02","p":2,"pe":2,"sec":"Application Information"},"parsed":{"model":"duration","min":24,"max":24,"unit":"h","qualifier":"~","at_c":null},"calc":false,"at":null}]},"pk":[{"id":"sikaseal-appliancesealant:pack_sizes:6c39017d","label":"Packaging","text":"300ml Cartridge, 12 cartridges per box","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/1/sikaseal_appliancesealant.pdf","v":"April 2023, Version 01.02","p":1,"pe":1,"sec":"Product"},"parsed":{"sizes":[{"amount":300,"unit":"mL","container":"cartridge","component":null}]},"calc":false,"at":null}],"cp":[{"id":"sikaseal-appliancesealant:restriction:4792fdf5","type":"restriction","pol":"no","cond":false,"tags":{},"text":"Limitations SikaSeal® Appliance is not recommended for use in applications where it will be permanently exposed to temperatures exceeding 250°C.","heading":"IMPORTANT CONSIDERATIONS","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/1/sikaseal_appliancesealant.pdf","v":"April 2023, Version 01.02","p":2,"pe":2,"sec":"IMPORTANT CONSIDERATIONS"},"pm":[]},{"id":"sikaseal-appliancesealant:restriction:849e8f44","type":"restriction","pol":"no","cond":false,"tags":{},"text":"Not suitable for exposure to or contact with fuels.","heading":"IMPORTANT CONSIDERATIONS","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/1/sikaseal_appliancesealant.pdf","v":"April 2023, Version 01.02","p":2,"pe":2,"sec":"IMPORTANT CONSIDERATIONS"},"pm":[]}],"sf":{"status":"published","sds":[{"title":"SikaSeal Appliance Sealant","url":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","revision_date":"05.02.2025","version":"5.0","sds_number":"000000612628","pages":9,"classification":[{"hazard_class":"Flammable liquids","category":"Category 4","text":"Flammable liquids : Category 4","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":1,"pe":1,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:classification:6b6d1a9a"},{"hazard_class":"Skin corrosion/irritation","category":"Category 2","text":"Skin corrosion/irritation : Category 2","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":1,"pe":1,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:classification:010edf39"},{"hazard_class":"Serious eye damage/eye irritation","category":"Category 2A","text":"Serious eye damage/eye irritation : Category 2A","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":1,"pe":1,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:classification:13c22001"}],"hazard_statements":[{"code":"H227","statement":"Combustible liquid.","text":"H227 Combustible liquid.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":1,"pe":1,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:hazard_statements:0f901f4f"},{"code":"H315","statement":"Causes skin irritation.","text":"H315 Causes skin irritation.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":1,"pe":1,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:hazard_statements:272833a5"},{"code":"H319","statement":"Causes serious eye irritation.","text":"H319 Causes serious eye irritation.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":1,"pe":1,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:hazard_statements:0bafcf6b"}],"precautionary_statements":[{"group":"Prevention","code":"P210","statement":"Keep away from heat, hot surfaces, sparks, open flames and other ignition sources. No smoking.","text":"P210 Keep away from heat, hot surfaces, sparks, open flames and other ignition sources. No smoking.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":1,"pe":1,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:precautionary_statements:010c5ba3"},{"group":"Prevention","code":"P264","statement":"Wash skin thoroughly after handling.","text":"P264 Wash skin thoroughly after handling.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":1,"pe":1,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:precautionary_statements:5d1a9355"},{"group":"Prevention","code":"P280","statement":"Wear protective gloves/ protective clothing/ eye protection/ face protection/ hearing protection.","text":"P280 Wear protective gloves/ protective clothing/ eye protection/ face protection/ hearing protection.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":1,"pe":1,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:precautionary_statements:15fc2146"},{"group":"Response","code":"P302 + P352","statement":"IF ON SKIN: Wash with plenty of water.","text":"P302 + P352 IF ON SKIN: Wash with plenty of water.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":1,"pe":1,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:precautionary_statements:153d8276"},{"group":"Response","code":"P305 + P351 + P338","statement":"IF IN EYES: Rinse cautiously with water for several minutes. Remove contact lenses, if present and easy to do. Continue rinsing.","text":"P305 + P351 + P338 IF IN EYES: Rinse cautiously with water for several minutes. Remove contact lenses, if present and easy to do. Continue rinsing.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":1,"pe":2,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:precautionary_statements:063cfb57"},{"group":"Response","code":"P332 + P313","statement":"If skin irritation occurs: Get medical advice/ attention.","text":"P332 + P313 If skin irritation occurs: Get medical advice/ attention.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":2,"pe":2,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:precautionary_statements:48ff9c32"},{"group":"Response","code":"P337 + P313","statement":"If eye irritation persists: Get medical advice/ attention.","text":"P337 + P313 If eye irritation persists: Get medical advice/ attention.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":2,"pe":2,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:precautionary_statements:3c696809"},{"group":"Response","code":"P362 + P364","statement":"Take off contaminated clothing and wash it before reuse.","text":"P362 + P364 Take off contaminated clothing and wash it before reuse.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":2,"pe":2,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:precautionary_statements:4732b4f8"},{"group":"Response","code":"P370 + P378","statement":"In case of fire: Use dry sand, dry chemical or alcohol-resistant foam to extinguish.","text":"P370 + P378 In case of fire: Use dry sand, dry chemical or alcohol-resistant foam to extinguish.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":2,"pe":2,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:precautionary_statements:bd7cf0d8"},{"group":"Storage","code":"P403","statement":"Store in a well-ventilated place.","text":"P403 Store in a well-ventilated place.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":2,"pe":2,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:precautionary_statements:78dbaeaf"},{"group":"Disposal","code":"P501","statement":"Dispose of contents/ container to an approved waste disposal plant.","text":"P501 Dispose of contents/ container to an approved waste disposal plant.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":2,"pe":2,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:precautionary_statements:bc03aec3"}],"storage":[{"label":"Conditions for safe storage","text":"Store in original container. Keep in a well-ventilated place. Observe label precautions. Store in accordance with local regulations.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":4,"pe":4,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:storage:9ad40fe0"}],"handling":[{"label":"Advice on protection against fire and explosion","text":"Normal measures for preventive fire protection.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":3,"pe":3,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:handling:3151dad9"},{"label":"Advice on safe handling","text":"Avoid exceeding the given occupational exposure limits (see section 8). For personal protection see section 8. Smoking, eating and drinking should be prohibited in the application area. Follow standard hygiene measures when handling chemical products","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":3,"pe":3,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:handling:1414324e"},{"label":"Hygiene measures","text":"Handle in accordance with good industrial hygiene and safety practice. When using do not eat or drink. When using do not smoke. Wash hands before breaks and at the end of workday.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":3,"pe":4,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:handling:ef026cd3"}],"signal_word":{"value":"Warning","text":"Signal word : Warning","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":1,"pe":1,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:signal_word:81c5033b"},"ppe":{"respiratory":{"label":"Respiratory protection","text":"In case of inadequate ventilation wear respiratory protection. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":4,"pe":4,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:ppe.respiratory:1228c275"},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber/nitrile rubber gloves. Contaminated gloves should be removed.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":4,"pe":4,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:ppe.hands:27ef0e7d"},"eyes":{"label":"Eye protection","text":"Safety glasses","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":4,"pe":4,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:ppe.eyes:03ca7e7f"},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3 Protective clothing needs to be made of cotton.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":4,"pe":4,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:ppe.skin_body:086497a7"},"engineering_controls":{"label":"Appropriate engineering controls","text":"Use adequate ventilation and/or engineering controls to prevent exposure to vapours.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":4,"pe":4,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:ppe.engineering_controls:b525b6f3"}},"transport_adg":{"un_number":"Not applicable","class":"Not applicable","text":"UN number : Not applicable","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/p/MSDS%20SikaSeal%20Appliance%20Sealant%20GHS7.pdf","v":"Revision 05.02.2025, Version 5.0","p":8,"pe":8,"sec":""},"id":"sikaseal-appliancesealant:sds:348511:transport_adg:24d6694d"}}]},"sp":{"ds":{"url":"https://aus.sika.com/content/dam/dms/au01/1/sikaseal_appliancesealant.pdf","title":"SikaSeal® Appliance Sealant","edition":"April 2023, Version 01.02","version":"01.02","issued":"April 2023"},"std":[]}}