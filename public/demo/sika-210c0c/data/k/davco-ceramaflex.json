vco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":1}},{"hazard_class":"Serious eye damage/eye irritation","category":"Category 1","text":"Serious eye damage/eye irritation : Category 1","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":1}},{"hazard_class":"Skin sensitisation","category":"Category 1","text":"Skin sensitisation : Category 1","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":1}},{"hazard_class":"Specific target organ toxicity - repeated exposure","category":"Category 2","text":"Specific target organ toxicity - repeated exposure : Category 2","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":1}}],"hazard_statements":[{"code":"H315","statement":"Causes skin irritation.","text":"H315 Causes skin irritation.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":1}},{"code":"H317","statement":"May cause an allergic skin reaction.","text":"H317 May cause an allergic skin reaction.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":1}},{"code":"H318","statement":"Causes serious eye damage.","text":"H318 Causes serious eye damage.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":1}},{"code":"H373","statement":"May cause damage to organs through prolonged or repeated exposure.","text":"H373 May cause damage to organs through prolonged or repeated exposure.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":1}}],"precautionary_statements":[{"group":"Prevention","code":"P260","statement":"Do not breathe dust.","text":"P260 Do not breathe dust.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":1}},{"group":"Prevention","code":"P264","statement":"Wash skin thoroughly after handling.","text":"P264 Wash skin thoroughly after handling.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":1}},{"group":"Prevention","code":"P272","statement":"Contaminated work clothing should not be allowed out of the workplace.","text":"P272 Contaminated work clothing should not be allowed out of the workplace.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":1}},{"group":"Prevention","code":"P280","statement":"Wear protective gloves/ eye protection/ face protection.","text":"P280 Wear protective gloves/ eye protection/ face protection.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":2}},{"group":"Response","code":"P302 + P352","statement":"IF ON SKIN: Wash with plenty of water.","text":"P302 + P352 IF ON SKIN: Wash with plenty of water.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":2}},{"group":"Response","code":"P305 + P351 + P338 + P310","statement":"IF IN EYES: Rinse cautiously with water for several minutes. Remove contact lenses, if present and easy to do. Continue rinsing. Immediately call a POISON CENTER/ doctor.","text":"P305 + P351 + P338 + P310 IF IN EYES: Rinse cautiously with water for several minutes. Remove contact lenses, if present and easy to do. Continue rinsing. Immediately call a POISON CENTER/ doctor.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":2}},{"group":"Response","code":"P314","statement":"Get medical advice/ attention if you feel unwell.","text":"P314 Get medical advice/ attention if you feel unwell.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":2}},{"group":"Response","code":"P333 + P313","statement":"If skin irritation or rash occurs: Get medical advice/ attention.","text":"P333 + P313 If skin irritation or rash occurs: Get medical advice/ attention.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":2}},{"group":"Response","code":"P362 + P364","statement":"Take off contaminated clothing and wash it before reuse.","text":"P362 + P364 Take off contaminated clothing and wash it before reuse.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":2}},{"group":"Disposal","code":"P501","statement":"Dispose of contents/ container to an approved waste disposal plant.","text":"P501 Dispose of contents/ container to an approved waste disposal plant.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":2}}],"storage":[{"label":"Conditions for safe storage","text":"Keep container tightly closed in a dry and well-ventilated place. Store in accordance with local regulations.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":4}},{"label":"Further information on storage stability","text":"Keep in a dry place. No decomposition if stored and applied as directed.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":4}}],"handling":[{"label":"Advice on protection against fire and explosion","text":"Avoid dust formation. Provide appropriate exhaust ventilation at places where dust is formed.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":4}},{"label":"Advice on safe handling","text":"Avoid formation of respirable particles. Avoid exceeding the given occupational exposure limits (see section 8). Do not get in eyes, on skin, or on clothing. For personal protection see section 8. Persons with a history of skin sensitisation problems or asthma, allergies, chronic or recurrent respiratory disease should not be employed in any process in which this mixture is being used. Smoking, eating and drinking should be prohibited in the application area. Follow standard hygiene measures when handling chemical products","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":4}},{"label":"Hygiene measures","text":"Handle in accordance with good industrial hygiene and safety practice. When using do not eat or drink. When using do not smoke. Wash hands before breaks and at the end of workday.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":4}}],"signal_word":{"value":"Danger","text":"Signal word : Danger","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":1}},"ppe":{"respiratory":{"label":"Respiratory protection","text":"In case of inadequate ventilation wear respiratory protection. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator. particulate filter P","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":5}},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber, PVC, cotton gloves","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":5}},"eyes":{"label":"Eye protection","text":"Safety glasses","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":5}},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":5}},"engineering_controls":{"label":"Appropriate engineering controls","text":"Avoid dust formation. Provide appropriate exhaust ventilation at places where dust is formed.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":4}}},"transport_adg":{"un_number":"Not applicable","class":"Not applicable","text":"UN number : Not applicable","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sds-davco-ceramaflex.pdf","v":"Revision 19.11.2025, Version 5.0","p":8}}}]},"spec":{"ds":{"url":"https://aus.sika.com/content/dam/dms/au01/5/davco-ceramaflex.pdf","title":"Davco® Ceramaflex","edition":"May 2025, Version 01.01","version":"01.01","issued":"May 2025"},"std":[{"citation":"SCAQMD method 304-91","section":"ENVIRONMENTAL INFORMATION","page":1,"context":"Low VOC - 5g/L (SCAQMD method 304-91)"},{"citation":"AS ISO 13007.1","section":"PRODUCT INFORMATION","page":1,"context":"(AS ISO 13007.1)"},{"citation":"AS3958.1","section":"APPLICATION INSTRUCTIONS","page":3,"context":"Application shall be in accordance with AS3958.1"}]}}