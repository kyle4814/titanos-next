{"v":1,"id":"sarnafil-g-410-20l","rates":{"status":"not published","ds":{"url":"https://aus.sika.com/content/dam/dms/au01/7/sarnafil_g_410-20l.pdf","doc_version":"April 2023, Version 01.02","pages":5,"sha256":"d17a994d3e3647c104423a3eedf65b9772e3daecb9d5e6eabe67fd0ffa7f4487","listed_version_date":"31/03/2023"},"facts":{"consumption":[],"coats":[],"layer_thickness":[],"mix_ratio":[]}},"times":{"open_time":[],"cure_times":[],"pot_life":[],"recoat_times":[]},"compat":[{"id":"sarnafil-g-410-20l:suitability:8bdda4fa","type":"suitability","pol":"yes","cond":false,"tags":{"substrate":["waterproofing_membrane"]},"text":"It contains ultraviolet light stabilisers according to EN 13956 / GB 12952. Sarnafil® G 410-20 L is a hot-air weldable roof membrane, formulated for direct exposure and designed for use in all global climatic conditions.","heading":"DESCRIPTION","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/7/sarnafil_g_410-20l.pdf","v":"April 2023, Version 01.02","p":1}},{"id":"sarnafil-g-410-20l:restriction:d6d77369","type":"restriction","pol":"no","cond":false,"tags":{},"text":"Do not apply to wet, damp or unclean surfaces","heading":"IMPORTANT CONSIDERATIONS","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/7/sarnafil_g_410-20l.pdf","v":"April 2023, Version 01.02","p":4}},{"id":"sarnafil-g-410-20l:compatibility:2bb30319","type":"compatibility","pol":"yes","cond":false,"tags":{"substrate":["metal"]},"text":"Sarnafil® Metal Sheet","heading":"System information > System structure","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/7/sarnafil_g_410-20l.pdf","v":"April 2023, Version 01.02","p":2}},{"id":"sarnafil-g-410-20l:compatibility:407c0d55","type":"compatibility","pol":"yes","cond":false,"tags":{},"text":"Sarnacol® 2170 (contact adhesive)","heading":"System information > System structure","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/7/sarnafil_g_410-20l.pdf","v":"April 2023, Version 01.02","p":2}},{"id":"sarnafil-g-410-20l:compatibility:d22dc959","type":"compatibility","pol":"yes","cond":false,"tags":{},"text":"Sarna Cleaner","heading":"System information > System structure","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/7/sarnafil_g_410-20l.pdf","v":"April 2023, Version 01.02","p":2}},{"id":"sarnafil-g-410-20l:compatibility:1c217646","type":"compatibility","pol":"no","cond":false,"tags":{"substrate":["asphalt"]},"text":"Not compatible in direct contact with bitumen, tar, fat, oil, solvent containing materials and other plastic materials, e.g. expanded polystyrene (EPS), extruded polystyrene (XPS), polyurethane (PUR), polyisocyanurate (PIR) or phenolic foam (PF). These materials could adversely affect the product properties.","heading":"System information > Compatibility","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/7/sarnafil_g_410-20l.pdf","v":"April 2023, Version 01.02","p":2}}],"safety":{"status":"not published","sds":[]}}