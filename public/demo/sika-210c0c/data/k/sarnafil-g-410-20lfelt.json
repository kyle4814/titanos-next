{"v":1,"id":"sarnafil-g-410-20lfelt","rates":{"status":"not published","ds":{"url":"https://aus.sika.com/content/dam/dms/au01/6/sarnafil-g-410-20lfelt.pdf","doc_version":"April 2023, Version 01.02","pages":5,"sha256":"ca19a64d9bd02bde5b854a0b32357b249d5f88bb9facd49d371a615571ba99ad","listed_version_date":"31/03/2023"},"facts":{"consumption":[],"coats":[],"layer_thickness":[],"mix_ratio":[]}},"times":{"open_time":[],"adjustability_time":[],"cure_times":[],"pot_life":[],"recoat_times":[]},"compat":[{"id":"sarnafil-g-410-20lfelt:product_relation:1dc072a7","type":"product_relation","pol":"yes","cond":false,"tags":{"substrate":["waterproofing_membrane"]},"text":"It contains ultraviolet light stabilisers according to EN 13956 / GB 12952. Sarnafil® G 410-20 L Felt is a hot-air weldable roof membrane, formulated for direct exposure and designed for use in all global climatic conditions.","heading":"DESCRIPTION","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/6/sarnafil-g-410-20lfelt.pdf","v":"April 2023, Version 01.02","p":1}},{"id":"sarnafil-g-410-20lfelt:product_relation:2f76451f","type":"product_relation","pol":"yes","cond":false,"tags":{"substrate":["waterproofing_membrane"]},"text":"The use of Sarnafil® G 410-20 L Felt membrane is limited to geographical locations with average monthly minimum temperatures of - 50 °C. Permanent ambient temperature during use is limited to + 50°C.","heading":"IMPORTANT CONSIDERATIONS","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/6/sarnafil-g-410-20lfelt.pdf","v":"April 2023, Version 01.02","p":4}},{"id":"sarnafil-g-410-20lfelt:compatibility:1092bb54","type":"compatibility","pol":"yes","cond":false,"tags":{"substrate":["metal"]},"text":"Sarnafil® Metal Sheet PVC","heading":"System information > System structure","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/6/sarnafil-g-410-20lfelt.pdf","v":"April 2023, Version 01.02","p":2}},{"id":"sarnafil-g-410-20lfelt:compatibility:c3a389a4","type":"compa