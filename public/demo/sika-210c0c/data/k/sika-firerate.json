"label":"Advice on safe handling","text":"For personal protection see section 8. No special handling advice required. Follow standard hygiene measures when handling chemical products","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/e/sds-sika-firerate.pdf","v":"Revision 24.02.2026, Version 1.0","p":2},"id":"sika-firerate:sds:c5e290:handling:a6f4ac4e"},{"label":"Hygiene measures","text":"When using do not eat or drink. When using do not smoke.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/e/sds-sika-firerate.pdf","v":"Revision 24.02.2026, Version 1.0","p":2,"pe":3},"id":"sika-firerate:sds:c5e290:handling:57e17a76"}],"signal_word":null,"ppe":{"respiratory":{"label":"Respiratory protection","text":"In case of inadequate ventilation wear respiratory protection. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/e/sds-sika-firerate.pdf","v":"Revision 24.02.2026, Version 1.0","p":3},"id":"sika-firerate:sds:c5e290:ppe.respiratory:1228c275"},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber/nitrile rubber gloves. Contaminated gloves should be removed.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/e/sds-sika-firerate.pdf","v":"Revision 24.02.2026, Version 1.0","p":3},"id":"sika-firerate:sds:c5e290:ppe.hands:27ef0e7d"},"eyes":{"label":"Eye protection","text":"Safety glasses","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/e/sds-sika-firerate.pdf","v":"Revision 24.02.2026, Version 1.0","p":3},"id":"sika-firerate:sds:c5e290:ppe.eyes:03ca7e7f"},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/e/sds-sika-firerate.pdf","v":"Revision 24.02.2026, Version 1.0","p":3},"id":"sika-firerate:sds:c5e290:ppe.skin_body:8701f223"},"engineering_controls":{"label":"Appropriate engineering controls","text":"Use adequate ventilation and/or engineering controls to prevent exposure to vapours.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/e/sds-sika-firerate.pdf","v":"Revision 24.02.2026, Version 1.0","p":3},"id":"sika-firerate:sds:c5e290:ppe.engineering_controls:b525b6f3"}},"transport_adg":{"un_number":"Not applicable","class":"Not applicable","text":"UN number : Not applicable","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/e/sds-sika-firerate.pdf","v":"Revision 24.02.2026, Version 1.0","p":6},"id":"sika-firerate:sds:c5e290:transport_adg:24d6694d"}}]},"spec":{"ds":{"url":"https://aus.sika.com/content/dam/dms/au01/3/sika_firerate.pdf","title":"Sika® Firerate","edition":"July 2025, Version 01.04","version":"01.04","issued":"July 2025"},"std":[{"citation":"AS 1530.4","section":"FEATURES","page":1,"context":"Up to 4 hours fire resistance according to AS 1530.4"},{"citation":"AS 1530.4","section":"CERTIFICATES AND TEST REPORTS","page":1,"context":"AS 1530.4 FRL"},{"citation":"ISO 717.1","section":"CERTIFICATES AND TEST REPORTS","page":1,"context":"ISO 717.1 Rw (Ctr) = 64 (-13)"},{"citation":"EN ISO 868","section":"TECHNICAL INFORMATION","page":1,"context":"(EN ISO 868)"},{"citation":"CQP 049-2","section":"APPLICATION INFORMATION","page":2,"context":"(CQP 049-2)"},{"citation":"CQP 019-1","section":"APPLICATION INFORMATION","page":2,"context":"(CQP 019-1)"},{"citation":"AS 1530.4:2014","section":"FURTHER DOCUMENTATION","page":2,"context":"AS 1530.4:2014 test report"},{"citation":"AS/ISO 717.4:2004","section":"FURTHER DOCUMENTATION","page":2,"context":"AS/ISO 717.4:2004 test report"}]}}