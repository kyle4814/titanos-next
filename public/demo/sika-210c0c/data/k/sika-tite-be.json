{"v":1,"id":"sika-tite-be","rates":{"status":"published","ds":{"url":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","doc_version":"April 2023, Version 01.07","pages":3,"sha256":"08d26590d958de98e5ebc404974b40e931e1e50ba7547bc267d906855a0eda42","listed_version_date":"31/03/2023"},"facts":{"consumption":[{"id":"sika-tite-be:consumption:1e47983d","label":"Consumption","text":"1.0mm DFT- (Dry Film thickness): 7.5m2 per 15L pail","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","v":"April 2023, Version 01.07","p":2,"sec":"Consumption"},"parsed":{"model":"pack_covers_area","amount":15.0,"unit":"L","area_min":7.5,"area_max":7.5,"basis_stated":true},"calc":true},{"id":"sika-tite-be:consumption:4bd57126","label":"Consumption","text":"2m2 per 4L pail","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","v":"April 2023, Version 01.07","p":2,"sec":"Consumption"},"parsed":{"model":"pack_covers_area","amount":4.0,"unit":"L","area_min":2.0,"area_max":2.0,"basis_stated":true},"calc":true}],"coats":[],"layer_thickness":[{"id":"sika-tite-be:layer_thickness:2f78ed8b","label":"Dry film thickness","text":"Minimum 1mm DFT (Dry film thickness) required 2x coats of 1 Litre per m2 are required to achieve a 1mm DFT","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","v":"April 2023, Version 01.07","p":2,"sec":"PDS Product Information"},"parsed":{"values":[{"qualifier":"minimum","min":1.0,"max":1.0,"unit":"mm"},{"qualifier":null,"min":1.0,"max":1.0,"unit":"mm"}]}}],"mix_ratio":[]}},"times":{"open_time":[],"cure_times":[{"id":"sika-tite-be:cure_times:90839923","label":"Curing time","text":"Sika® Tite BE must be cured for at least 48 hours at 23°C (longer at lower temperatures.)","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","v":"April 2023, Version 01.07","p":2,"sec":"Application Information"},"parsed":{"model":"duration","min":48.0,"max":48.0,"unit":"h","qualifier":"at least","at_c":23.0}},{"id":"sika-tite-be:cure_times:b18f56e1","label":"Curing time","text":"Sika® Tite BE must be cured for a minimum 3 days before coming in contact with water or any form of backfill.","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","v":"April 2023, Version 01.07","p":2,"sec":"Application Information"},"parsed":{"model":"duration","min":3.0,"max":3.0,"unit":"d","qualifier":"minimum","at_c":null}},{"id":"sika-tite-be:cure_times:ef667988","label":"Drying time","text":"Allow minimum 2 - 4 hours between coats at 23°C. Allow longer in adverse weather conditions","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","v":"April 2023, Version 01.07","p":2,"sec":"Application Information"},"parsed":{"model":"duration","min":2.0,"max":4.0,"unit":"h","qualifier":"minimum","at_c":23.0}}],"pot_life":[],"recoat_times":[]},"compat":[{"id":"sika-tite-be:restriction:ada876b0","type":"restriction","pol":"no","cond":false,"tags":{},"text":"Sika® Tite BE is not designed to stop a hydrostatic head of water pressure.","heading":"LIMITATIONS","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","v":"April 2023, Version 01.07","p":2}},{"id":"sika-tite-be:restriction:fc3af2dd","type":"restriction","pol":"no","cond":false,"tags":{},"text":"Sika® Tite BE must not be used over damp, wet or contaminated substrates.","heading":"LIMITATIONS","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","v":"April 2023, Version 01.07","p":2}},{"id":"sika-tite-be:restriction:b5425cd5","type":"restriction","pol":"no","cond":true,"tags":{},"text":"Sika® Tite BE must not be applied if it is raining or if rain is imminent.","heading":"LIMITATIONS","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","v":"April 2023, Version 01.07","p":2}},{"id":"sika-tite-be:restriction:e6bab689","type":"restriction","pol":"no","cond":false,"tags":{},"text":"Sika® Tite BE must not be applied directly over protective coatings.","heading":"LIMITATIONS","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","v":"April 2023, Version 01.07","p":2}},{"id":"sika-tite-be:restriction:3cc59908","type":"restriction","pol":"no","cond":false,"tags":{},"text":"Sika® Tite BE must not be used as a trafficable, exposed or UV stable coating.","heading":"LIMITATIONS","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","v":"April 2023, Version 01.07","p":2}},{"id":"sika-tite-be:restriction:adce7464","type":"restriction","pol":"no","cond":false,"tags":{},"text":"Sika® Tite BE is not compatible with polyurethane or silicone sealants.","heading":"LIMITATIONS","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","v":"April 2023, Version 01.07","p":2}},{"id":"sika-tite-be:suitability:1f92f78d","type":"suitability","pol":"yes","cond":true,"tags":{"environment":["wall"]},"text":"In backfilling applications (planter boxes/retaining walls etc) allow a minimum of 3 days cure and use suitable protection layer prior to backfilling.","heading":"LIMITATIONS","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","v":"April 2023, Version 01.07","p":2}},{"id":"sika-tite-be:restriction:1e189cdc","type":"restriction","pol":"no","cond":true,"tags":{},"text":"Do not apply where the substrate temperature is below 10°C or greater than 35°C.","heading":"LIMITATIONS","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","v":"April 2023, Version 01.07","p":2}},{"id":"sika-tite-be:compatibility:40fd4e30","type":"compatibility","pol":"yes","cond":false,"tags":{"substrate":["cement_screed"]},"text":"Sand/cement screeds","heading":"Application Information > Substrates","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","v":"April 2023, Version 01.07","p":2}},{"id":"sika-tite-be:compatibility:fb202502","type":"compatibility","pol":"yes","cond":false,"tags":{"substrate":["fibre_cement"]},"text":"Fibrous cement sheeting","heading":"Application Information > Substrates","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","v":"April 2023, Version 01.07","p":2}},{"id":"sika-tite-be:compatibility:ab14bfdd","type":"compatibility","pol":"yes","cond":false,"tags":{"substrate":["fibre_cement"]},"text":"Compressed fibrous cement sheeting","heading":"Application Information > Substrates","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","v":"April 2023, Version 01.07","p":2}},{"id":"sika-tite-be:compatibility:dbc0c09a","type":"compatibility","pol":"yes","cond":false,"tags":{"substrate":["metal"]},"text":"Steel/Aluminium","heading":"Application Information > Substrates","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","v":"April 2023, Version 01.07","p":2}},{"id":"sika-tite-be:compatibility:09c5871f","type":"compatibility","pol":"yes","cond":false,"tags":{"substrate":["timber"]},"text":"Timber posts","heading":"Application Information > Substrates","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/7/sika_tite_be.pdf","v":"April 2023, Version 01.07","p":2}}],"safety":{"status":"published","sds":[{"title":"SDS Sika® Tite BE","url":"https://aus.sika.com/content/dam/dms/au01/u/sds-sikatite-be.pdf","revision_date":"07.10.2026","version":"3.1","sds_number":"100000032549","pages":9,"product_name_on_sds":"Sika® Tite BE","latest_for_name":true,"name_matches_product":true,"classification":[{"hazard_class":"Short-term (acute) aquatic hazard","category":"Category 3","text":"Short-term (acute) aquatic hazard : Category 3","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/sds-sikatite-be.pdf","v":"Revision 07.10.2026, Version 3.1","p":1}},{"hazard_class":"Long-term (chronic) aquatic hazard","category":"Category 3","text":"Long-term (chronic) aquatic hazard : Category 3","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/sds-sikatite-be.pdf","v":"Revision 07.10.2026, Version 3.1","p":1}}],"hazard_statements":[{"code":"H412","statement":"Harmful to aquatic life with long lasting effects.","text":"H412 Harmful to aquatic life with long lasting effects.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/sds-sikatite-be.pdf","v":"Revision 07.10.2026, Version 3.1","p":1}}],"precautionary_statements":[{"group":"Prevention","code":"P273","statement":"Avoid release to the environment.","text":"P273 Avoid release to the environment.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/sds-sikatite-be.pdf","v":"Revision 07.10.2026, Version 3.1","p":1}},{"group":"Disposal","code":"P501","statement":"Dispose of contents/ container to an approved waste disposal plant.","text":"P501 Dispose of contents/ container to an approved waste disposal plant.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/sds-sikatite-be.pdf","v":"Revision 07.10.2026, Version 3.1","p":1}}],"storage":[{"label":"Conditions for safe storage","text":"Keep container tightly closed in a dry and well-ventilated place. Store in accordance with local regulations.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/sds-sikatite-be.pdf","v":"Revision 07.10.2026, Version 3.1","p":3}},{"label":"Materials to avoid","text":"No special restrictions on storage with other products.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/sds-sikatite-be.pdf","v":"Revision 07.10.2026, Version 3.1","p":3}}],"handling":[{"label":"Advice on protection against fire and explosion","text":"Normal measures for preventive fire protection.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/sds-sikatite-be.pdf","v":"Revision 07.10.2026, Version 3.1","p":3}},{"label":"Advice on safe handling","text":"For personal protection see section 8. No special handling advice required. Follow standard hygiene measures when handling chemical products","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/sds-sikatite-be.pdf","v":"Revision 07.10.2026, Version 3.1","p":3}},{"label":"Hygiene measures","text":"When using do not eat or drink. When using do not smoke.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/sds-sikatite-be.pdf","v":"Revision 07.10.2026, Version 3.1","p":3}}],"signal_word":{"value":"None","text":"Signal word : None","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/sds-sikatite-be.pdf","v":"Revision 07.10.2026, Version 3.1","p":1}},"ppe":{"respiratory":{"label":"Respiratory protection","text":"In case of inadequate ventilation wear respiratory protection. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/sds-sikatite-be.pdf","v":"Revision 07.10.2026, Version 3.1","p":3}},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber/nitrile rubber gloves. Contaminated gloves should be removed.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/sds-sikatite-be.pdf","v":"Revision 07.10.2026, Version 3.1","p":3}},"eyes":{"label":"Eye protection","text":"Safety glasses","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/sds-sikatite-be.pdf","v":"Revision 07.10.2026, Version 3.1","p":4}},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/sds-sikatite-be.pdf","v":"Revision 07.10.2026, Version 3.1","p":4}},"engineering_controls":{"label":"Appropriate engineering controls","text":"Use adequate ventilation and/or engineering controls to prevent exposure to vapours.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/sds-sikatite-be.pdf","v":"Revision 07.10.2026, Version 3.1","p":3}}},"transport_adg":{"un_number":"Not applicable","class":"Not applicable","text":"UN number : Not applicable","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/sds-sikatite-be.pdf","v":"Revision 07.10.2026, Version 3.1","p":7}}}]}}