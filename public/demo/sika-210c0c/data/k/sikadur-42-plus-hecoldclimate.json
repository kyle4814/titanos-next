.","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":1},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:hazard_statements:acf7222c"}],"precautionary_statements":[{"group":"Prevention","code":"P261","statement":"Avoid breathing mist or vapours.","text":"P261 Avoid breathing mist or vapours.","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":2},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:precautionary_statements:7895cfea"},{"group":"Prevention","code":"P264","statement":"Wash skin thoroughly after handling.","text":"P264 Wash skin thoroughly after handling.","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":2},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:precautionary_statements:5d1a9355"},{"group":"Prevention","code":"P270","statement":"Do not eat, drink or smoke when using this product.","text":"P270 Do not eat, drink or smoke when using this product.","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":2},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:precautionary_statements:702446ec"},{"group":"Prevention","code":"P272","statement":"Contaminated work clothing should not be allowed out of the workplace.","text":"P272 Contaminated work clothing should not be allowed out of the workplace.","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":2},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:precautionary_statements:2222e81e"},{"group":"Prevention","code":"P273","statement":"Avoid release to the environment.","text":"P273 Avoid release to the environment.","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":2},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:precautionary_statements:967777c8"},{"group":"Prevention","code":"P280","statement":"Wear protective gloves/ protective clothing/ eye protection/ face protection/ hearing protection.","text":"P280 Wear protective gloves/ protective clothing/ eye protection/ face protection/ hearing protection.","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":2},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:precautionary_statements:15fc2146"},{"group":"Response","code":"P301 + P312 + P330","statement":"IF SWALLOWED: Call a POISON CENTER/ doctor if you feel unwell. Rinse mouth.","text":"P301 + P312 + P330 IF SWALLOWED: Call a POISON CENTER/ doctor if you feel unwell. Rinse mouth.","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":2},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:precautionary_statements:7a934780"},{"group":"Response","code":"P301 + P330 + P331","statement":"IF SWALLOWED: Rinse mouth. Do NOT induce vomiting.","text":"P301 + P330 + P331 IF SWALLOWED: Rinse mouth. Do NOT induce vomiting.","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":2},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:precautionary_statements:c562ee2e"},{"group":"Response","code":"P303 + P361 + P353","statement":"IF ON SKIN (or hair): Take off immediately all contaminated clothing. Rinse skin with water.","text":"P303 + P361 + P353 IF ON SKIN (or hair): Take off immediately all contaminated clothing. Rinse skin with water.","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":2},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:precautionary_statements:cafd7b96"},{"group":"Response","code":"P304 + P340 + P310","statement":"IF INHALED: Remove person to fresh air and keep comfortable for breathing. Immediately call a POISON CENTER/ doctor.","text":"P304 + P340 + P310 IF INHALED: Remove person to fresh air and keep comfortable for breathing. Immediately call a POISON CENTER/ doctor.","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":2},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:precautionary_statements:35330b32"},{"group":"Response","code":"P305 + P351 + P338 + P310","statement":"IF IN EYES: Rinse cautiously with water for several minutes. Remove contact lenses, if present and easy to do. Continue rinsing. Immediately call a POISON CENTER/ doctor.","text":"P305 + P351 + P338 + P310 IF IN EYES: Rinse cautiously with water for several minutes. Remove contact lenses, if present and easy to do. Continue rinsing. Immediately call a POISON CENTER/ doctor.","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":2},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:precautionary_statements:ecd5dbac"},{"group":"Response","code":"P333 + P313","statement":"If skin irritation or rash occurs: Get medical advice/ attention.","text":"P333 + P313 If skin irritation or rash occurs: Get medical advice/ attention.","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":2},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:precautionary_statements:0c2e03d6"},{"group":"Response","code":"P362 + P364","statement":"Take off contaminated clothing and wash it before reuse.","text":"P362 + P364 Take off contaminated clothing and wash it before reuse.","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":2},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:precautionary_statements:4732b4f8"},{"group":"Response","code":"P391","statement":"Collect spillage.","text":"P391 Collect spillage.","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":2},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:precautionary_statements:ea864d16"},{"group":"Disposal","code":"P501","statement":"Dispose of contents/ container to an approved waste disposal plant.","text":"P501 Dispose of contents/ container to an approved waste disposal plant.","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":2},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:precautionary_statements:bc03aec3"}],"storage":[{"label":"Conditions for safe storage","text":"Store in original container. Keep container tightly closed in a dry and well-ventilated place. Containers which are opened must be carefully resealed and kept upright to prevent leakage. Observe label precautions. Store in accordance with local regulations.","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":5},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:storage:d5446d2a"}],"handling":[{"label":"Advice on protection against fire and explosion","text":"Normal measures for preventive fire protection.","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":4},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:handling:3151dad9"},{"label":"Advice on safe handling","text":"Avoid exceeding the given occupational exposure limits (see section 8). Do not get in eyes, on skin, or on clothing. For personal protection see section 8. Persons with a history of skin sensitisation problems or asthma, allergies, chronic or recurrent respiratory disease should not be employed in any process in which this mixture is being used. Smoking, eating and drinking should be prohibited in the application area. Follow standard hygiene measures when handling chemical products","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":4},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:handling:de03b4b8"},{"label":"Hygiene measures","text":"Handle in accordance with good industrial hygiene and safety practice. When using do not eat or drink. When using do not smoke. Wash hands before breaks and at the end of workday.","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":5},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:handling:ef026cd3"}],"signal_word":{"value":"Danger","text":"Signal word : Danger","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":1},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:signal_word:ecac447f"},"ppe":{"respiratory":{"label":"Respiratory protection","text":"No special measures required. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":5},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:ppe.respiratory:9e406749"},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber/nitrile rubber gloves. Contaminated gloves should be removed.","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":5},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:ppe.hands:27ef0e7d"},"eyes":{"label":"Eye protection","text":"Safety glasses","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":5},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:ppe.eyes:03ca7e7f"},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3 Rubber aprons","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":5},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:ppe.skin_body:c2cdd16e"},"engineering_controls":{"label":"Appropriate engineering controls","text":"Use adequate ventilation and/or engineering controls to prevent exposure to vapours.","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":5},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:ppe.engineering_controls:b525b6f3"}},"transport_adg":{"un_number":"UN 1760","class":"8 Packing","text":"UN number : UN 1760","s":{"t":"SDS","u":"https://aus.sika.com/dms/getdocument.get/2a7372cd-6de7-48f4-81e6-f1e81ca327ac_au01/sds-sikadur-42-partb.pdf","v":"Revision 09.08.2026, Version 1.0","p":11},"id":"sikadur-42-plus-hecoldclimate:sds:5cb19a:transport_adg:5b1bd377"}}]},"spec":{"ds":{"url":"https://aus.sika.com/content/dam/dms/au01/u/sikadur-42-plus-hecoldclimate.pdf","title":"Sikadur®-42+ HE Cold Climate","edition":"May 2026, Version 05.02","version":"05.02","issued":"May 2026"},"std":[{"citation":"EN 1504-3","section":"USES","page":1,"context":"Spalled concrete structures (not EN 1504-3 compliant)"},{"citation":"EN 15804","section":"SUSTAINABILITY","page":1,"context":"Model Environmental Product Declaration (EPD) in accordance with EN 15804."},{"citation":"EN 1504-6:2004","section":"CERTIFICATES AND TEST REPORTS","page":1,"context":"CE marking and declaration of performance based on EN 1504-6:2004 Products and systems for the protection and repair of concrete structures — Anchoring reinforcing steel bar"},{"citation":"ASTM C579","section":"TECHNICAL INFORMATION","page":2,"context":"(ASTM C579)"},{"citation":"EN 196-1","section":"TECHNICAL INFORMATION","page":2,"context":"(EN 196-1)"},{"citation":"ASTM C1339","section":"TECHNICAL INFORMATION","page":2,"context":"(ASTM C1339)"},{"citation":"ISO 178","section":"TECHNICAL INFORMATION","page":2,"context":"30 N/mm² (ISO 178)"},{"citation":"ASTM C580","section":"TECHNICAL INFORMATION","page":2,"context":"27 N/mm² (ASTM C580)"},{"citation":"ASTM C580","section":"TECHNICAL INFORMATION","page":2,"context":"(ASTM C580)"},{"citation":"EN ISO 527-2","section":"TECHNICAL INFORMATION","page":2,"context":"15 N/mm² (EN ISO 527-2)"},{"citation":"ASTM C307","section":"TECHNICAL INFORMATION","page":2,"context":"12 N/mm² (ASTM C307)"},{"citation":"EN 1881","section":"TECHNICAL INFORMATION","page":2,"context":"(EN 1