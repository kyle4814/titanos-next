ond":false,"tags":{"environment":["commercial","domestic","floor","wall"]},"text":"Can be used in residential, commercial and industrial applications Can be applied on floors and walls where required","heading":"USES","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/q/sikafloor-08-primer.pdf","v":"April 2023, Version 01.04","p":1}},{"id":"sikafloor-08-primer:suitability:cd08aaac","type":"suitability","pol":"yes","cond":false,"tags":{"environment":["external","internal"]},"text":"Suitable for internal or external applications","heading":"CHARACTERISTICS / ADVANTAGES","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/q/sikafloor-08-primer.pdf","v":"April 2023, Version 01.04","p":1}},{"id":"sikafloor-08-primer:suitability:3ce4bb68","type":"suitability","pol":"no","cond":false,"tags":{"environment":["submerged"]},"text":"Do not apply Sikafloor®-08 Primer in fully submerged situation - pools/ponds","heading":"IMPORTANT CONSIDERATIONS","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/q/sikafloor-08-primer.pdf","v":"April 2023, Version 01.04","p":2}},{"id":"sikafloor-08-primer:restriction:9135c020","type":"restriction","pol":"no","cond":false,"tags":{},"text":"Do not mix or apply Sikafloor®-08 Primer in temperatures below 5°C and above 35°C. Sikafloor®-08 Primer is not recommended as a trafficable seal coat over cement based materials","heading":"IMPORTANT CONSIDERATIONS","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/q/sikafloor-08-primer.pdf","v":"April 2023, Version 01.04","p":2}},{"id":"sikafloor-08-primer:suitability:e626945c","type":"suitability","pol":"yes","cond":true,"tags":{"environment":["floor"]},"text":"Movement of sub-floors must be minimized by mechanical or chemical procedures prior to the installation of Sikafloor® products. ▪ Please refer also to the product data sheets of subsequent suitable materials for further details.","heading":"SUBSTRATE QUALITY / PRE-TREATMENT","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/q/sikafloor-08-primer.pdf","v":"April 2023, Version 01.04","p":3}},{"id":"sikafloor-08-primer:primer:79c10f14","type":"primer","pol":"yes","cond":false,"tags":{"substrate":["fibre_cement","timber"]},"text":"Avoid foam during application by adding more liquid. ▪ APPLY NEAT Sikafloor®-08 Primer over raw timber/chipboard, cement sheeting or Sikafloor®-4020 FiberLevel with a long napped roller 12mm+. Note: For best practice it is recommended subsequent construction materials are applied as soon as primer is dry,","heading":"APPLICATION","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/q/sikafloor-08-primer.pdf","v":"April 2023, Version 01.04","p":3}},{"id":"sikafloor-08-primer:compatibility:8a72e183","type":"compatibility","pol":"yes","cond":false,"tags":{"substrate":["concrete","fibre_cement","self_levelling_underlayment","timber"],"environment":["external","internal","wall"]},"text":"▪ Internal or external porous concrete ▪ Internal cement levelling compound ▪ Internal Sikafloor®-4020 FiberLevel levelling compound ▪ Internal timber/wood/cement sheeting/wall lining","heading":"Application Information > Substrates","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/q/sikafloor-08-primer.pdf","v":"April 2023, Version 01.04","p":2}}],"safety":{"status":"published","sds":[{"title":"SDS Sikafloor 08 Primer","url":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sikafloor%2008%20Primer.pdf","revision_date":"31.01.2025","version":"3.0","sds_number":"100000036419","pages":9,"product_name_on_sds":"Sikafloor®-08 Primer","latest_for_name":true,"name_matches_product":true,"classification":[{"hazard_class":"Short-term (acute) aquatic hazard","category":"Category 3","text":"Short-term (acute) aquatic hazard : Category 3","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sikafloor%2008%20Primer.pdf","v":"Revision 31.01.2025, Version 3.0","p":1},"id":"sikafloor-08-primer:sds:44cd32:classification:99b25c25"}],"hazard_statements":[{"code":"H402","statement":"Harmful to aquatic life.","text":"H402 Harmful to aquatic life.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sikafloor%2008%20Primer.pdf","v":"Revision 31.01.2025, Version 3.0","p":1},"id":"sikafloor-08-primer:sds:44cd32:hazard_statements:5f4d93b1"}],"precautionary_statements":[{"group":"Prevention","code":"P273","statement":"Avoid release to the environment.","text":"P273 Avoid release to the environment.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sikafloor%2008%20Primer.pdf","v":"Revision 31.01.2025, Version 3.0","p":1},"id":"sikafloor-08-primer:sds:44cd32:precautionary_statements:967777c8"},{"group":"Disposal","code":"P501","statement":"Dispose of contents/ container to an approved waste disposal plant.","text":"P501 Dispose of contents/ container to an approved waste disposal plant.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sikafloor%2008%20Primer.pdf","v":"Revision 31.01.2025, Version 3.0","p":1},"id":"sikafloor-08-primer:sds:44cd32:precautionary_statements:bc03aec3"}],"storage":[{"label":"Conditions for safe storage","text":"Keep container tightly closed in a dry and well-ventilated place. Store in accordance with local regulations.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sikafloor%2008%20Primer.pdf","v":"Revision 31.01.2025, Version 3.0","p":3},"id":"sikafloor-08-primer:sds:44cd32:storage:efaa6aee"},{"label":"Materials to avoid","text":"No special restrictions on storage with other products.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sikafloor%2008%20Primer.pdf","v":"Revision 31.01.2025, Version 3.0","p":3},"id":"sikafloor-08-primer:sds:44cd32:storage:ca8dd6c0"}],"handling":[{"label":"Advice on protection against fire and explosion","text":"Normal measures for preventive fire protection.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sikafloor%2008%20Primer.pdf","v":"Revision 31.01.2025, Version 3.0","p":3},"id":"sikafloor-08-primer:sds:44cd32:handling:3151dad9"},{"label":"Advice on safe handling","text":"For personal protection see section 8. No special handling advice required. Follow standard hygiene measures when handling chemical products","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sikafloor%2008%20Primer.pdf","v":"Revision 31.01.2025, Version 3.0","p":3},"id":"sikafloor-08-primer:sds:44cd32:handling:a6f4ac4e"},{"label":"Hygiene measures","text":"When using do not eat or drink. When using do not smoke.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sikafloor%2008%20Primer.pdf","v":"Revision 31.01.2025, Version 3.0","p":3},"id":"sikafloor-08-primer:sds:44cd32:handling:57e17a76"}],"signal_word":{"value":"None","text":"Signal word : None","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sikafloor%2008%20Primer.pdf","v":"Revision 31.01.2025, Version 3.0","p":1},"id":"sikafloor-08-primer:sds:44cd32:signal_word:1022e277"},"ppe":{"respiratory":{"label":"Respiratory protection","text":"In case of inadequate ventilation wear respiratory protection. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sikafloor%2008%20Primer.pdf","v":"Revision 31.01.2025, Version 3.0","p":3},"id":"sikafloor-08-primer:sds:44cd32:ppe.respiratory:1228c275"},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber/nitrile rubber gloves. Contaminated gloves should be removed.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sikafloor%2008%20Primer.pdf","v":"Revision 31.01.2025, Version 3.0","p":3},"id":"sikafloor-08-primer:sds:44cd32:ppe.hands:27ef0e7d"},"eyes":{"label":"Eye protection","text":"Safety glasses","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sikafloor%2008%20Primer.pdf","v":"Revision 31.01.2025, Version 3.0","p":3},"id":"sikafloor-08-primer:sds:44cd32:ppe.eyes:03ca7e7f"},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sikafloor%2008%20Primer.pdf","v":"Revision 31.01.2025, Version 3.0","p":3,"pe":4},"id":"sikafloor-08-primer:sds:44cd32:ppe.skin_body:8701f223"},"engineering_controls":{"label":"Appropriate engineering controls","text":"Use adequate ventilation and/or engineering controls to prevent exposure to vapours.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sikafloor%2008%20Primer.pdf","v":"Revision 31.01.2025, Version 3.0","p":3},"id":"sikafloor-08-primer:sds:44cd32:ppe.engineering_controls:b525b6f3"}},"transport_adg":{"un_number":"Not applicable","class":"Not applicable","text":"UN number : Not applicable","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/k/MSDS%20Sikafloor%2008%20Primer.pdf","v":"Revision 31.01.2025, Version 3.0","p":7},"id":"sikafloor-08-primer:sds:44cd32:transport_adg:24d6694d"}}]},"spec":{"ds":{"url":"https://aus.sika.com/content/dam/dms/au01/q/sikafloor-08-primer.pdf","title":"Sikafloor®-08 Primer","edition":"April 2023, Version 01.04","version":"01.04","issued":"April 2023"},"std":[]}}