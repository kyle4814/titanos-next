.sika.com/content/dam/dms/au01/0/sds-sikafloor-304wparta.pdf","v":"Revision 21.07.2025, Version 7.0","p":3}},{"label":"Hygiene measures","text":"Handle in accordance with good industrial hygiene and safety practice. When using do not eat or drink. When using do not smoke. Wash hands before breaks and at the end of workday.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/0/sds-sikafloor-304wparta.pdf","v":"Revision 21.07.2025, Version 7.0","p":3}}],"signal_word":{"value":"None","text":"Signal word : None","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/0/sds-sikafloor-304wparta.pdf","v":"Revision 21.07.2025, Version 7.0","p":1}},"ppe":{"respiratory":{"label":"Respiratory protection","text":"No special measures required. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/0/sds-sikafloor-304wparta.pdf","v":"Revision 21.07.2025, Version 7.0","p":3,"pe":4}},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber/nitrile rubber gloves. Contaminated gloves should be removed.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/0/sds-sikafloor-304wparta.pdf","v":"Revision 21.07.2025, Version 7.0","p":4}},"eyes":{"label":"Eye protection","text":"Safety glasses","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/0/sds-sikafloor-304wparta.pdf","v":"Revision 21.07.2025, Version 7.0","p":4}},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/0/sds-sikafloor-304wparta.pdf","v":"Revision 21.07.2025, Version 7.0","p":4}},"engineering_controls":{"label":"Appropriate engineering controls","text":"Use adequate ventilation and/or engineering controls to prevent exposure to vapours.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/0/sds-sikafloor-304wparta.pdf","v":"Revision 21.07.2025, Version 7.0","p":3}}},"transport_adg":{"un_number":"Not applicable","class":"Not applicable","text":"UN number : Not applicable","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/0/sds-sikafloor-304wparta.pdf","v":"Revision 21.07.2025, Version 7.0","p":8}}}]}}