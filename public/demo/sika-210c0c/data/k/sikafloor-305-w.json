01/j/sikafloor_-305_w.pdf","v":"April 2023, Version 03.02","p":3}}],"safety":{"status":"published","sds":[{"title":"SDS Sikafloor®-305 W Part A","url":"https://aus.sika.com/content/dam/dms/au01/b/sds-sikafloor-305wparta.pdf","revision_date":"27.06.2025","version":"5.0","sds_number":"000000604278","pages":9,"product_name_on_sds":"Sikafloor®-305 W Part A","latest_for_name":true,"name_matches_product":true,"classification":[{"hazard_class":"Short-term (acute) aquatic hazard","category":"Category 3","text":"Short-term (acute) aquatic hazard : Category 3","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/b/sds-sikafloor-305wparta.pdf","v":"Revision 27.06.2025, Version 5.0","p":1}}],"hazard_statements":[{"code":"H402","statement":"Harmful to aquatic life.","text":"H402 Harmful to aquatic life.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/b/sds-sikafloor-305wparta.pdf","v":"Revision 27.06.2025, Version 5.0","p":1}}],"precautionary_statements":[{"group":"Prevention","code":"P273","statement":"Avoid release to the environment.","text":"P273 Avoid release to the environment.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/b/sds-sikafloor-305wparta.pdf","v":"Revision 27.06.2025, Version 5.0","p":1}},{"group":"Disposal","code":"P501","statement":"Dispose of contents/ container to an approved waste disposal plant.","text":"P501 Dispose of contents/ container to an approved waste disposal plant.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/b/sds-sikafloor-305wparta.pdf","v":"Revision 27.06.2025, Version 5.0","p":1}}],"storage":[{"label":"Conditions for safe storage","text":"Keep container tightly closed in a dry and well-ventilated place. Store in accordance with local regulations.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/b/sds-sikafloor-305wparta.pdf","v":"Revision 27.06.2025, Version 5.0","p":3}},{"label":"Materials to avoid","text":"No special restrictions on storage with other products.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/b/sds-sikafloor-305wparta.pdf","v":"Revision 27.06.2025, Version 5.0","p":3}}],"handling":[{"label":"Advice on protection against fire and explosion","text":"Normal measures for preventive fire protection.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/b/sds-sikafloor-305wparta.pdf","v":"Revision 27.06.2025, Version 5.0","p":3}},{"label":"Advice on safe handling","text":"For personal protection see section 8. No special handling advice required. Follow standard hygiene measures when handling chemical products","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/b/sds-sikafloor-305wparta.pdf","v":"Revision 27.06.2025, Version 5.0","p":3}},{"label":"Hygiene measures","text":"When using do not eat or drink. When using do not smoke.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/b/sds-sikafloor-305wparta.pdf","v":"Revision 27.06.2025, Version 5.0","p":3}}],"signal_word":{"value":"None","text":"Signal word : None","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/b/sds-sikafloor-305wparta.pdf","v":"Revision 27.06.2025, Version 5.0","p":1}},"ppe":{"respiratory":{"label":"Respiratory protection","text":"In case of inadequate ventilation wear respiratory protection. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/b/sds-sikafloor-305wparta.pdf","v":"Revision 27.06.2025, Version 5.0","p":3}},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber/nitrile rubber gloves. Contaminated gloves should be removed.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/b/sds-sikafloor-305wparta.pdf","v":"Revision 27.06.2025, Version 5.0","p":3}},"eyes":{"label":"Eye protection","text":"Safety glasses","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/b/sds-sikafloor-305wparta.pdf","v":"Revision 27.06.2025, Version 5.0","p":4}},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/b/sds-sikafloor-305wparta.pdf","v":"Revision 27.06.2025, Version 5.0","p":4}},"engineering_controls":{"label":"Appropriate engineering controls","text":"Use adequate ventilation and/or engineering controls to prevent exposure to vapours.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/b/sds-sikafloor-305wparta.pdf","v":"Revision 27.06.2025, Version 5.0","p":3}}},"transport_adg":{"un_number":"Not applicable","class":"Not applicable","text":"UN number : Not applicable","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/b/sds-sikafloor-305wparta.pdf","v":"Revision 27.06.2025, Version 5.0","p":7}}}]}}