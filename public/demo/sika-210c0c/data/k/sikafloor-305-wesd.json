05_wesd.pdf","v":"April 2023, Version 09.02","p":1}},{"id":"sikafloor-305-wesd:alternative:c538ee1f","type":"alternative","pol":"no","cond":false,"tags":{},"text":"Do not apply Sikafloor®-305 W ESD un-diluted","heading":"IMPORTANT CONSIDERATIONS","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/1/sikafloor_-305_wesd.pdf","v":"April 2023, Version 09.02","p":3}},{"id":"sikafloor-305-wesd:product_relation:856736af","type":"product_relation","pol":"yes","cond":true,"tags":{"substrate":["epoxy_coating"]},"text":"Apply Sikafloor®-305 W ESD only to tack free Epoxy or PUR resin.","heading":"IMPORTANT CONSIDERATIONS","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/1/sikafloor_-305_wesd.pdf","v":"April 2023, Version 09.02","p":3}},{"id":"sikafloor-305-wesd:restriction:2c4178d0","type":"restriction","pol":"no","cond":true,"tags":{},"text":"If heating is required do not use gas, oil, paraffin or other fossil fuel heaters, these produce large quantities of both CO2 and H2O water vapour, which may adversely affect the finish","heading":"IMPORTANT CONSIDERATIONS","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/1/sikafloor_-305_wesd.pdf","v":"April 2023, Version 09.02","p":4}}],"safety":{"status":"not published","sds":[]},"spec":{"ds":{"url":"https://aus.sika.com/content/dam/dms/au01/1/sikafloor_-305_wesd.pdf","title":"Sikafloor®-305 W ESD","edition":"April 2023, Version 09.02","version":"09.02","issued":"April 2023"},"std":[{"citation":"EN 13813:2002","section":"APPROVALS / CERTIFICATES","page":1,"context":"Synthetic resin screed material according to EN 13813:2002, Declaration of Performance 0208120600300000051008, certified by Factory Production Control Body 0921 and provided with the CE mark."},{"citation":"EN 1504-2:2004","section":"APPROVALS / CERTIFICATES","page":1,"context":"Coating for concrete protection according to EN 1504-2:2004 and the EN 13813:2002, Declaration of Performance 0208120600300000051008, certified by Factory Produc