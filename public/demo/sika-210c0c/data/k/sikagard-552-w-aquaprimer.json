2_w_aquaprimer.pdf","v":"April 2023, Version 03.01","p":2,"sec":"Application Information"},"parsed":{"model":"time_table_row","at_c":8.0,"condition":"+8 °C","columns":[{"column":"time","min":12.0,"max":12.0,"unit":"h","text":"12 hours"}],"header":["Substrate temperature","Time"]},"table_header":"Substrate temperature | Time"},{"id":"sikagard-552-w-aquaprimer:recoat_times:15782a62","label":"Waiting time to overcoating","text":"+20 °C | 5 hours","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/c/sikagard_-552_w_aquaprimer.pdf","v":"April 2023, Version 03.01","p":2,"sec":"Application Information"},"parsed":{"model":"time_table_row","at_c":20.0,"condition":"+20 °C","columns":[{"column":"time","min":5.0,"max":5.0,"unit":"h","text":"5 hours"}],"header":["Substrate temperature","Time"]},"table_header":"Substrate temperature | Time"},{"id":"sikagard-552-w-aquaprimer:recoat_times:1a02f2b9","label":"Waiting time to overcoating","text":"+35 °C | 2.5 hours","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/c/sikagard_-552_w_aquaprimer.pdf","v":"April 2023, Version 03.01","p":2,"sec":"Application Information"},"parsed":{"model":"time_table_row","at_c":35.0,"condition":"+35 °C","columns":[{"column":"time","min":2.5,"max":2.5,"unit":"h","text":"2.5 hours"}],"header":["Substrate temperature","Time"]},"table_header":"Substrate temperature | Time"}]},"compat":[{"id":"sikagard-552-w-aquaprimer:suitability:e950fa31","type":"suitability","pol":"yes","cond":false,"tags":{"substrate":["concrete"]},"text":"Sikagard®-552 W Aquaprimer can also be used as a primer on firmly adhering existing water based coatings or under cement resurfacing mortar to improve the adhesion in case of concrete surface treated with hydrophobic impregnation","heading":"USES","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/c/sikagard_-552_w_aquaprimer.pdf","v":"April 2023, Version 03.01","p":1}},{"id":"sikagard-552-w-aquaprimer:restriction:13d8a6fb","type":"restriction","pol":"