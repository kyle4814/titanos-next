:"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":1},"id":"sikagrout-9610:sds:0845ba:hazard_statements:272833a5"},{"code":"H317","statement":"May cause an allergic skin reaction.","text":"H317 May cause an allergic skin reaction.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":1},"id":"sikagrout-9610:sds:0845ba:hazard_statements:d4c10fb8"},{"code":"H318","statement":"Causes serious eye damage.","text":"H318 Causes serious eye damage.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":1},"id":"sikagrout-9610:sds:0845ba:hazard_statements:da8179dd"},{"code":"H335","statement":"May cause respiratory irritation.","text":"H335 May cause respiratory irritation.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":1},"id":"sikagrout-9610:sds:0845ba:hazard_statements:857d40e7"}],"precautionary_statements":[{"group":"Prevention","code":"P261","statement":"Avoid breathing dust.","text":"P261 Avoid breathing dust.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":1},"id":"sikagrout-9610:sds:0845ba:precautionary_statements:a47c9b69"},{"group":"Prevention","code":"P264","statement":"Wash skin thoroughly after handling.","text":"P264 Wash skin thoroughly after handling.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":1},"id":"sikagrout-9610:sds:0845ba:precautionary_statements:5d1a9355"},{"group":"Prevention","code":"P271","statement":"Use only outdoors or in a well-ventilated area.","text":"P271 Use only outdoors or in a well-ventilated area.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":1},"id":"sikagrout-9610:sds:0845ba:precautionary_statements:057fa8f6"},{"group":"Prevention","code":"P272","statement":"Contaminated work clothing should not be allowed out of the workplace.","text":"P272 Contaminated work clothing should not be allowed out of the workplace.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":1},"id":"sikagrout-9610:sds:0845ba:precautionary_statements:2222e81e"},{"group":"Prevention","code":"P280","statement":"Wear protective gloves/ eye protection/ face protection.","text":"P280 Wear protective gloves/ eye protection/ face protection.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":2},"id":"sikagrout-9610:sds:0845ba:precautionary_statements:8cf8d66f"},{"group":"Response","code":"P302 + P352","statement":"IF ON SKIN: Wash with plenty of water.","text":"P302 + P352 IF ON SKIN: Wash with plenty of water.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":2},"id":"sikagrout-9610:sds:0845ba:precautionary_statements:153d8276"},{"group":"Response","code":"P304 + P340 + P312","statement":"IF INHALED: Remove person to fresh air and keep comfortable for breathing. Call a POISON CENTER/ doctor if you feel unwell.","text":"P304 + P340 + P312 IF INHALED: Remove person to fresh air and keep comfortable for breathing. Call a POISON CENTER/ doctor if you feel unwell.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":2},"id":"sikagrout-9610:sds:0845ba:precautionary_statements:dd2d7689"},{"group":"Response","code":"P305 + P351 + P338 + P310","statement":"IF IN EYES: Rinse cautiously with water for several minutes. Remove contact lenses, if present and easy to do. Continue rinsing. Immediately call a POISON CENTER/ doctor.","text":"P305 + P351 + P338 + P310 IF IN EYES: Rinse cautiously with water for several minutes. Remove contact lenses, if present and easy to do. Continue rinsing. Immediately call a POISON CENTER/ doctor.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":2},"id":"sikagrout-9610:sds:0845ba:precautionary_statements:ecd5dbac"},{"group":"Response","code":"P333 + P313","statement":"If skin irritation or rash occurs: Get medical advice/ attention.","text":"P333 + P313 If skin irritation or rash occurs: Get medical advice/ attention.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":2},"id":"sikagrout-9610:sds:0845ba:precautionary_statements:0c2e03d6"},{"group":"Response","code":"P362 + P364","statement":"Take off contaminated clothing and wash it before reuse.","text":"P362 + P364 Take off contaminated clothing and wash it before reuse.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":2},"id":"sikagrout-9610:sds:0845ba:precautionary_statements:4732b4f8"},{"group":"Storage","code":"P403 + P233","statement":"Store in a well-ventilated place. Keep container tightly closed.","text":"P403 + P233 Store in a well-ventilated place. Keep container tightly closed.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":2},"id":"sikagrout-9610:sds:0845ba:precautionary_statements:6778a0d7"},{"group":"Disposal","code":"P501","statement":"Dispose of contents/ container to an approved waste disposal plant.","text":"P501 Dispose of contents/ container to an approved waste disposal plant.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":2},"id":"sikagrout-9610:sds:0845ba:precautionary_statements:bc03aec3"}],"storage":[{"label":"Conditions for safe storage","text":"Store in original container. Keep in a well-ventilated place. Observe label precautions. Store in accordance with local regulations.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":4},"id":"sikagrout-9610:sds:0845ba:storage:9ad40fe0"},{"label":"Further information on storage stability","text":"Keep in a dry place. No decomposition if stored and applied as directed.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":4},"id":"sikagrout-9610:sds:0845ba:storage:7b21ec47"}],"handling":[{"label":"Advice on protection against fire and explosion","text":"Avoid dust formation. Provide appropriate exhaust ventilation at places where dust is formed.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":4},"id":"sikagrout-9610:sds:0845ba:handling:76437a27"},{"label":"Advice on safe handling","text":"Avoid exceeding the given occupational exposure limits (see section 8). Do not get in eyes, on skin, or on clothing. For personal protection see section 8. Persons with a history of skin sensitisation problems or asthma, allergies, chronic or recurrent respiratory disease should not be employed in any process in which this mixture is being used. Smoking, eating and drinking should be prohibited in the application area. Follow standard hygiene measures when handling chemical products Sika 03 Do not breathe vapours/dust.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":4},"id":"sikagrout-9610:sds:0845ba:handling:d5a3398b"},{"label":"Hygiene measures","text":"Handle in accordance with good industrial hygiene and safety practice. When using do not eat or drink. When using do not smoke. Wash hands before breaks and at the end of workday.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":4},"id":"sikagrout-9610:sds:0845ba:handling:ef026cd3"}],"signal_word":{"value":"Danger","text":"Signal word : Danger","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":1},"id":"sikagrout-9610:sds:0845ba:signal_word:ecac447f"},"ppe":{"respiratory":{"label":"Respiratory protection","text":"In case of inadequate ventilation wear respiratory protection. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator. particulate filter P","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":5},"id":"sikagrout-9610:sds:0845ba:ppe.respiratory:898a461d"},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber, PVC, cotton gloves","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":5},"id":"sikagrout-9610:sds:0845ba:ppe.hands:5c991928"},"eyes":{"label":"Eye protection","text":"Safety glasses","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":5},"id":"sikagrout-9610:sds:0845ba:ppe.eyes:03ca7e7f"},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":5},"id":"sikagrout-9610:sds:0845ba:ppe.skin_body:8701f223"}},"transport_adg":{"un_number":"Not applicable","class":"Not applicable","text":"UN number : Not applicable","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/u/SDS%20SikaGrout%20-%209610%20GHS7.pdf","v":"Revision 06.08.2025, Version 1.0","p":8},"id":"sikagrout-9610:sds:0845ba:transport_adg:24d6694d"}}]},"spec":{"ds":{"url":"https://aus.sika.com/content/dam/dms/au01/7/sikagrout-9610.pdf","title":"SikaGrout®-9610","edition":"October 2025, Version 03.01","version":"03.01","issued":"October 2025"},"std":[{"citation":"EN 12390-7","section":"PRODUCT INFORMATION","page":2,"context":"(EN 12390-7)"},{"citation":"EN 1015-11","section":"TECHNICAL INFORMATION","page":2,"context":"(EN 1015-11)"},{"citation":"EN 12390-3","section":"TECHNICAL INFORMATION","page":2,"context":"(ASTM C109/C109M; EN 12390-3)"},{"citation":"ASTM C109","section":"TECHNICAL INFORMATION","page":2,"context":"(ASTM C109/C109M; EN 12390-3)"},{"citation":"EN 12390-13","section":"TECHNICAL INFORMATION","page":2,"context":"> 30.000 N/mm² (EN 12390-13)"},{"citation":"ASTM C469","section":"TECHNICAL INFORMATION","page":2,"context":"Poisson's ratio: 0.20 (ASTM C469)"},{"citation":"EN 1015-11","section":"TECHNICAL INFORMATION","page":2,"context":"(EN 1015-11)"},{"citation":"ASTM C307","section":"TECHNICAL INFORMATION","page":2,"context":"(ASTM C307)"},{"citation":"ASTM C1090","section":"TECHNICAL INFORMATION","page":2,"context":"(ASTM C1090/C1090M)"},{"citation":"ASTM C940","section":"TECHNICAL INFORMATION","page":2,"context":"(ASTM C940)"},{"citation":"ASTM C1202","section":"TECHNICAL INFORMATION","page":2,"context":"(ASTM C1202)"},{"citation":"ASTM C1437","section":"APPLICATION INFORMATION","page":3,"context":"(ASTM C1437)"},{"citation":"EN 13395-2","section":"APPLICATION INFORMATION","page":3,"context":"(EN 13395-2)"}]}}