on","min":15.0,"max":15.0,"unit":"min","qualifier":"~","at_c":23.0}}],"pot_life":[],"recoat_times":[]},"compat":[{"id":"sikaseal-super:suitability:88b9f59c","type":"suitability","pol":"yes","cond":false,"tags":{"environment":["internal"]},"text":"Suitable for use in kitchens, as well as in most general interior small joint sealing and gap filling applications (with no permanent water immersion)","heading":"USES","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sikaseal_super_200.pdf","v":"April 2023, Version 01.03","p":1}},{"id":"sikaseal-super:restriction:25e594b4","type":"restriction","pol":"no","cond":false,"tags":{},"text":"Limitations For horizontal gaps with little or no movement the maximum thickness should not exceed 15mm.","heading":"IMPORTANT CONSIDERATIONS","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sikaseal_super_200.pdf","v":"April 2023, Version 01.03","p":2}},{"id":"sikaseal-super:restriction:ede32c67","type":"restriction","pol":"no","cond":false,"tags":{},"text":"Maximum vertical joint/gap and depth should not exceed 5mm.","heading":"IMPORTANT CONSIDERATIONS","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sikaseal_super_200.pdf","v":"April 2023, Version 01.03","p":2}},{"id":"sikaseal-super:suitability:4842dee1","type":"suitability","pol":"no","cond":false,"tags":{"substrate":["metal"]},"text":"Do not use on easy corroding substrates such as blank steel, iron etc.","heading":"IMPORTANT CONSIDERATIONS","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sikaseal_super_200.pdf","v":"April 2023, Version 01.03","p":2}},{"id":"sikaseal-super:suitability:97682d25","type":"suitability","pol":"no","cond":false,"tags":{"substrate":["glass"]},"text":"Do not use SikaSeal® Super as glass sealer and in joints with permanent water immersion.","heading":"IMPORTANT CONSIDERATIONS","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sikaseal_super_200.pdf","v":"April 2023, Version 01.03","p":2}},{"id":"sikaseal-super:restriction:4f7564f7","type":"restriction","pol":"no","cond":false,"tags":{},"text":"Do not use on bituminous substrates, natural rubber, chloropene, EPDM or on building materials which might bleed oils, plastisicers or solvent.","heading":"IMPORTANT CONSIDERATIONS","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/w/sikaseal_super_200.pdf","v":"April 2023, Version 01.03","p":2}}],"safety":{"status":"published","sds":[{"title":"Sikaseal Super","url":"https://aus.sika.com/content/dam/dms/au01/r/MSDS%20SikaSeal%20Super%20GHS7.pdf","revision_date":"09.02.2025","version":"2.0","sds_number":"100000009417","pages":8,"product_name_on_sds":"SikaSeal® Super","latest_for_name":true,"name_matches_product":true,"classification":[],"hazard_statements":[],"precautionary_statements":[],"storage":[{"label":"Conditions for safe storage","text":"Keep container tightly closed in a dry and well-ventilated place. Store in accordance with local regulations.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/r/MSDS%20SikaSeal%20Super%20GHS7.pdf","v":"Revision 09.02.2025, Version 2.0","p":2}},{"label":"Materials to avoid","text":"No special restrictions on storage with other products.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/r/MSDS%20SikaSeal%20Super%20GHS7.pdf","v":"Revision 09.02.2025, Version 2.0","p":3}}],"handling":[{"label":"Advice on protection against fire and explosion","text":"Normal measures for preventive fire protection.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/r/MSDS%20SikaSeal%20Super%20GHS7.pdf","v":"Revision 09.02.2025, Version 2.0","p":2}},{"label":"Advice on safe handling","text":"For personal protection see section 8. No special handling advice required. Follow standard hygiene measures when handling chemical products","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/r/MSDS%20SikaSeal%20Super%20GHS7.pdf","v":"Revision 09.02.2025, Version 2.0","p":2}},{"label":"Hygiene measures","text":"When using do not eat or drink. When using do not smoke.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/r/MSDS%20SikaSeal%20Super%20GHS7.pdf","v":"Revision 09.02.2025, Version 2.0","p":2}}],"signal_word":null,"ppe":{"respiratory":{"label":"Respiratory protection","text":"No special measures required. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/r/MSDS%20SikaSeal%20Super%20GHS7.pdf","v":"Revision 09.02.2025, Version 2.0","p":3}},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1 Recommended: Butyl rubber/nitrile rubber gloves. Contaminated gloves should be removed.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/r/MSDS%20SikaSeal%20Super%20GHS7.pdf","v":"Revision 09.02.2025, Version 2.0","p":3}},"eyes":{"label":"Eye protection","text":"Safety glasses","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/r/MSDS%20SikaSeal%20Super%20GHS7.pdf","v":"Revision 09.02.2025, Version 2.0","p":3}},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/r/MSDS%20SikaSeal%20Super%20GHS7.pdf","v":"Revision 09.02.2025, Version 2.0","p":3}},"engineering_controls":{"label":"Appropriate engineering controls","text":"Use adequate ventilation and/or engineering controls to prevent exposure to vapours.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/r/MSDS%20SikaSeal%20Super%20GHS7.pdf","v":"Revision 09.02.2025, Version 2.0","p":3}}},"transport_adg":{"un_number":"Not applicable","cla