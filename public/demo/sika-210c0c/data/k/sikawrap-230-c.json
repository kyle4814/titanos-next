 structure","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/5/sikawrap_-230_c.pdf","v":"April 2023, Version 02.02","p":3}},{"id":"sikawrap-230-c:compatibility:8c2d53b3","type":"compatibility","pol":"yes","cond":false,"tags":{},"text":"For detailed information on Sikadur®-330, together with the resin and fabric application details, please refer to the Sikadur®-330 Product Data Sheet and the relevant Method Statement.","heading":"System information > System structure","s":{"t":"PDS","u":"https://aus.sika.com/content/dam/dms/au01/5/sikawrap_-230_c.pdf","v":"April 2023, Version 02.02","p":3}}],"safety":{"status":"published","sds":[{"title":"SDS SikaWrap®-230C Unidirectional Carbon Fiber Fabric","url":"https://aus.sika.com/content/dam/dms/au01/n/sds-sikawrap-230cunidirectionalcarbonfiberfabric.pdf","revision_date":"21.01.2025","version":"3.1","sds_number":"000000604820","pages":9,"product_name_on_sds":"SikaWrap®-230C Unidirectional Carbon Fiber Fabric","latest_for_name":true,"name_matches_product":true,"classification":[],"hazard_statements":[],"precautionary_statements":[],"storage":[{"label":"Conditions for safe storage","text":"Keep container tightly closed in a dry and well-ventilated place. Store in accordance with local regulations.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/n/sds-sikawrap-230cunidirectionalcarbonfiberfabric.pdf","v":"Revision 21.01.2025, Version 3.1","p":3}},{"label":"Materials to avoid","text":"No special restrictions on storage with other products.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/n/sds-sikawrap-230cunidirectionalcarbonfiberfabric.pdf","v":"Revision 21.01.2025, Version 3.1","p":3}}],"handling":[{"label":"Advice on protection against fire and explosion","text":"Normal measures for preventive fire protection.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/n/sds-sikawrap-230cunidirectionalcarbonfiberfabric.pdf","v":"Revision 21.01.2025, Version 3.1","p":3}},{"label":"Advice on safe handling","text":"For personal protection see section 8. No special handling advice required. Follow standard hygiene measures when handling chemical products","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/n/sds-sikawrap-230cunidirectionalcarbonfiberfabric.pdf","v":"Revision 21.01.2025, Version 3.1","p":3}},{"label":"Hygiene measures","text":"When using do not eat or drink. When using do not smoke.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/n/sds-sikawrap-230cunidirectionalcarbonfiberfabric.pdf","v":"Revision 21.01.2025, Version 3.1","p":3}}],"signal_word":null,"ppe":{"respiratory":{"label":"Respiratory protection","text":"In case of inadequate ventilation wear respiratory protection. Respirator selection must be based on known or anticipated exposure levels, the hazards of the product and the safe working limits of the selected respirator.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/n/sds-sikawrap-230cunidirectionalcarbonfiberfabric.pdf","v":"Revision 21.01.2025, Version 3.1","p":3}},"hands":{"label":"Hand protection","text":"Chemical-resistant, impervious gloves complying with an approved standard should be worn at all times when handling chemical products if a risk assessment indicates this is necessary. Follow AS/NZS 1337.1","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/n/sds-sikawrap-230cunidirectionalcarbonfiberfabric.pdf","v":"Revision 21.01.2025, Version 3.1","p":3}},"eyes":{"label":"Eye protection","text":"Safety glasses","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/n/sds-sikawrap-230cunidirectionalcarbonfiberfabric.pdf","v":"Revision 21.01.2025, Version 3.1","p":3}},"skin_body":{"label":"Skin and body protection","text":"Protective clothing (e.g. safety shoes, long-sleeved working clothing, long trousers) Follow AS 2210:3","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/n/sds-sikawrap-230cunidirectionalcarbonfiberfabric.pdf","v":"Revision 21.01.2025, Version 3.1","p":3,"pe":4}},"engineering_controls":{"label":"Appropriate engineering controls","text":"Provide appropriate exhaust ventilation at places where dust is formed.","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/n/sds-sikawrap-230cunidirectionalcarbonfiberfabric.pdf","v":"Revision 21.01.2025, Version 3.1","p":3}}},"transport_adg":{"un_number":"Not applicable","class":"Not applicable","text":"UN number : Not applicable","s":{"t":"SDS","u":"https://aus.sika.com/content/dam/dms/au01/n/sds-sikawrap-230cunidirectionalcarbonfiberfabric.pdf","v":"Revision 21.01.2025, Version 3.1","p":7}}}]},"spec":{"ds":{"url":"https://aus.sika.com/content/dam/dms/au01/5/sikawrap_-230_c.pdf","title":"SikaWrap®-230 C","edition":"April 2023, Version 02.02","version":"02.02","issued":"April 2023"},"std":[{"citation":"ISO 10618","section":"PRODUCT INFORMATION","page":2,"context":"(ISO 10618)"},{"citation":"ISO 10618","section":"PRODUCT INFORMATION","page":2,"context":"(ISO 10618)"},{"citation":"ISO 10618","section":"PRODUCT INFORMATION","page":2,"context":"(ISO 10618)"},{"citation":"EN 2561","section":"TECHNICAL INFORMATION","page":2,"context":"(EN 2561*)"},{"citation":"ASTM D 3039","section":"TECHNICAL INFORMATION","page":2,"context":"(ASTM D 3039*)"},{"citation":"EN 2561","section":"TECHNICAL INFORMATION","page":2,"context":"(EN 2561*)"},{"citation":"ASTM D 3039","section":"TECHNICAL INFORMATION","page":2,"context":"(ASTM D 3039*)"},{"citation":"EN 2561","section":"TECHNICAL INFORMATION","page":2,"context":"(based on EN 2561)"},{"citation":"ASTM D 3039","section":"TECHNICAL INFORMATION","page":2,"context":"(based on ASTM D 3039)"},{"citation":"EN 2561","section":"TECHNICAL INFORMATION","page":2,"context":"(based on EN 2561)"},{"citation":"EN 2561","section":"TECHNICAL INFORMATION","page":2,"context":"(based on EN 2561)"}]}}